## Traits describe behaviour; structs opt in with `impl Trait for Type`.
trait Equatable:
    ## Equality against another value of the same type.
    fn eq(self, other) -> bool

trait Hashable(Equatable):
    ## A stable integer hash.
    fn hash(self) -> i64

class Point:
    x: i64
    y: i64

    fn eq(self, other) -> bool:
        return self.x == other.x and self.y == other.y

    fn hash(self) -> i64:
        return self.x * 31 + self.y

impl Equatable for Point:
    pass

impl Hashable for Point:
    pass

fn same(a: Point, b: Point) -> bool where Equatable:
    return a.eq(b)

p = Point(1, 2)
q = Point(1, 2)
r = Point(3, 4)

print(p.eq(q))
print(p.eq(r))
print(same(p, q))
print(p.hash())
