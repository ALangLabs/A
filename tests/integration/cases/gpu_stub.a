import "../../../stdlib/std/gpu/gpu.a" as gpu

dev = gpu.cpu_device()
print(dev.name)
print(dev.backend)
a = gpu.Buffer([], 0)
a.transfer_in([1, 2, 3, 4])
b = gpu.Buffer([], 0)
b.transfer_in([10, 20, 30, 40])
out = gpu.Buffer([], 0)
kernel = gpu.add_kernel()
dev.launch(kernel, a, b, out)
print(out.transfer_out())
print(out.size)
print(a.transfer_out())
