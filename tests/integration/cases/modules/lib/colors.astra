enum Color:
    Red
    Green = 5
    Blue

LIMIT = 3

fn name_of(c):
    return match c:
        Color.Red => "red"
        Color.Green => "green"
        Color.Blue => "blue"
        _ => "unknown"

class Swatch:
    color
    label

    fn describe(self):
        return self.label + ":" + name_of(self.color)
