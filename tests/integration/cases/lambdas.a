# Lambdas: first-class function values with snapshot capture.

double = fn(n) => n * 2
print("double:", double(21))

add = fn(a, b) => a + b
print("add:", add(20, 22))

# Immediately-invoked lambda.
print("iife:", (fn() => 99)())

# Capture is a snapshot by value: later mutation is not observed.
counter = 10
bump = fn() => counter + 1
counter = 100
print("captured:", bump(), "current:", counter)

# Structs and arrays captured by reference still share identity.
struct Point:
    x
    y
origin = Point(0, 0)
getX = fn() => origin.x
origin.x = 7
print("shared:", getX())

fn apply(f, value):
    return f(value)

print("apply:", apply(double, 5))
