import "../../../kernels/__init__.a" as kernels

print(kernels.elu([1.0, -1.0], 1.0))
print(kernels.softplus([0.0]))
print(kernels.mish([0.0]))
print(kernels.rms_norm([1.0, 1.0, 1.0, 1.0], 0.0))
print(kernels.reduce_var([1, 2, 3, 4]))
print(kernels.reduce_std([1, 2, 3, 4]))
print(kernels.softmax_row([1.0, 1.0]))
print(kernels.attention([1.0, 0.0], [[1.0, 0.0], [0.0, 1.0]], [[3.0, 5.0], [7.0, 9.0]]))
print(kernels.normalize([0.0, 0.0]))
print(kernels.reshape([1, 2, 3, 4, 5, 6, 7, 8], [2, 2, 2]))
print(kernels.zeros([2, 2, 2]))
print(kernels.fused_add([1.5, 2.5], [0.5, 0.5]))
print(kernels.fused_clamp([0.5, 1.5], 0.0, 1.0))
print(kernels.reduce_sum([1.5, 2.5]))
print(kernels.dot([1.5, 2.0], [2.0, 2.0]))
print(kernels.matmul([[1.0, 2.0], [3.0, 4.0]], [[1.0, 0.0], [0.0, 1.0]]))
print(kernels.reduce_mean([1.5, 3.0]))
print(kernels.quantize_int8([100.0], 0.5))
print(kernels.conv1d([1.0, 2.0, 3.0], [1.0, 1.0], 1))
