from "std/collections/__init__.astra" import namedtuple

fn test_namedtuple_basic():
    Point = namedtuple("Point", ["x", "y"])
    p = Point.make([3, 4])
    assert_eq(p.field("x"), 3)
    assert_eq(p.field("y"), 4)
    assert_eq(p.at(0), 3)
    assert_eq(p.at(-1), 4)
    assert_eq(p.has("x"), true)
    assert_eq(p.has("z"), false)
    assert(p.fields() == ["x", "y"])
    assert_eq(p.typename(), "Point")

fn test_namedtuple_asdict_replace_eq():
    Point = namedtuple("Point", ["x", "y"])
    p = Point.make([3, 4])
    assert(p.asdict() == {"x": 3, "y": 4})
    assert(p.values_list() == [3, 4])
    p2 = p.replace("x", 30)
    assert_eq(p2.field("x"), 30)
    assert_eq(p2.field("y"), 4)
    assert_eq(p.field("x"), 3)  # original unchanged
    assert_eq(p.eq(Point.make([3, 4])), true)
    assert_eq(p.eq(p2), false)
    assert_eq(p.count(4), 1)
    assert_eq(p.index(3), 0)

fn test_namedtuple_make_map():
    Person = namedtuple("Person", ["name", "age"])
    # map literals require homogeneous values in A, so build procedurally
    init = {}
    init["name"] = "Ada"
    init["age"] = 36
    p = Person.make_map(init)
    assert_eq(p.field("name"), "Ada")
    assert_eq(p.field("age"), 36)
    spec_fields = Person.field_names()
    assert(spec_fields == ["name", "age"])
