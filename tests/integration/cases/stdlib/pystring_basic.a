import string

fn main():
    print(string.ascii_lowercase)
    print(string.ascii_uppercase)
    print(string.digits)
    print(string.hexdigits)
    print(string.octdigits)
    print(len(string.punctuation) > 0)
    print(len(string.whitespace) > 0)
    print(string.ascii_letters == string.ascii_lowercase + string.ascii_uppercase)
    print(string.capwords("  hello   world  ", None))
    print(string.capwords("a-b-c", "-"))
    print(string.capwords("ALREADY MIXED case", None))

main()
