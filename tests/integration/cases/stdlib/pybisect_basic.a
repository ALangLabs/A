import bisect

fn test_bisect_left():
    a = [1, 2, 2, 4]
    assert_eq(bisect.bisect_left(a, 2), 1)
    assert_eq(bisect.bisect_left(a, 3), 3)
    assert_eq(bisect.bisect_left(a, 0), 0)
    assert_eq(bisect.bisect_left(a, 9), 4)

fn test_bisect_right():
    a = [1, 2, 2, 4]
    assert_eq(bisect.bisect_right(a, 2), 3)
    assert_eq(bisect.bisect_right(a, 3), 3)
    assert_eq(bisect.bisect_right(a, 0), 0)
    assert_eq(bisect.bisect_right(a, 9), 4)

fn test_bisect_alias():
    a = [1, 3, 5]
    assert_eq(bisect.bisect(a, 4), 2)
    assert_eq(bisect.bisect(a, 5), 3)

fn test_range_bounds():
    a = [10, 20, 30, 40]
    assert_eq(bisect.bisect_left_range(a, 35, 2, 4), 3)
    assert_eq(bisect.bisect_right_range(a, 20, 1, 3), 2)
    assert_eq(bisect.bisect_range(a, 25, 0, 4), 2)

fn test_insort():
    a = [1, 3, 5]
    bisect.insort_left(a, 3)
    assert_eq(str(a), "[1, 3, 3, 5]")
    b = [1, 3, 5]
    bisect.insort_right(b, 3)
    assert_eq(str(b), "[1, 3, 3, 5]")
    c = [1, 3, 5]
    bisect.insort(c, 4)
    assert_eq(str(c), "[1, 3, 4, 5]")

fn test_insort_range():
    a = [1, 2, 3, 4, 5, 6]
    bisect.insort_left_range(a, 9, 0, 3)
    assert_eq(str(a), "[1, 2, 3, 9, 4, 5, 6]")
