# pygraphlib_basic — golden test for std.graphlib
# (port of Python 3.14 Lib/graphlib.py).
import graphlib

# --- TopologicalSorter_from: dict-of-predecessors constructor ---
ts = graphlib.TopologicalSorter_from({
    "a": ["b", "c"],
    "b": ["c"],
    "c": [],
    "d": ["a"],
})
print(ts.static_order())

# --- incremental add/prepare/get_ready/done ---
ts2 = graphlib.TopologicalSorter_new()
ts2.add("x", ["y", "z"])
ts2.add("y", ["z"])
ts2.add_node("z")
ts2.add_node("w")   # standalone node, no predecessors
ts2.prepare()
print(ts2.is_active())
ready = ts2.get_ready()
print(ready)                 # z and w (no predecessors), order may vary
ts2.done(ready)
ready2 = ts2.get_ready()
print(ready2)                # y now unblocked
ts2.done_one("y")
print(ts2.get_ready())       # x
ts2.done(["x"])
print(ts2.is_active())       # false: all nodes finished
print(ts2.get_ready())       # []

# --- diamond graph via add() ---
ts3 = graphlib.TopologicalSorter_new()
ts3.add("top", ["left", "right"])
ts3.add("left", ["bottom"])
ts3.add("right", ["bottom"])
ts3.add_node("bottom")
order = ts3.static_order()
print(len(order))            # 4
# verify it is a valid topo order: bottom before left/right before top
pos = {}
i = 0
for n in order:
    pos[n] = i
    i += 1
print(pos["bottom"] < pos["left"] and pos["bottom"] < pos["right"] and pos["left"] < pos["top"] and pos["right"] < pos["top"])

# --- int nodes ---
ts4 = graphlib.TopologicalSorter_from({1: [2], 2: [], 3: [1, 2]})
print(ts4.static_order())
