from "std/collections/__init__.a" import deque, deque_of, deque_bounded

fn test_basic_ops():
    d = deque_of([1, 2, 3])
    d.append(4)
    d.appendleft(0)
    assert(d.to_list() == [0, 1, 2, 3, 4])
    assert_eq(d.size(), 5)
    assert_eq(d.pop(), 4)
    assert_eq(d.popleft(), 0)
    assert(d.to_list() == [1, 2, 3])
    assert_eq(d.first(), 1)
    assert_eq(d.last(), 3)
    assert_eq(d.at(-1), 3)

fn test_rotate_and_reverse():
    d = deque_of([1, 2, 3, 4])
    d.rotate(1)
    assert(d.to_list() == [4, 1, 2, 3])
    d.rotate(-1)
    assert(d.to_list() == [1, 2, 3, 4])
    d.rotate(2)
    assert(d.to_list() == [3, 4, 1, 2])
    d.reverse()
    assert(d.to_list() == [2, 1, 4, 3])

fn test_count_index_remove():
    d = deque_of([1, 2, 2, 3, 2])
    assert_eq(d.count(2), 3)
    assert_eq(d.index(3), 3)
    assert_eq(d.index_from(2, 2), 2)
    d.remove(2)
    assert(d.to_list() == [1, 2, 3, 2])
    assert_eq(d.contains(3), true)
    assert_eq(d.contains(9), false)

fn test_extend_and_maxlen():
    d = deque()
    d.extend([1, 2])
    d.extendleft([0])
    assert(d.to_list() == [0, 1, 2])
    d.extendleft([9, 8])
    assert(d.to_list() == [8, 9, 0, 1, 2])
    db = deque_bounded([1, 2, 3, 4, 5], 3)
    assert(db.to_list() == [3, 4, 5])
    assert_eq(db.maxlen_value(), 3)
    db.appendleft(0)
    assert(db.to_list() == [0, 3, 4])
    db.append(9)
    assert(db.to_list() == [3, 4, 9])
    cp = db.copy()
    assert(cp.to_list() == db.to_list())
    db.clear()
    assert_eq(db.size(), 0)
