import textwrap

fn main():
    text = "This is a simple sentence that should wrap nicely for testing."
    print(textwrap.wrap(text, 20))
    print(textwrap.fill(text, 20))
    ded = textwrap.dedent("    hello\n    world\n  end")
    print(ded)
    ind = textwrap.indent("a\n\nb", "> ")
    print(ind)
    print(textwrap.shorten("hello world this is long", 12, " [...]"))

main()
