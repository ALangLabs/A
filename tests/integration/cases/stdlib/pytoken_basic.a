import token

fn main():
    # constants
    print(token.ENDMARKER, token.NAME, token.NUMBER, token.STRING)
    print(token.N_TOKENS, token.NT_OFFSET)
    print(token.OP, token.TYPE_IGNORE, token.COMMENT, token.NL)
    print(token.EXACT_TOKEN_TYPES["%="])
    print(token.EXACT_TOKEN_TYPES["->"])
    print(token.EXACT_TOKEN_TYPES["\{"])
    print(token.EXACT_TOKEN_TYPES["~"])

    # tok_name map
    print(len(token.tok_name))
    print(token.tok_name[token.ENDMARKER])
    print(token.tok_name[token.NAME])
    print(token.tok_name[token.N_TOKENS])
    print(token.tok_name[token.NT_OFFSET])

    # predicates (snake_case + CPython UPPERCASE aliases)
    print(token.isterminal(token.NAME), token.isterminal(token.NT_OFFSET))
    print(token.isnonterminal(token.NT_OFFSET), token.isnonterminal(token.NAME))
    print(token.iseof(token.ENDMARKER), token.iseof(token.NAME))
    print(token.ISTERMINAL(token.PLUS), token.ISNONTERMINAL(token.NT_OFFSET), token.ISEOF(token.ENDMARKER))

    # sanity: every exact-token-types entry maps to a terminal
    print(token.isterminal(token.exact_token_types["="]))

main()
