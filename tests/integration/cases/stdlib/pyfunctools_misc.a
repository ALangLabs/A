# functools.reduce / sort_by / singledispatch.
import functools

# reduce: Python argument order reduce(function, iterable[, init]).
print(functools.reduce(fn(acc, x) => acc + x, [1, 2, 3, 4]))
print(functools.reduce(fn(acc, x) => acc * x, [2, 3, 4]))
print(functools.reduce_init(fn(acc, x) => acc + x, [1, 2, 3], 10))
print(functools.reduce_init(fn(acc, x) => acc + x, [], 7))
print(functools.reduce(fn(a, b) => "{a},{b}", ["a", "b", "c"]))

# sort_by: cmp_to_key analogue (three-way comparator, stable, new array).
xs = [3, 1, 2]
ys = functools.sort_by(xs, fn(a, b) => a - b)
print(ys)
print(xs)  # input unchanged
words = ["bb", "a", "ccc", "dd"]
print(functools.sort_by(words, fn(a, b) => len(a) - len(b)))
print(functools.sort_by(words, fn(a, b) => len(b) - len(a)))
print(functools.sort_by([5], fn(a, b) => a - b))
print(functools.sort_by([], fn(a, b) => a - b))

# singledispatch: flat tag registry.
d = functools.singledispatch(fn(x) => "default")
d.register("int", fn(x) => "int:{x}")
d.register("string", fn(x) => "str:{x}")
d.register("float", fn(x) => "float:{x}")
print(d.call([5]))
print(d.call(["hi"]))
print(d.call([1.5]))
print(d.call([true]))
print(d.dispatch("int")(9))
print(d.dispatch("missing")("z"))
