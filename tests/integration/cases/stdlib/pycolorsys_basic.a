import colorsys

fn main():
    # module constants
    print(colorsys.ONE_THIRD, colorsys.ONE_SIXTH, colorsys.TWO_THIRD)

    # YIQ round-trip
    yiq = colorsys.rgb_to_yiq(0.5, 0.2, 0.8)
    print(yiq)
    print(colorsys.yiq_to_rgb(yiq[0], yiq[1], yiq[2]))

    # HLS
    print(colorsys.rgb_to_hls(0.5, 0.2, 0.8))
    print(colorsys.hls_to_rgb(0.75, 0.5, 0.6000000000000001))
    print(colorsys.rgb_to_hls(0.5, 0.5, 0.5))  # achromatic

    # HSV (incl. negative hue -> Python floor-mod path)
    print(colorsys.rgb_to_hsv(0.1, 0.9, 0.3))
    print(colorsys.hsv_to_rgb(0.7, 0.8, 0.6))
    print(colorsys.hsv_to_rgb(-0.5, 0.5, 1.0))
    print(colorsys.hsv_to_rgb(0.0, 0.0, 0.25))  # s == 0 -> gray

    # arbitrary yiq input
    print(colorsys.yiq_to_rgb(0.254, -0.1, 0.2))

    # YCbCr (A-only extension): round-trip
    ycbcr = colorsys.rgb_to_ycbcr(0.5, 0.2, 0.8)
    print(ycbcr)
    print(colorsys.ycbcr_to_rgb(ycbcr[0], ycbcr[1], ycbcr[2]))

main()
