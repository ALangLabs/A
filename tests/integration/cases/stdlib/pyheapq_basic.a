# Golden test: std.heapq (port of Python Lib/heapq.py).
import heapq

# --- basic min-heap push/pop ---
h = []
for x in [5, 1, 9, 3, 7, 2]:
    heapq.heappush(h, x)
print(h[0])            # smallest on top
out = []
while len(h) > 0:
    out.append(heapq.heappop(h))
print(out)             # sorted ascending

# --- heapify ---
h2 = [9, 3, 7, 1, 8, 2, 5]
heapq.heapify(h2)
print(h2[0])
sorted2 = []
while len(h2) > 0:
    sorted2.append(heapq.heappop(h2))
print(sorted2)

# --- heappushpop / heapreplace ---
h3 = [1, 3, 5, 7]
print(heapq.heappushpop(h3, 4))   # returns 1, heap stays a heap
print(heapq.heappushpop(h3, 10))  # returns 3
print(h3[0])
print(heapq.heapreplace(h3, 2))   # pops current min, inserts 2
print(heapq.heapreplace(h3, 20))
print(h3)

mh = []
for x in [5, 1, 9, 3]:
    heapq.heappush_max(mh, x)
print(mh[0])                 # 9
print(heapq.heappop_max(mh)) # 9
print(heapq.heappop_max(mh)) # 5

mh2 = [4, 8, 2, 6]
heapq.heapify_max(mh2)
print(heapq.heappop_max(mh2))          # 8
print(heapq.heappushpop_max(mh2, 10))  # 10 < heap[0]? no -> returns 10
print(heapq.heapreplace_max(mh2, 1))   # pops max (6), inserts 1

# --- nsmallest / nlargest ---
data = [9, 1, 8, 2, 7, 3, 6, 4, 5, 0]
print(heapq.nsmallest(4, data))
print(heapq.nlargest(4, data))
print(heapq.nsmallest(20, data))   # n >= len -> sorted copy
print(heapq.nlargest(0, data))     # []

words = ["ccc", "a", "bb", "dd", "e"]
print(heapq.nsmallest_key(3, words, fn(s: String) => len(s)))
print(heapq.nlargest_key(3, words, fn(s: String) => len(s)))
print(heapq.nsmallest_key(2, words, fn(s: String) => len(s)))

# --- merge (returns a list, not a generator) ---
print(heapq.merge([[1, 3, 5, 7], [0, 2, 4, 8], [5, 10, 15, 20], [], [25]]))
print(heapq.merge([[1, 2], [3, 4]]))
print(heapq.merge_key([["bb", "aaa"], ["c", "dddd"]], fn(s: String) => len(s)))
print(heapq.merge_reverse([[9, 5, 1], [8, 4, 0]]))
print(heapq.merge_key_reverse([["aa", "b"], ["ccc"]], fn(s: String) => len(s)))
