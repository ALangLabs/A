import copy
import json

fn main():
    a = [1, 2, 3, 4]
    b = copy.copy(a)
    print(json.stringify(b))

    m = {"x": 1, "y": 2}
    n = copy.copy(m)
    print(json.stringify(n))

    c = [[1, 2], [3, 4]]
    d = copy.deepcopy(c)
    print(json.stringify(d))

    print(copy.copy(5))
    print(copy.deepcopy("hi"))

main()
