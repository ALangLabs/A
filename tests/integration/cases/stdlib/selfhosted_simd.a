import simd
v = simd.splat(3)
print(v.to_list())
a = simd.vec4_new(1, 2, 3, 4)
b = simd.vec4_new(5, 6, 7, 8)
print(simd.dot(a, b))
print(simd.add(a, b).to_list())
print(simd.length(simd.vec4_new(3, 4, 0, 0)))
print(simd.normalize(simd.vec4_new(3, 4, 0, 0)).to_list())
print(simd.lerp(a, b, 0.5).to_list())
print(simd.sum_vecs([a, b]).to_list())
print(simd.sum_axis([a, b], 0), simd.sum_axis([a, b], 3))
print(simd.unroll([1, 2, 3, 4, 5], fn(x) => x * 10))
print(simd.parallel_reduce([1, 2, 3], fn(acc, x) => acc + x, 0))
