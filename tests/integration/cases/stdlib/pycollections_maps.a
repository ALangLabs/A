from "std/collections/__init__.a" import OrderedDict, ordered_dict_fromkeys, defaultdict, ChainMap, UserDict, user_dict, UserList, user_list, user_list_of

fn test_ordered_dict():
    od = OrderedDict({})
    od.set("first", 1)
    od.set("second", 2)
    od.set("third", 3)
    assert(od.keys() == ["first", "second", "third"])
    od.set("second", 20)  # update keeps position
    assert(od.keys() == ["first", "second", "third"])
    od.move_to_end("first", true)
    assert(od.keys() == ["second", "third", "first"])
    od.move_to_front("third")
    assert(od.keys() == ["third", "second", "first"])
    (k, v) = od.popitem(false)
    assert_eq(k, "third")
    assert_eq(v, 3)
    (k2, v2) = od.popitem(true)
    assert_eq(k2, "first")
    assert_eq(v2, 1)
    assert(od.reversed() == ["second"])
    assert_eq(od.get("second"), 20)
    assert_eq(od.pop_or("zz", -1), -1)
    ok = ordered_dict_fromkeys(["a", "b"], 0)
    assert(ok.keys() == ["a", "b"])
    assert_eq(ok.get("a"), 0)

fn test_defaultdict():
    dd = defaultdict(fn() -> i64 => 0)
    dd.at("x")
    dd.at("x")
    dd.at("y")
    assert(dd.data == {"x": 0, "y": 0})
    assert_eq(dd.size(), 2)
    assert_eq(dd.get("missing"), None)
    assert_eq(dd.get_or("missing", 9), 9)
    assert_eq(dd.setdefault("z", 5), 5)
    assert_eq(dd.at("z"), 5)
    # factory producing a list
    wl = defaultdict(fn() -> [i64] => [])
    wl.at("k").append(1)
    wl.at("k").append(2)
    assert_eq(len(wl.at("k")), 2)
    assert_eq(wl.at("k")[0], 1)
    assert_eq(wl.at("k")[1], 2)
    assert_eq(len(wl.at("other")), 0)

fn test_chain_map():
    m1 = {"a": 1, "b": 2}
    m2 = {"b": 20, "c": 30}
    cm = ChainMap([m1, m2])
    assert_eq(cm.get("a"), 1)
    assert_eq(cm.get("b"), 2)   # first map wins
    assert_eq(cm.get("c"), 30)
    assert_eq(cm.get("zz"), None)
    cm.set("b", 99)             # writes to first map only
    assert_eq(m1["b"], 99)
    assert_eq(m2["b"], 20)
    assert(cm.keys() == ["a", "b", "c"])
    assert_eq(cm.size(), 3)
    child = cm.new_child({"z": 0})
    assert_eq(child.get("z"), 0)
    assert_eq(child.parents().size(), 3)
    cm.update({"d": 4})
    assert_eq(m1["d"], 4)

fn test_user_dict():
    ud = user_dict()
    ud.set("x", 10)
    ud.set("y", 20)
    ud.update({"z": 30})
    assert_eq(ud.size(), 3)
    assert_eq(ud.at("x"), 10)
    assert_eq(ud.get_or("q", -1), -1)
    assert_eq(ud.setdefault("w", 7), 7)
    ud.remove("w")
    assert_eq(ud.contains("w"), false)
    (k, v) = ud.popitem()
    assert_eq(k, "z")
    assert_eq(v, 30)
    assert_eq(ud.eq(UserDict({"x": 10, "y": 20})), true)
    cp = ud.copy()
    assert(cp.data == ud.data)

fn test_user_list():
    ul = user_list()
    ul.append(5)
    ul.append(1)
    ul.append(3)
    ul.sort()
    assert(ul.to_list() == [1, 3, 5])
    assert_eq(ul.size(), 3)
    assert_eq(ul.at(0), 1)
    assert_eq(ul.at(-1), 5)
    ul.insert(1, 9)
    assert(ul.to_list() == [1, 9, 3, 5])
    assert_eq(ul.pop(), 5)
    assert_eq(ul.pop_at(0), 1)
    assert(ul.to_list() == [9, 3])
    ul.set(0, 7)
    assert_eq(ul.at(0), 7)
    ul2 = user_list_of([1, 2, 2, 3])
    assert_eq(ul2.count(2), 2)
    assert_eq(ul2.index(3), 3)
    ul2.reverse()
    assert(ul2.to_list() == [3, 2, 2, 1])
    ul2.remove(2)
    assert(ul2.to_list() == [3, 2, 1])
