import keyword

fn main():
    print(len(keyword.kwlist))
    print(len(keyword.python_kwlist), len(keyword.softkwlist))

    # A keywords
    print(keyword.iskeyword("fn"))
    print(keyword.iskeyword("elif"))
    print(keyword.iskeyword("comptime"))
    print(keyword.iskeyword("Class"))
    print(keyword.iskeyword("None"))
    print(keyword.iskeyword("true"))
    print(keyword.iskeyword("def"))   # Python keyword, not A
    print(keyword.iskeyword("lambda"))
    print(keyword.iskeyword("Foo"))
    print(keyword.iskeyword(""))

    # Python keyword compat layer
    print(keyword.ispykeyword("def"))
    print(keyword.ispykeyword("yield"))
    print(keyword.ispykeyword("fn"))
    print(keyword.ispysoftkeyword("match"))
    print(keyword.ispysoftkeyword("case"))
    print(keyword.ispysoftkeyword("fn"))

    # soft keywords (Python's list, kept under the CPython name)
    print(keyword.issoftkeyword("match"))
    print(keyword.issoftkeyword("type"))
    print(keyword.issoftkeyword("_"))
    print(keyword.issoftkeyword("fn"))

    # list contents
    print(keyword.kwlist)
    print(keyword.python_kwlist)

main()
