import prelude
print(prelude.prelude_version())
v = prelude.Vec4(1, 2, 3, 4)
print(v.sum(), v.get(2), v.to_list())
w = v.add(prelude.Vec4(10, 20, 30, 40))
print(w.to_list())
print(v.dot(prelude.Vec4(1, 1, 1, 1)))
print(v.scale(2).to_list())
r = prelude.Ok(41)
print(prelude.is_ok(r), prelude.unwrap(r) + 1)
e = prelude.Err("bad")
print(prelude.is_err(e), prelude.err_value(e), prelude.unwrap_or(e, 9))
m = prelude.map_result(r, fn(x) => x * 2)
print(prelude.unwrap(m))
a = prelude.and_then(r, fn(x) => prelude.Ok(x + 1))
print(prelude.unwrap(a))
print(prelude.vectorize(fn(x) => x * x, [1, 2, 3]))
