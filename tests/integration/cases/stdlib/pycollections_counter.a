from "std/collections/__init__.a" import Counter

fn test_update_and_counts():
    c = Counter({})
    c.update(["a", "b", "a", "c", "b", "a"])
    c.update({"d": 2, "a": 1})
    assert_eq(c.get("a"), 4)
    assert_eq(c.get("zz"), 0)
    assert_eq(c.total(), 9)
    assert_eq(c.size(), 4)
    assert_eq(c.contains("b"), true)
    assert_eq(c.contains("zz"), false)
    # container results are dynamically typed; compare with == (assert_eq
    # is type-strict about Json vs native containers).
    assert(c.keys() == ["a", "b", "c", "d"])

fn test_elements_and_most_common():
    c = Counter({})
    c.update(["b", "a", "b", "a", "b"])
    # elements() repeats each key by its count in first-seen order.
    assert(c.elements() == ["b", "b", "b", "a", "a"])
    mc = c.most_common(1)
    (k, v) = mc[0]
    assert_eq(k, "b")
    assert_eq(v, 3)
    assert_eq(len(c.most_common(-1)), 2)
    all = c.most_common_all()
    (_, top) = all[0]
    assert_eq(top, 3)
    assert_eq(len(all), 2)

fn test_arithmetic():
    c1 = Counter({})
    c1.update(["a", "a", "b"])
    c2 = Counter({})
    c2.update(["a", "c"])
    assert(c1.plus(c2).counts == {"a": 3, "b": 1, "c": 1})
    assert(c1.minus(c2).counts == {"a": 1, "b": 1})
    assert(c1.intersect(c2).counts == {"a": 1})
    assert(c1.union(c2).counts == {"a": 2, "b": 1, "c": 1})

fn test_subtract_and_inc_dec():
    c = Counter({})
    c.update(["a", "a", "a", "b"])
    c.subtract(["a", "c"])
    assert(c.counts == {"a": 2, "b": 1, "c": -1})
    c.inc("b")
    c.dec("a")
    assert_eq(c.get("b"), 2)
    assert_eq(c.get("a"), 1)
    c2 = Counter({})
    c.update_counter(c2)
    c2.update_counter(c)
    assert_eq(c2.get("a"), 1)
    cp = c.copy()
    assert(cp.counts == c.counts)
    cp.clear()
    assert_eq(cp.size(), 0)
