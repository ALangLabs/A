enum Color:
    Red
    Green = 5
    Blue
    Yellow = -2
    Purple

ANSWER = 42

fn describe(c):
    return match c:
        Color.Red => "red"
        Color.Green => "green"
        Color.Blue => "blue"
        _ => "other"

entry main():
    print(Color.Red)
    print(Color.Green)
    print(Color.Blue)
    print(Color.Yellow)
    print(Color.Purple)
    print(ANSWER)
    print(describe(Color.Green))
    print(describe(Color.Purple))
    c = Color.Blue
    print(c + 1)
