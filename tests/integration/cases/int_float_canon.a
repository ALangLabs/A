# Canonical int/float types: annotations, conversions, and literals.

a: int = 41
b: int = 1
print(a + b)

f: float = 1.5
print(f * 2.0)

print(int("42") + 8)
print(float("2.5") + 0.5)
print(int(3.9))
print(type(7), type(7.0))

# Explicit-width spellings still work and interoperate.
c: i64 = 5
d: f64 = 2.5
print(c + a, d + f)
