import "../../../kernels/__init__.a" as kernels

print(kernels.fused_min([1, 5, 3], [2, 4, 3]))
print(kernels.fused_max([1, 5, 3], [2, 4, 3]))
print(kernels.fused_pow([2, 3], [2, 3]))
print(kernels.fused_sqrt([4.0, 9.0]))
print(kernels.fused_exp([0.0]))
print(kernels.fused_log([1.0]))
print(kernels.fused_reciprocal([2.0]))
print(kernels.reduce_prod([2, 3, 4]))
print(kernels.reduce_norm([3, 4], 2))
print(kernels.reduce_norm([1, 1, 1], 1))
print(kernels.outer([1, 2], [3, 4]))
print(kernels.eye(2))
print(kernels.zeros([2, 2]))
print(kernels.ones([2, 2]))
print(kernels.full([2, 2], 7))
print(kernels.trace([[1, 2], [3, 4]]))
print(kernels.diag([[1, 2, 3], [4, 5, 6]]))
print(kernels.reshape([1, 2, 3, 4], [2, 2]))
print(kernels.leaky_relu([-2.0, 1.0], 0.1))
print(kernels.gelu([0.0]))
print(kernels.silu([1.0]))
print(kernels.layer_norm([1.0, 2.0, 3.0], 1e-6))
print(kernels.attention_scores([1.0, 0.0], [[1.0, 0.0], [0.0, 1.0]]))
print(kernels.conv1d([1, 2, 3, 4], [1, 1], 1))
print(kernels.max_pool1d([1, 5, 2, 8], 2, 1))
print(kernels.avg_pool1d([1, 2, 3, 4], 2, 1))
print(kernels.quantize_int8([1.0, 2.0, -3.0], 0.5))
print(kernels.dequantize_int8([2, 4, -6], 0.5))
