fn divmod(a, b):
    return (a // b, a % b)

(q, r) = divmod(17, 5)
print(q, r)

(x, y) = (10, 20)
print(x + y)

# '_' discards a slot.
(_, rem) = divmod(9, 4)
print(rem)

pair = (1, "two")
print(pair)
(n, s) = pair
print(s, n)

# Tuples are iterable.
for item in (1, 2, 3):
    print(item)
total = 0
nums = (7, 8, 9)
for n in nums:
    total += n
print(total)
