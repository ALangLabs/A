import "../../../kernels/__init__.a" as kernels

print(kernels.fused_add([1, 2, 3], [10, 20, 30]))
print(kernels.fused_sub([10, 20, 30], [1, 2, 3]))
print(kernels.fused_mul([1, 2, 3], [4, 5, 6]))
print(kernels.fused_div([10, 20, 30], [2, 4, 5]))
print(kernels.fused_mul_add([1, 2, 3], [10, 20, 30], [1, 1, 1]))
print(kernels.fused_scale([1, 2, 3], 3))
print(kernels.fused_clamp([1, 5, 9], 2, 7))
print(kernels.reduce_sum([1, 2, 3, 4]))
print(kernels.reduce_max([1, 9, 3]))
print(kernels.reduce_min([4, 2, 8]))
print(kernels.reduce_mean([1, 2, 3, 4]))
print(kernels.argmax([1, 5, 3]))
print(kernels.argmin([4, 2, 8]))
print(kernels.dot([1, 2, 3], [4, 5, 6]))
print(kernels.matvec([[1, 2, 3], [4, 5, 6]], [7, 8, 9]))
print(kernels.matmul([[1, 2], [3, 4]], [[5, 6], [7, 8]]))
print(kernels.transpose([[1, 2, 3], [4, 5, 6]]))
print(kernels.relu([1, -2, 3]))
print(kernels.sigmoid([0.0]))
print(kernels.tanh([0.0]))
print(kernels.softmax([1.0, 1.0]))
print(kernels.softmax_rows([[1.0, 1.0], [2.0, 2.0]]))
print(kernels.bias_relu([1.0, -2.0, 0.5], -0.5))
print(kernels.normalize([3.0, 4.0]))
