# linalg/layout analog). Self-hosted pure A: triple-loop matmul with
import std:math

fn dot(a, b):
    total = 0
    for i in 0..len(a):
        total += a[i] * b[i]
    return total

fn matvec(mat, vec):
    out = []
    for row in mat:
        out.append(dot(row, vec))
    return out

fn matmul(a, b):
    # C[i][j] = sum_k A[i][k] * B[k][j]
    out = []
    if len(a) == 0:
        return out
    for i in 0..len(a):
        row = []
        for j in 0..len(b[0]):
            total = 0
            for k in 0..len(b):
                total += a[i][k] * b[k][j]
            row.append(total)
        out.append(row)
    return out

fn matmul_blocked(a, b, tile):
    # Cache-blocked matmul (Mojo/CBLAS-style tiling in pure A): the k loop
    # is outermost per output row and the j loop runs in `tile`-wide blocks,
    # so the active output row segments stay cache-hot while rows of B
    # stream sequentially — the ikj order used by tuned dense kernels.
    # Same contract and result as matmul(), but with fewer cache misses on
    # large matrices. `tile` must be a positive integer.
    out = []
    if len(a) == 0:
        return out
    for i in 0..len(a):
        row = []
        for j in 0..len(b[0]):
            row.append(0)
        out.append(row)
    for i in 0..len(a):
        j0 = 0
        while j0 < len(b[0]):
            j1 = j0 + tile
            if j1 > len(b[0]):
                j1 = len(b[0])
            for k in 0..len(b):
                a_ik = a[i][k]
                for j in j0..j1:
                    out[i][j] += a_ik * b[k][j]
            j0 = j1
    return out

fn transpose(mat):
    out = []
    if len(mat) == 0:
        return out
    for j in 0..len(mat[0]):
        row = []
        for i in 0..len(mat):
            row.append(mat[i][j])
        out.append(row)
    return out

fn outer(a, b):
    out = []
    for x in a:
        row = []
        for y in b:
            row.append(x * y)
        out.append(row)
    return out

fn eye(n):
    out = []
    for r in 0..n:
        row = []
        for c in 0..n:
            if r == c:
                row.append(1)

            else:
                row.append(0)
        out.append(row)
    return out

fn _nest(dims, d, leaf):
    # Build a nested-list tensor of shape `dims` with `leaf` values.
    if d == len(dims):
        return leaf
    row = []
    for i in 0..dims[d]:
        row.append(_nest(dims, d + 1, leaf))
    return row

fn zeros(shape):
    return _nest(shape, 0, 0)

fn ones(shape):
    return _nest(shape, 0, 1)

fn full(shape, value):
    return _nest(shape, 0, value)

fn trace(mat):
    total = 0
    for i in 0..len(mat):
        total += mat[i][i]
    return total

fn diag(mat):
    out = []
    n = len(mat)
    if len(mat[0]) < n:
        n = len(mat[0])
    for i in 0..n:
        out.append(mat[i][i])
    return out

fn _reshape_go(data, dims, d, box):
    # Recursive shape walk; `box` is a one-slot counter threaded through
    # the recursion so each depth consumes the next flat elements.
    if d == len(dims):
        value = data[box[0]]
        box[0] = box[0] + 1
        return value
    row = []
    for i in 0..dims[d]:
        row.append(_reshape_go(data, dims, d + 1, box))
    return row

fn reshape(data, shape):
    return _reshape_go(data, shape, 0, [0])
