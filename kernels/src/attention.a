#
# Self-hosted: scaled dot-product attention in A —
# scores = softmax(Q.K^T / sqrt(d)); output = scores.V.
import math

fn _scores(q, k):
    # Scaled dot-product scores of query q against each key row.
    scale = 1.0 / math.sqrt(len(q))
    out = []
    for row in k:
        total = 0.0
        for i in 0..len(q):
            total += q[i] * row[i]
        out.append(total * scale)
    return out

fn attention_scores(q, k):
    return _scores(q, k)

fn _softmax1d(xs):
    top = xs[0]
    for x in xs:
        if x > top:
            top = x
    exps = []
    total = 0.0
    for x in xs:
        e = math.exp(x - top)
        exps.append(e)
        total += e
    return [e / total for e in exps]

fn attention(q, k, v):
    # weights = softmax(scores); output[c] = sum_r weights[r] * V[r][c]
    weights = _softmax1d(_scores(q, k))
    out = []
    for c in 0..len(v[0]):
        acc = 0.0
        for r in 0..len(v):
            acc += weights[r] * v[r][c]
        out.append(acc)
    return out
