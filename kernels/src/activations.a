# Activation / normalization kernels (MAX analog, written in A).

fn softmax_row(xs: [f64]) -> [f64]:
    m = xs[0]
    for x in xs:
        if x > m:
            m = x
    out = []
    total = 0.0
    for x in xs:
        e = 2.718281828459045 ** (x - m)
        out.append(e)
        total = total + e
    result = []
    for e in out:
        result.append(e / total)
    return result

fn bias_relu(xs: [f64], bias: f64) -> [f64]:
    out = []
    for x in xs:
        v = x + bias
        if v < 0.0:
            v = 0.0
        out.append(v)
    return out
