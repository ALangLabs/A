# Activation kernels (MAX `max/kernels/src/nn` analog).
import kernel_ops

fn relu(xs):
    return kernel_ops.relu(xs)

fn sigmoid(xs):
    return kernel_ops.sigmoid(xs)

fn tanh(xs):
    return kernel_ops.tanh(xs)

fn gelu(xs):
    return kernel_ops.gelu(xs)

fn silu(xs):
    return kernel_ops.silu(xs)

fn elu(xs, alpha):
    return kernel_ops.elu(xs, alpha)

fn leaky_relu(xs, alpha):
    return kernel_ops.leaky_relu(xs, alpha)

fn softplus(xs):
    return kernel_ops.softplus(xs)

fn mish(xs):
    return kernel_ops.mish(xs)

fn softmax(xs):
    return kernel_ops.softmax(xs)

fn softmax_row(xs):
    return kernel_ops.softmax(xs)

fn softmax_rows(mat):
    return kernel_ops.softmax_rows(mat)

fn bias_relu(xs, bias):
    return kernel_ops.bias_relu(xs, bias)
