{
  "comments": {
    "lineComment": "#",
    "blockComment": []
  },
  "completionTriggerCharacters": [".", "\"", "(", ",", ":", "<", ">", "?"],
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"\"\"", "close": "\"\"\"", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "autoclosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"\"\"", "close": "\"\"\"" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"\"\"", "\"\"\""],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:fn|class|enum|trait|impl|type|if|elif|else|while|do|for|loop|match)\\b.*:\\s*$",
      "end": "^\\s*$"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*:\\s*(?:#.*)?$",
    "increaseIndentPattern2": "^\\s*(?:fn|class|enum|trait|impl|type)\\s+[^\\n]*:\\s*$",
    "decreaseIndentPattern": "^\\s*(?:elif\\b|else\\b|while\\b.*|do\\b)$",
    "indentNextLinePattern": "\\s+:\\s*(?:#.*)?$",
    "outdentNextLinePattern": "^\\s*(?:elif\\b|else\\b|while\\b.*|do\\b)$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*:\\s*(?:#.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?:elif\\b|else\\b|while\\b.*|do\\b).*$",
      "action": { "indent": "outdent" }
    },
    {
      "beforeText": "^\\s*#.*$",
      "action": { "indent": "none" },
      "afterText": "^\\s*#.*$",
      "appendText": "# "
    },
    {
      "beforeText": "^\\s*.*\"\"\"\\s*$",
      "action": { "indent": "none" },
      "appendText": "\"\"\""
    },
    {
      "beforeText": "^\\s*(?:fn|class|enum|trait|impl)\\b.*:\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?:match|enum|class).*:\\s*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@$^&*()=+\\[{\\]}\\\\|;:'\",.<>/?\\s]+)"
}
