{
  "name": "A",
  "scopeName": "source.a",
  "fileTypes": [
    "a"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#self" },
    { "include": "#operators" },
    { "include": "#function-calls" },
    { "include": "#members" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.todo.a",
          "match": "#\\s*(TODO|FIXME|XXX|HACK|NOTE)\\b[^\\n]*$",
          "captures": {
            "1": { "name": "keyword.other.todo.a" }
          }
        },
        {
          "name": "comment.line.number-sign.a",
          "match": "#[^\\n]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.a",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#triple-string-content" }
          ]
        },
        {
          "name": "string.quoted.double.a",
          "begin": "\"",
          "end": "\"|\\r?\\n",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" },
            { "include": "#string-content" }
          ]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "string.unquoted.a",
          "match": "[^\"\\\\\\n{]+"
        }
      ]
    },
    "triple-string-content": {
      "patterns": [
        {
          "name": "string.unquoted.a",
          "match": "[^\"]+"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.a",
          "begin": "\\{",
          "end": "\\}",
          "captures": {
            "0": { "name": "punctuation.definition.interpolation.a" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.a",
          "match": "\\\\(?:[nrtabfv0\\\\\"'{}]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.a",
          "begin": "'",
          "end": "'|\\r?\\n",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.integer.a",
          "match": "\\b0[xX][0-9A-Fa-f_]+"
        },
        {
          "name": "constant.numeric.binary.integer.a",
          "match": "\\b0[bB][01_]+"
        },
        {
          "name": "constant.numeric.float.a",
          "match": "\\b\\d[\\d_]*\\.[\\d_]+(?:[eE][+-]?[\\d_]+)?|\\b\\d[\\d_]*\\.[eE][+-]?[\\d_]+|\\b\\d[\\d_]*\\.(?![.\\w])|\\b\\d[\\d_]*[eE][+-]?[\\d_]+"
        },
        {
          "name": "constant.numeric.integer.a",
          "match": "\\b\\d[\\d_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.class.a",
          "begin": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.class.a" }
          },
          "patterns": [
            { "include": "$self" },
            {
              "name": "variable.other.property.a",
              "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)"
            },
            {
              "name": "variable.other.property.a",
              "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*$"
            }
          ]
        },
        {
          "name": "meta.enum.a",
          "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.enum.a" }
          },
          "patterns": [
            {
              "name": "entity.name.type.enum-member.a",
              "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?==|,|$)"
            },
            { "include": "$self" }
          ]
        },
        {
          "name": "meta.trait.a",
          "begin": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.trait.a" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "meta.type.a",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=)",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.a" }
          }
        },
        {
          "name": "meta.impl.a",
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s+for\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "support.type.trait.a" },
            "3": { "name": "support.type.a" }
          }
        },
        {
          "name": "meta.function.test.a",
          "begin": "\\b(fn)\\s+(test_[A-Za-z_][A-Za-z0-9_]*)\\s*(?:<([^>]*)>)?\\s*\\(",
          "end": "\\)",
          "captures": {
            "1": { "name": "storage.type.function.a" },
            "2": { "name": "entity.name.function.test.a" },
            "3": { "name": "support.type.generic.a" }
          },
          "patterns": [
            { "include": "#function-params" }
          ]
        },
        {
          "name": "meta.function.a",
          "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?:<([^>]*)>)?\\s*\\(",
          "end": "\\)",
          "captures": {
            "1": { "name": "storage.type.function.a" },
            "2": { "name": "entity.name.function.a" },
            "3": { "name": "support.type.generic.a" }
          },
          "patterns": [
            { "include": "#function-params" }
          ]
        },
        {
          "name": "meta.lambda.a",
          "begin": "\\b(fn)\\s*(?=\\()",
          "end": "\\)",
          "captures": {
            "1": { "name": "storage.type.function.a" }
          },
          "patterns": [
            { "include": "#function-params" }
          ]
        },
        {
          "name": "meta.from-import.a",
          "begin": "\\b(from)\\s+(\"(?:[^\"\\\\\\n]|\\\\.)*\"|(?:std|python):[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|[A-Za-z_][A-Za-z0-9_]*)\\s+(import)",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.a" },
            "2": { "name": "entity.name.type.module.a" },
            "3": { "name": "keyword.control.import.a" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "keyword.control.import.a",
              "match": "\\bas\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "entity.name.type.module.alias.a" }
              }
            },
            {
              "name": "keyword.control.import.a",
              "match": "\\bas\\b"
            },
            {
              "name": "punctuation.separator.a",
              "match": ","
            },
            {
              "name": "entity.name.type.module.member.a",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        },
        {
          "name": "meta.import.a",
          "match": "\\b(import)\\s+(\"(?:[^\"\\\\\\n]|\\\\.)*\"|(?:std|python):[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*|[A-Za-z_][A-Za-z0-9_]*)(\\s+as\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.a" },
            "2": { "name": "entity.name.type.module.a" },
            "3": { "name": "keyword.control.import.a" },
            "4": { "name": "entity.name.type.module.alias.a" }
          }
        }
      ]
    },
    "function-params": {
      "patterns": [
        { "include": "#self" },
        {
          "match": "\\b(comptime)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "3": { "name": "variable.parameter.a" }
          }
        },
        {
          "name": "storage.modifier.a",
          "match": "\\*(?=\\s*[A-Za-z_])"
        },
        {
          "name": "variable.parameter.a",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:)"
        },
        {
          "match": "(?<=[(,*])\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:,|\\)|=))",
          "captures": {
            "1": { "name": "variable.parameter.a" }
          }
        },
        { "include": "$self" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.a",
          "match": "(?<![.\\w])(?:bool|char|str|String|Bytes|Json|int|float|void|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)(\\?+)?(?![\\w(?])",
          "captures": {
            "1": { "name": "keyword.operator.optional.a" }
          }
        },
        {
          "name": "support.type.custom.a",
          "match": "(?<![.\\w])[a-z_][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)+",
          "captures": {
            "0": { "name": "support.type.custom.a" }
          }
        },
        {
          "name": "support.type.custom.a",
          "match": "(?<![.\\w])([A-Z][A-Za-z0-9_]*)(\\s*<(?:[^<>]|<[^<>]*>)*>)?(\\?+)?(?![\\w(?])",
          "captures": {
            "1": { "name": "entity.name.type.a" },
            "2": { "name": "support.type.generic.a" },
            "3": { "name": "keyword.operator.optional.a" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.a",
          "match": "(?<![.\\w])(?:print|eprint|input|flush|len|str|int|float|bool|repr|type|isinstance|abs|min|max|sum|pow|sqrt|sin|cos|tan|asin|acos|atan|atan2|exp|log|log2|log10|floor|ceil|round|trunc|random|random_int|join|map|filter|reduce|any|all|some|sorted|reversed|enumerate|zip|set|tuple|list|dict|range|open|close|assert|assert_eq|panic|ic|__repr__|__debug_repr__|__ic_format__|read_file|write_file|append_file|read_bytes|write_bytes|file_exists|file_size|list_dir|remove_file|create_dir|remove_dir|rename|current_dir|now|sleep|env_get|dot|matvec|matvec_t|matmul|softmax|attention|linalg_dot|linalg_matvec|linalg_matvec_t|linalg_matmul|linalg_softmax|linalg_attention|unsafe_get|unsafe_set|arena_new|arena_pool|arena_region|arena_alloc|arena_release|arena_reset|arena_used|arena_total|move|copy|borrow|borrow_mut|unsafe_address_of|unsafe_load|unsafe_store|unsafe_offset|py_buffer|bytes_new|bytes_append|bytes_to_str|bytes_utf8_decode|bytes_utf8_encode|Some|Ok|Err|Bytes|ok|err|ctz|clz|popcount|bswap|rotl|rotr|fma|fabs|copysign|smin|smax|umin|umax|sadd_overflow|ssub_overflow|smul_overflow|uadd_overflow|usub_overflow|umul_overflow|expect|likely|unlikely)\\b(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.bool.a",
          "match": "(?<![.\\w])(?:true|false)\\b"
        },
        {
          "name": "constant.language.none.a",
          "match": "(?<![.\\w])None\\b"
        },
        {
          "name": "constant.language.io.a",
          "match": "(?<![.\\w])(?:stdout|stderr)\\b"
        },
        {
          "name": "constant.numeric.float.a",
          "match": "(?<![.\\w])(?:PI|E|F32_MIN|F32_MAX|F64_MIN|F64_MAX)\\b"
        },
        {
          "name": "constant.numeric.integer.a",
          "match": "(?<![.\\w])(?:I8_MIN|I8_MAX|I16_MIN|I16_MAX|I32_MIN|I32_MAX|I64_MIN|I64_MAX|U8_MAX|U16_MAX|U32_MAX)\\b"
        },
        {
          "name": "variable.language.discard.a",
          "match": "(?<![.\\w])_\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.function.a",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.modifier.a",
          "match": "\\b(?:class|metaclass|enum|trait|impl|type|comptime)\\b"
        },
        {
          "name": "keyword.control.import.a",
          "match": "\\b(?:import|from|as)\\b"
        },
        {
          "name": "keyword.control.flow.a",
          "match": "\\b(?:if|elif|else|while|do|for|in|loop|break|continue|return|match|where|pass)\\b"
        },
        {
          "name": "keyword.control.defer.a",
          "match": "\\bdefer\\b"
        },
        {
          "name": "keyword.operator.logical.a",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.self.a",
          "match": "\\bself\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.coalesce.a",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.safe-navigation.a",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.pipe.a",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.a",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.a",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.increment.a",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.a",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.assignment.a",
          "match": "<<=|>>="
        },
        {
          "name": "keyword.operator.bitwise.a",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.a",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.a",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|="
        },
        {
          "name": "keyword.operator.logical.a",
          "match": "!"
        },
        {
          "name": "keyword.operator.optional.a",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.bitwise.a",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.a",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.a",
          "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "end": "\\)",
          "captures": {
            "1": { "name": "entity.name.function.call.a" }
          },
          "patterns": [
            {
              "name": "variable.parameter.a",
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=(?!=))"
            },
            { "include": "$self" }
          ]
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "entity.name.function.call.a",
          "match": "(?<=\\.)(?<!\\.\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        },
        {
          "name": "variable.other.property.a",
          "match": "(?<=\\.)(?<!\\.\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.a",
          "match": ","
        },
        {
          "name": "punctuation.separator.annotation.a",
          "match": ":"
        },
        {
          "name": "punctuation.definition.parameters.a",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.block.a",
          "match": "[\\[\\]{}]"
        },
        {
          "name": "punctuation.accessor.a",
          "match": "\\."
        }
      ]
    }
  }
}
