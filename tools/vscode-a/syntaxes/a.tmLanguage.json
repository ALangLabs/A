{
  "name": "A",
  "scopeName": "source.a",
  "fileTypes": [
    "a"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#raw-strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#self" },
    { "include": "#operators" },
    { "include": "#members" },
    { "include": "#function-calls" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.documentation.a",
          "match": "^\\s*(##+)\\s*(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.documentation.a" },
            "2": { "name": "comment.content.documentation.a" }
          }
        },
        {
          "name": "comment.line.number-sign.todo.a",
          "match": "#\\s*(TODO|FIXME|XXX|HACK|NOTE)\\b.*$",
          "captures": {
            "1": { "name": "keyword.other.todo.a" }
          }
        },
        {
          "name": "comment.line.number-sign.a",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.a",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-content" }
          ]
        },
        {
          "name": "string.quoted.double.a",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" },
            { "include": "#string-content" }
          ]
        }
      ]
    },
    "raw-strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.raw.a",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-content" }
          ]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "string.unquoted.a",
          "match": "[^\"\\\\\\n{}]+"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.a",
          "begin": "\\{",
          "end": "\\}",
          "captures": {
            "0": { "name": "punctuation.definition.interpolation.a" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.a",
          "match": "\\\\(?:[nrt0abfv\\\\\"'{]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.a",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.integer.a",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.integer.a",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.integer.a",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.a",
          "match": "\\b\\d[\\d_]*\\.[\\d_]+(?:[eE][+-]?[\\d_]+)?\\b|\\b\\d[\\d_]*(?:[eE][+-]?[\\d_]+)\\b"
        },
        {
          "name": "constant.numeric.integer.a",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.struct.a",
          "match": "\\b(struct)\\s+([A-Z][A-Za-z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.struct.a" }
          }
        },
        {
          "name": "meta.class.a",
          "match": "\\b(class|Class|metaclass|Metaclass)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?:<([^>]*)>)?",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.class.a" },
            "3": { "name": "support.type.generic.a" }
          }
        },
        {
          "name": "meta.enum.a",
          "match": "\\b(enum)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?:<([^>]*)>)?",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.enum.a" },
            "3": { "name": "support.type.generic.a" }
          }
        },
        {
          "name": "meta.trait.a",
          "match": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.trait.a" }
          }
        },
        {
          "name": "meta.type.a",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*=",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "entity.name.type.a" }
          }
        },
        {
          "name": "meta.impl.a",
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+for\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "support.type.trait.a" },
            "3": { "name": "support.type.a" }
          }
        },
        {
          "name": "meta.function.a",
          "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?:<([^>]*)>)?\\s*\\(",
          "end": "\\)",
          "captures": {
            "1": { "name": "storage.type.function.a" },
            "2": { "name": "entity.name.function.a" },
            "3": { "name": "support.type.generic.a" }
          },
          "patterns": [
            { "include": "#function-params" }
          ]
        },
        {
          "name": "meta.function.method.a",
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "storage.type.function.a" },
            "2": { "name": "entity.name.function.method.a" }
          }
        },
        {
          "name": "meta.from-import.a",
          "begin": "\\b(from)\\s+(\"[^\"]*\"|python:[A-Za-z_][A-Za-z0-9_.]*|[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\s+(import)",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.a" },
            "2": { "name": "entity.name.type.module.a" },
            "3": { "name": "keyword.control.import.a" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "keyword.control.import.a",
              "match": "\\bas\\b"
            },
            {
              "name": "punctuation.separator.a",
              "match": ","
            },
            {
              "name": "entity.name.type.module.member.a",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        },
        {
          "name": "meta.import.a",
          "match": "\\b(import)\\s+(\"[^\"]*\"|python:[A-Za-z_][A-Za-z0-9_.]*|[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(\\s+as\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.a" },
            "2": { "name": "entity.name.type.module.a" },
            "3": { "name": "keyword.control.import.a" },
            "4": { "name": "entity.name.type.module.alias.a" }
          }
        }
      ]
    },
    "function-params": {
      "patterns": [
        {
          "name": "variable.parameter.a",
          "match": "\\b(comptime\\s+)?([A-Za-z_][A-Za-z0-9_]*)(\\s*:\\s*([Ee]?(?:[A-Za-z_][A-Za-z0-9_]*(?:<[^>]*>)?)|\\[[^\\]]*\\])\\s*(\\?)?)?",
          "captures": {
            "1": { "name": "storage.modifier.a" },
            "2": { "name": "variable.parameter.a" },
            "4": { "name": "support.type.a" },
            "5": { "name": "keyword.operator.optional.a" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.generic.a",
          "match": "\\b(Option|Result|Async|Array|Map|Set|Tuple|Json|Allocator|Pointer)\\s*<[^>]*>",
          "captures": {
            "1": { "name": "support.type.generic.a" }
          }
        },
        {
          "name": "support.type.primitive.a",
          "match": "\\b(?:bool|char|str|String|int|float|void|Json|Allocator|Pointer|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)\\b(\\?)?",
          "captures": {
            "1": { "name": "keyword.operator.optional.a" }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?:<([^>]*)>)?",
          "captures": {
            "1": { "name": "support.type.custom.a" },
            "2": { "name": "support.type.generic.a" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.a",
          "match": "\\b(?:print|eprint|input|flush|len|str|bool|int|float|range|map|filter|reduce|sum|any|all|min|max|abs|pow|sqrt|round|floor|ceil|sorted|reversed|enumerate|zip|open|close|type|isinstance|assert|panic|sin|cos|tan|asin|acos|atan|atan2|exp|log|log2|log10|trunc|random|random_int|flush|move|copy|borrow|borrow_mut)\\b(?=\\s*\\()"
        },
        {
          "name": "support.constant.math.a",
          "match": "\\b(?:PI|E|I8_MIN|I8_MAX|I16_MIN|I16_MAX|I32_MIN|I32_MAX|I64_MIN|I64_MAX|U8_MIN|U8_MAX|U16_MIN|U16_MAX|U32_MIN|U32_MAX|U64_MIN|U64_MAX)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.bool.a",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.none.a",
          "match": "\\bNone\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.comptime.a",
          "match": "\\bcomptime\\b"
        },
        {
          "name": "storage.modifier.a",
          "match": "\\b(?:var|const|pvt)\\b"
        },
        {
          "name": "keyword.control.async.a",
          "match": "\\b(?:async|await)\\b"
        },
        {
          "name": "keyword.control.import.a",
          "match": "\\b(?:import|from|as)\\b"
        },
        {
          "name": "keyword.control.flow.a",
          "match": "\\b(?:if|elif|else|while|do|for|in|loop|break|continue|return|match|where|pass)\\b"
        },
        {
          "name": "keyword.control.defer.a",
          "match": "\\bdefer\\b"
        },
        {
          "name": "keyword.operator.logical.a",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.operator.try.a",
          "match": "\\?"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.self.a",
          "match": "\\bself\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.coalesce.a",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.safe-navigation.a",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.pipe.a",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.a",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.a",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.optional.a",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.comparison.a",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.bitwise.a",
          "match": "<<=|>>=|<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.assignment.a",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|="
        },
        {
          "name": "keyword.operator.increment.a",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.a",
          "match": "\\*\\*|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.a",
          "match": "!"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "entity.name.function.call.a",
          "match": "(?<=[.?])\\s*[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.property.a",
          "match": "(?<=[.?])\\s*[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.call.a",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.a",
          "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "end": "\\)",
          "captures": {
            "1": { "name": "entity.name.function.call.a" }
          },
          "patterns": [
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.a",
          "match": "[,;]"
        },
        {
          "name": "punctuation.definition.parameters.a",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.block.a",
          "match": "[\\[\\]{}]"
        },
        {
          "name": "punctuation.separator.annotation.a",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.a",
          "match": "\\."
        }
      ]
    }
  }
}
