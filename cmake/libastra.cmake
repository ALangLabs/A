# Builds the Astra (compiler/astra/) as the builtin
# C backend for JIT and native EXE output. It has its own configure/make,
# which cannot be reached from here on all three platforms, so what it would
# have produced is produced here instead: a config.h, the library itself
# (one translation unit, ONE_SOURCE), the driver, and -- built by that
# driver, since parts of it are assembly -- the support archive every
# program it compiles links against. The archive, the runtime headers and
# (on Windows) the import definitions are staged into one directory, which
# is what astra_set_lib_path() is given.

set(ASTRA_SRC "${CMAKE_CURRENT_SOURCE_DIR}/compiler/astra/backend")
set(ASTRA_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/compiler/astra")
set(ASTRA_BUILD "${CMAKE_BINARY_DIR}/astra")
set(ASTRA_STAGE "${CMAKE_BINARY_DIR}/astralib")

if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(astra_arch x86_64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(astra_arch arm64)
else()
    message(FATAL_ERROR "libastra: no native backend for CPU '${CMAKE_SYSTEM_PROCESSOR}'; "
                        "the compiler builds on x86-64 and arm64")
endif()

if(astra_arch STREQUAL "x86_64")
    set(astra_defines ASTRA_TARGET_X86_64)
else()
    set(astra_defines ASTRA_TARGET_ARM64)
endif()
if(WIN32)
    list(APPEND astra_defines ASTRA_TARGET_PE)
elseif(APPLE)
    list(APPEND astra_defines ASTRA_TARGET_MACHO)
endif()

# --- config.h ----------------------------------------------------------------
# CONFIG_ASTRA_PREDEFS 0 makes the native compiler read include/astradefs.h from the staged
# directory instead of from a string baked in by its own build tools, which are
# not run here. Bounds checking and backtraces are off: both pull in support
# objects that need the full Windows SDK headers, which the native compiler does not ship.

file(READ "${ASTRA_SRC}/VERSION" astra_version)
string(STRIP "${astra_version}" astra_version)
set(astra_config "/* Generated by cmake/libastra.cmake. */
#define ASTRA_VERSION \"${astra_version}\"
#define CONFIG_ASTRA_PREDEFS 0
#define CONFIG_ASTRA_BACKTRACE 0
#define CONFIG_ASTRA_BCHECK 0
#define CONFIG_ASTRA_SYSINCLUDEPATHS \"{B}/include\"
#define CONFIG_ASTRA_CRTPREFIX \"{B}\"
")
# The driver builds compiler support from bundled headers; JIT receives its
# host symbols and support archive explicitly.
if(WIN32)
    string(APPEND astra_config "#define CONFIG_ASTRA_LIBPATHS \"{B}/lib\"\n")
elseif(APPLE)
    string(APPEND astra_config "#define CONFIG_ASTRA_LIBPATHS \"{B}\"\n")
else()
    # {B} is the staged runtime dir; the system dirs let `astra` link real
    # executables (crt1.o/crti.o/crtn.o, libc.so, libm, ...). The multiarch
    # dir covers Debian/Ubuntu; /usr/lib + /lib cover the rest.
    if(NOT CMAKE_LIBRARY_ARCHITECTURE)
        set(CMAKE_LIBRARY_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}-linux-gnu")
    endif()
    string(APPEND astra_config "#define CONFIG_ASTRA_LIBPATHS \"{B}:/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}:/lib/${CMAKE_LIBRARY_ARCHITECTURE}:/usr/lib:/lib\"\n")
endif()
# Use separate writable and executable file mappings on SELinux systems.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND EXISTS "/sys/fs/selinux/enforce")
    string(APPEND astra_config "#define CONFIG_SELINUX 1\n")
endif()
# libgcc supplies the unwinders and soft-fp helpers crt code and the A runtime
# reference; ask the host C compiler where its static archive lives.
if(NOT WIN32 AND NOT APPLE)
    execute_process(COMMAND ${CMAKE_C_COMPILER} -print-file-name=libgcc.a
        OUTPUT_VARIABLE astra_libgcc OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE astra_libgcc_rc)
    if(astra_libgcc_rc EQUAL 0 AND astra_libgcc MATCHES "/libgcc\\.a$")
        string(APPEND astra_config "#define ASTRA_LIBGCC \"${astra_libgcc}\"\n")
    endif()
endif()
# Written only when it changes, so reconfiguring does not rebuild the native compiler.
file(CONFIGURE OUTPUT "${ASTRA_BUILD}/config.h" CONTENT "${astra_config}" @ONLY)

# --- the library and the driver ----------------------------------------------

add_library(libastra STATIC "${ASTRA_SRC}/libastra.c")
target_include_directories(libastra PRIVATE "${ASTRA_BUILD}")
target_include_directories(libastra SYSTEM PRIVATE "${ASTRA_SRC}")
# Expose only the API header: the VERSION file shadows the C++ <version>
# header on case-insensitive filesystems (including the macOS CI runner).
# Keep this separate from the staged runtime headers, which also shadow the
# host compiler's standard headers.
configure_file("${ASTRA_SRC}/libastra.h" "${ASTRA_BUILD}/api/libastra.h" COPYONLY)
target_include_directories(libastra SYSTEM PUBLIC "${ASTRA_BUILD}/api")
target_compile_definitions(libastra PRIVATE ${astra_defines} ONE_SOURCE=1)
# Without the rename the archive would be liblibastra; PIC because the compiled
# program is relocated into memory the compiler owns.
set_target_properties(libastra PROPERTIES
    C_STANDARD 99 OUTPUT_NAME astra POSITION_INDEPENDENT_CODE ON)

# The driver exists to build libastra1.a below: parts of it are assembly,
# which only the native compiler assembles.
add_executable(astra_driver "${ASTRA_SRC}/astra.c")
target_include_directories(astra_driver PRIVATE "${ASTRA_BUILD}")
target_compile_definitions(astra_driver PRIVATE ${astra_defines} ONE_SOURCE=0)
target_link_libraries(astra_driver PRIVATE libastra)
set_target_properties(astra_driver PROPERTIES
    C_STANDARD 99 OUTPUT_NAME astra RUNTIME_OUTPUT_DIRECTORY "${ASTRA_BUILD}")
# The Visual Studio and Xcode generators add a per-configuration subdirectory
# to every output path unless it is overridden for each configuration by name.
foreach(cfg IN LISTS CMAKE_CONFIGURATION_TYPES)
    string(TOUPPER "${cfg}" cfgu)
    set_target_properties(astra_driver PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY_${cfgu} "${ASTRA_BUILD}")
endforeach()

# Third-party code: its warnings are not this project's to act on. /W0 rather
# than /w so the Visual Studio generator recognises it as the warning level and
# does not also emit its own.
foreach(t IN ITEMS libastra astra_driver)
    target_compile_options(${t} PRIVATE $<IF:$<BOOL:${MSVC}>,/W0,-w>)
    # The C backend is the hot path (A -> machine code for every run/build);
    # keep it at -O3 even in non-Release configs so `a run` stays C-fast.
    if(NOT MSVC)
        target_compile_options(${t} PRIVATE -O3)
    endif()
endforeach()
if(NOT WIN32)
    target_link_libraries(libastra PUBLIC ${CMAKE_DL_LIBS} m)
endif()

# --- staged runtime directory ------------------------------------------------
# What astra_set_lib_path() is pointed at, laid out the way its own install
# is: its headers under include/, and the support archive where the target's
# default library path looks for it (lib/ on Windows, the root elsewhere).

file(COPY "${ASTRA_SRC}/include/" DESTINATION "${ASTRA_STAGE}/include")
# A runtime (compiler/astra/runtime/): the frontend's emitted assembly links
# against the runtime modules (a_runtime.c dispatch/print/init plus the domain
# .c modules and a_runtime_internal.h); stage them next to the
# support archive so `astra` can compile emitted code standalone. Copied by
# build-time custom commands (not file(COPY)) so runtime edits are picked up
# on rebuild. CONFIGURE_DEPENDS re-globs when modules are added/removed, and
# staged files whose source disappeared are removed at configure time.
file(GLOB ASTRA_RUNTIME_SOURCES CONFIGURE_DEPENDS
     "${ASTRA_ROOT}/runtime/*.c" "${ASTRA_ROOT}/runtime/*.h"
     "${ASTRA_ROOT}/runtime/*.s"
     "${ASTRA_ROOT}/backend/python/*.c")
file(GLOB ASTRA_RUNTIME_STAGED "${ASTRA_STAGE}/*.c" "${ASTRA_STAGE}/*.h" "${ASTRA_STAGE}/*.s")
foreach(staged IN LISTS ASTRA_RUNTIME_STAGED)
    get_filename_component(staged_name "${staged}" NAME)
    if(NOT EXISTS "${ASTRA_ROOT}/runtime/${staged_name}" AND
       NOT EXISTS "${ASTRA_ROOT}/backend/python/${staged_name}")
        file(REMOVE "${staged}")
    endif()
endforeach()
set(ASTRA_RUNTIME_STAGED_OUTPUTS "")
set(ASTRA_RUNTIME_C_OUTPUTS "")
foreach(rt_file IN LISTS ASTRA_RUNTIME_SOURCES)
    get_filename_component(rt_name "${rt_file}" NAME)
    set(staged_file "${ASTRA_STAGE}/${rt_name}")
    add_custom_command(
        OUTPUT "${staged_file}"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${rt_file}" "${staged_file}"
        DEPENDS "${rt_file}"
        COMMENT "stage ${rt_name} -> astralib"
        VERBATIM)
    list(APPEND ASTRA_RUNTIME_STAGED_OUTPUTS "${staged_file}")
    if(rt_file MATCHES "\\.c$")
        list(APPEND ASTRA_RUNTIME_C_OUTPUTS "${staged_file}")
    endif()
endforeach()
if(WIN32)
    set(astra_libdir "${ASTRA_STAGE}/lib")
    # Bundled Windows headers and the .def files naming system DLL
    # exports, also used when building its compiler support archive.
    file(COPY "${ASTRA_SRC}/win32/include/" DESTINATION "${ASTRA_STAGE}/include")
    file(GLOB astra_defs "${ASTRA_SRC}/win32/lib/*.def")
    file(COPY ${astra_defs} DESTINATION "${astra_libdir}")
else()
    set(astra_libdir "${ASTRA_STAGE}")
endif()

# --- libastra1 -----------------------------------------------------------------
# The compiler support routines every compiled program links against.
# This is the lib/Makefile object list for the target, minus the pieces
# only a standalone executable or DLL needs (the C runtime startup code, bounds
# checking, backtraces), none of which an in-memory run reaches.

if(astra_arch STREQUAL "arm64")
    set(astra1_srcs lib/lib-arm64.c)
    if(NOT WIN32 AND NOT APPLE)
        list(APPEND astra1_srcs lib/armflush.c)
    endif()
else()
    set(astra1_srcs lib/libastra1.c)
    if(NOT WIN32)
        list(APPEND astra1_srcs lib/va_list.c)
    endif()
endif()
list(APPEND astra1_srcs lib/stdatomic.c lib/atomic.S lib/builtin.c
                      lib/alloca.S lib/alloca-bt.S lib/tcov.c)
if(WIN32)
    # crt1.c is where the Windows _runmain lives — the entry point astra_run()
    # calls, which the platform-independent lib/runmain.c defines only for the
    # ELF and Mach-O targets. wincrt1.c / dllcrt1.c (+ crt1w.c / wincrt1w.c
    # UNICODE variants) provide the GUI and DLL entry points astrape.c looks
    # up by symbol (__winstart/__wwinstart/__dllstart) in this archive.
    list(APPEND astra1_srcs win32/lib/chkstk.S win32/lib/winex.c win32/lib/crt1.c
                        win32/lib/crt1w.c win32/lib/wincrt1.c win32/lib/wincrt1w.c
                        win32/lib/dllcrt1.c win32/lib/dllmain.c)
elseif(NOT APPLE)
    list(APPEND astra1_srcs lib/dsohandle.c)
endif()

# Astra no longer compiles C: the support objects below are built by the
# system C compiler for the host target (and by a detected cross C
# toolchain for cross targets, see the astralib-<arch> loop).
set(astra1_cc_flags -O2 -std=gnu11 -w -fno-semantic-interposition
    -I${ASTRA_STAGE} -I${ASTRA_STAGE}/include -I${ASTRA_BUILD} -I${ASTRA_SRC})
if(WIN32)
    list(APPEND astra1_cc_flags -I${ASTRA_STAGE}/include/winapi)
endif()
set(astra1_objs "")
file(MAKE_DIRECTORY "${ASTRA_BUILD}/obj")
foreach(src IN LISTS astra1_srcs)
    get_filename_component(obj "${src}" NAME_WE)
    set(obj "${ASTRA_BUILD}/obj/${obj}.o")
    add_custom_command(OUTPUT "${obj}"
        COMMAND ${CMAKE_C_COMPILER} ${astra1_cc_flags}
                -c "${ASTRA_SRC}/${src}" -o "${obj}"
        DEPENDS "${ASTRA_SRC}/${src}"
        COMMENT "cc ${src}"
        VERBATIM)
    list(APPEND astra1_objs "${obj}")
endforeach()

add_custom_command(OUTPUT "${astra_libdir}/libastra1.a"
    COMMAND ${CMAKE_AR} rcs "${astra_libdir}/libastra1.a" ${astra1_objs}
    DEPENDS ${astra1_objs}
    COMMENT "ar libastra1.a"
    VERBATIM)

# astra_run() loads this one separately: it is what calls the program's main and
# runs its constructors, so it is deliberately not inside the archive.
add_custom_command(OUTPUT "${astra_libdir}/runmain.o"
    COMMAND ${CMAKE_C_COMPILER} ${astra1_cc_flags}
            -c "${ASTRA_SRC}/lib/runmain.c" -o "${astra_libdir}/runmain.o"
    DEPENDS "${ASTRA_SRC}/lib/runmain.c"
    COMMENT "cc lib/runmain.c"
    VERBATIM)

# Prebuild the A runtime modules once into libaruntime.a so `a run`/`a build`
# link an archive instead of recompiling every runtime .c per program. Built
# by the system C compiler on every host OS — Astra's C frontend is gone, so
# this archive is required for every target (the `a` pipeline errors clearly
# when it is missing).
set(ASTRA_RT_OBJS "")
set(ASTRA_RT_CC_FLAGS -O3 -std=gnu11 -w -fno-semantic-interposition
    -I${ASTRA_STAGE})
if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|amd64|i386|i686")
    list(APPEND ASTRA_RT_CC_FLAGS -march=native -mtune=native)
endif()
foreach(rt_c IN LISTS ASTRA_RUNTIME_C_OUTPUTS)
    get_filename_component(rt_c_name "${rt_c}" NAME)
    set(rt_obj "${ASTRA_BUILD}/obj/cc_rt_${rt_c_name}.o")
    add_custom_command(OUTPUT "${rt_obj}"
        COMMAND ${CMAKE_C_COMPILER} ${ASTRA_RT_CC_FLAGS}
                -c "${rt_c}" -o "${rt_obj}"
        DEPENDS "${rt_c}"
        COMMENT "system runtime ${rt_c_name}"
        VERBATIM)
    list(APPEND ASTRA_RT_OBJS "${rt_obj}")
endforeach()
# Vendored mimalloc (compiler/astra/runtime/vendor/mimalloc): compiled as a
# single TU exposing mi_* symbols. Not yet wired into the GC allocator —
# kept as a ready fast allocator for runtime allocation paths.
set(ASTRA_MIMALLOC_SRC "${CMAKE_SOURCE_DIR}/compiler/astra/runtime/vendor/mimalloc/src/static.c")
if(EXISTS "${ASTRA_MIMALLOC_SRC}")
    set(mimalloc_obj "${ASTRA_BUILD}/obj/cc_rt_mimalloc.o")
    # MI_MALLOC_OVERRIDE interposes malloc/calloc/realloc/free/posix_memalign
    # so every runtime allocation (xmalloc/xrealloc/GC blocks) runs on
    # mimalloc's size-classed allocator. POSIX hosts only: the Win32 CRT
    # pairing (_aligned_malloc/_aligned_free) is not override-safe.
    set(ASTRA_MIMALLOC_DEFS "")
    if(NOT WIN32)
        set(ASTRA_MIMALLOC_DEFS -DMI_MALLOC_OVERRIDE=1)
    endif()
    add_custom_command(OUTPUT "${mimalloc_obj}"
        COMMAND ${CMAKE_C_COMPILER} ${ASTRA_RT_CC_FLAGS} ${ASTRA_MIMALLOC_DEFS}
                -I${CMAKE_SOURCE_DIR}/compiler/astra/runtime/vendor/mimalloc/include
                -c "${ASTRA_MIMALLOC_SRC}" -o "${mimalloc_obj}"
        DEPENDS "${ASTRA_MIMALLOC_SRC}"
        COMMENT "system runtime mimalloc"
        VERBATIM)
    list(APPEND ASTRA_RT_OBJS "${mimalloc_obj}")
endif()
set(ASTRA_RUNTIME_ARCHIVE "${ASTRA_STAGE}/libaruntime.a")
add_custom_command(OUTPUT "${ASTRA_RUNTIME_ARCHIVE}"
    COMMAND ${CMAKE_AR} rcs "${ASTRA_RUNTIME_ARCHIVE}" ${ASTRA_RT_OBJS}
    DEPENDS ${ASTRA_RT_OBJS}
    COMMENT "system C runtime libaruntime.a"
    VERBATIM)

set(ASTRA_RUNTIME_DEPS "${astra_libdir}/libastra1.a" "${astra_libdir}/runmain.o"
                      ${ASTRA_RUNTIME_STAGED_OUTPUTS})
if(ASTRA_RUNTIME_ARCHIVE)
    list(APPEND ASTRA_RUNTIME_DEPS "${ASTRA_RUNTIME_ARCHIVE}")
endif()
add_custom_target(astra_runtime ALL DEPENDS ${ASTRA_RUNTIME_DEPS})

message(STATUS "libastra: native backend (${astra_version}) for ${astra_arch}")

# ============================================================================
# Cross-architecture astra drivers
#
# Astra is a per-target compiler: one binary emits one architecture. For every
# other arch the host OS supports we build astra-<arch> (same libastra.c with a
# different ASTRA_TARGET_* define), its own libastra1-<arch>.a (per-target
# object list mirroring backend/lib/Makefile), and a self-contained staged
# dir astralib-<arch>/ (headers + runtime sources + support archive) that the
# `a` driver selects via --target. Astra binaries are bound to the host OS at
# build time, so the arch list is host-OS dependent:
#   Linux:   x86_64 i386 arm arm64 riscv64 i8086   (ELF / i8086 flat binary)
#   macOS:   x86_64 arm64                    (Mach-O)
#   Windows: x86_64 i386 arm64               (PE)
# i8086 is asm-only bare metal (no libc/sysroot). The TMS320C67x DSP target
# and other 16-bit architectures are intentionally unsupported.
# ============================================================================

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(ASTRA_ALL_ARCHES x86_64 i386 arm arm64 riscv64 i8086)
elseif(APPLE)
    set(ASTRA_ALL_ARCHES x86_64 arm64)
elseif(WIN32)
    set(ASTRA_ALL_ARCHES x86_64 i386 arm64)
endif()
list(REMOVE_ITEM ASTRA_ALL_ARCHES "${astra_arch}")

# arch -> ASTRA_TARGET_* compile defines
function(astra_arch_defines arch out_var)
    if(arch STREQUAL "x86_64")
        set(defs ASTRA_TARGET_X86_64)
    elseif(arch STREQUAL "i386")
        set(defs ASTRA_TARGET_I386)
    elseif(arch STREQUAL "arm64")
        set(defs ASTRA_TARGET_ARM64)
    elseif(arch STREQUAL "arm")
        set(defs ASTRA_TARGET_ARM ASTRA_ARM_EABI ASTRA_ARM_VFP ASTRA_ARM_HARDFLOAT)
    elseif(arch STREQUAL "riscv64")
        set(defs ASTRA_TARGET_RISCV64)
    elseif(arch STREQUAL "i8086")
        set(defs ASTRA_TARGET_I8086)
    else()
        set(defs "")
    endif()
    set(${out_var} "${defs}" PARENT_SCOPE)
endfunction()

# arch -> lib path suffixes appended to CONFIG_ASTRA_LIBPATHS (Linux only;
# macOS/Windows use the same staged-dir-only paths as the host build).
function(astra_arch_libpaths arch out_var)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    if(arch STREQUAL "i386")
        set(paths "/usr/lib/i386-linux-gnu" "/lib/i386-linux-gnu" "/usr/lib32" "/lib32")
    elseif(arch STREQUAL "arm")
        set(paths "/usr/arm-linux-gnueabihf/lib" "/lib/arm-linux-gnueabihf" "/usr/lib/arm-linux-gnueabihf")
    elseif(arch STREQUAL "arm64")
        set(paths "/usr/aarch64-linux-gnu/lib" "/lib/aarch64-linux-gnu" "/usr/lib/aarch64-linux-gnu")
    elseif(arch STREQUAL "riscv64")
        set(paths "/usr/riscv64-linux-gnu/lib" "/lib/riscv64-linux-gnu" "/usr/lib/riscv64-linux-gnu")
    else()
        set(paths "")
    endif()
    string(REPLACE ";" ":" paths_str "${paths}")
    if(paths_str)
        set(${out_var} ":${paths_str}" PARENT_SCOPE)
    else()
        set(${out_var} "" PARENT_SCOPE)
    endif()
endfunction()

# arch -> C compiler candidates for building runtime/support objects.
# Astra assembles and links only; every .c -> .o step needs a real C
# compiler for the target. A_RUNTIME_CC_<ARCH> (arch uppercased, '-' -> '_')
# overrides the search.
function(astra_find_cc arch out_var)
    if(arch STREQUAL "i8086")
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    string(TOUPPER "${arch}" arch_up)
    string(REPLACE "-" "_" arch_up "${arch_up}")
    set(env_var "A_RUNTIME_CC_${arch_up}")
    if(DEFINED ENV{${env_var}} AND NOT "$ENV{${env_var}}" STREQUAL "")
        set(${out_var} "$ENV{${env_var}}" PARENT_SCOPE)
        return()
    endif()
    set(cands "")
    if(arch STREQUAL "i386")
        set(cands "i686-linux-gnu-gcc;i386-linux-gnu-gcc;i686-linux-gnu-clang")
    elseif(arch STREQUAL "arm")
        set(cands "arm-linux-gnueabihf-gcc;arm-linux-gnueabi-gcc;arm-linux-gnueabihf-clang")
    elseif(arch STREQUAL "arm64")
        if(APPLE)
            set(cands "aarch64-apple-darwin-clang")
        else()
            set(cands "aarch64-linux-gnu-gcc;aarch64-linux-gnu-clang")
        endif()
    elseif(arch STREQUAL "riscv64")
        set(cands "riscv64-linux-gnu-gcc;riscv64-linux-gnu-clang")
    elseif(arch STREQUAL "x86_64" AND WIN32)
        set(cands "x86_64-w64-mingw32-gcc;i686-w64-mingw32-gcc")
    elseif(arch STREQUAL "i386" AND WIN32)
        set(cands "i686-w64-mingw32-gcc;x86_64-w64-mingw32-gcc")
    elseif(arch STREQUAL "arm64" AND WIN32)
        set(cands "aarch64-w64-mingw32-gcc")
    endif()
    foreach(c IN LISTS cands)
        find_program(found_${c} NAMES ${c})
        if(found_${c})
            set(${out_var} "${found_${c}}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${out_var} "" PARENT_SCOPE)
endfunction()

# Per-target libastra1.a object list (backend/lib/Makefile OBJ-<t>-<os>).
function(astra_arch_lib1_srcs arch out_var)
    if(arch STREQUAL "i8086")
        # asm-only bare-metal target: no libastra1 objects, no runmain
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    set(common lib/stdatomic.c lib/atomic.S lib/builtin.c lib/alloca.S lib/alloca-bt.S lib/tcov.c)
    if(arch STREQUAL "arm64" OR arch STREQUAL "riscv64")
        set(main lib/lib-arm64.c lib/armflush.c)
    elseif(arch STREQUAL "arm")
        set(main lib/libastra1.c lib/armeabi.c lib/armflush.c)
    else()
        set(main lib/libastra1.c)
    endif()
    if(arch STREQUAL "i386")
        list(APPEND main lib/pic86.S)
    elseif(arch STREQUAL "x86_64")
        list(APPEND main lib/va_list.c)
    endif()
    if(WIN32)
        list(APPEND main win32/lib/chkstk.S win32/lib/winex.c win32/lib/crt1.c
                       win32/lib/crt1w.c win32/lib/wincrt1.c win32/lib/wincrt1w.c
                       win32/lib/dllcrt1.c win32/lib/dllmain.c)
    elseif(NOT APPLE)
        list(APPEND main lib/dsohandle.c)
    endif()
    set(${out_var} "${main};${common}" PARENT_SCOPE)
endfunction()

set(ASTRA_ALL_DEPS "")
foreach(xarch IN LISTS ASTRA_ALL_ARCHES)
    astra_arch_defines(${xarch} xdefs)
    astra_arch_libpaths(${xarch} xlibpaths)
    astra_arch_lib1_srcs(${xarch} xlib1_srcs)

    set(XBUILD "${ASTRA_BUILD}/${xarch}")
    set(XSTAGE "${CMAKE_BINARY_DIR}/astralib-${xarch}")
    set(XLIBDIR "${XSTAGE}")
    if(WIN32)
        set(XLIBDIR "${XSTAGE}/lib")
    endif()
    file(MAKE_DIRECTORY "${XBUILD}/obj" "${XLIBDIR}")

    # config-<arch>.h: same template as the host build, arch-specific
    # target define, lib paths and (when detectable) libgcc archive.
    set(xconfig "/* Generated by cmake/libastra.cmake (cross ${xarch}). */
#define ASTRA_VERSION \"${astra_version}\"
#define CONFIG_ASTRA_PREDEFS 0
#define CONFIG_ASTRA_BACKTRACE 0
#define CONFIG_ASTRA_BCHECK 0
#define CONFIG_ASTRA_SYSINCLUDEPATHS \"{B}/include\"
#define CONFIG_ASTRA_CRTPREFIX \"{B}\"
")
    if(WIN32)
        string(APPEND xconfig "#define CONFIG_ASTRA_LIBPATHS \"{B}/lib\"\n")
    elseif(APPLE)
        string(APPEND xconfig "#define CONFIG_ASTRA_LIBPATHS \"{B}\"\n")
    else()
        string(APPEND xconfig "#define CONFIG_ASTRA_LIBPATHS \"{B}:${xlibpaths}:/usr/lib:/lib\"\n")
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND EXISTS "/sys/fs/selinux/enforce")
        string(APPEND xconfig "#define CONFIG_SELINUX 1\n")
    endif()
    # libgcc helpers (__udivdi3 etc.) for 32-bit/soft-float targets; only
    # when a matching cross toolchain is installed.
    if(NOT WIN32 AND NOT APPLE)
        if(xarch STREQUAL "i386")
            set(xgcc_cand ${CMAKE_C_COMPILER} -m32 -print-file-name=libgcc.a)
        elseif(xarch STREQUAL "arm")
            set(xgcc_cand arm-linux-gnueabihf-gcc -print-file-name=libgcc.a)
        elseif(xarch STREQUAL "arm64")
            set(xgcc_cand aarch64-linux-gnu-gcc -print-file-name=libgcc.a)
        elseif(xarch STREQUAL "riscv64")
            set(xgcc_cand riscv64-linux-gnu-gcc -print-file-name=libgcc.a)
        else()
            set(xgcc_cand "")
        endif()
        if(xgcc_cand)
            execute_process(COMMAND ${xgcc_cand}
                OUTPUT_VARIABLE xgcc_out OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE xgcc_rc ERROR_QUIET)
            if(xgcc_rc EQUAL 0 AND xgcc_out MATCHES "/libgcc\.a$")
                string(APPEND xconfig "#define ASTRA_LIBGCC \"${xgcc_out}\"\n")
            endif()
        endif()
    endif()
    file(CONFIGURE OUTPUT "${XBUILD}/config.h" CONTENT "${xconfig}" @ONLY)

    # libastra-<arch>.a + astra_driver-<arch> -> astra-<arch>
    add_library(libastra_${xarch} STATIC "${ASTRA_SRC}/libastra.c")
    target_include_directories(libastra_${xarch} PRIVATE "${XBUILD}")
    target_include_directories(libastra_${xarch} SYSTEM PRIVATE "${ASTRA_SRC}")
    configure_file("${ASTRA_SRC}/libastra.h" "${XBUILD}/api/libastra.h" COPYONLY)
    target_include_directories(libastra_${xarch} SYSTEM PUBLIC "${XBUILD}/api")
    target_compile_definitions(libastra_${xarch} PRIVATE ${xdefs} ONE_SOURCE=1)
    # Unique archive name: the host libastra also outputs libastra.a and all
    # per-arch libs share CMAKE_ARCHIVE_OUTPUT_DIRECTORY.
    set_target_properties(libastra_${xarch} PROPERTIES
        C_STANDARD 99 OUTPUT_NAME "astra-${xarch}" POSITION_INDEPENDENT_CODE ON)

    add_executable(astra_driver_${xarch} "${ASTRA_SRC}/astra.c")
    target_include_directories(astra_driver_${xarch} PRIVATE "${XBUILD}")
    target_compile_definitions(astra_driver_${xarch} PRIVATE ${xdefs} ONE_SOURCE=0)
    target_link_libraries(astra_driver_${xarch} PRIVATE libastra_${xarch})
    set_target_properties(astra_driver_${xarch} PROPERTIES
        C_STANDARD 99 OUTPUT_NAME "astra-${xarch}" RUNTIME_OUTPUT_DIRECTORY "${ASTRA_BUILD}")
    foreach(cfg IN LISTS CMAKE_CONFIGURATION_TYPES)
        string(TOUPPER "${cfg}" cfgu)
        set_target_properties(astra_driver_${xarch} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY_${cfgu} "${ASTRA_BUILD}")
    endforeach()
    foreach(t IN ITEMS libastra_${xarch} astra_driver_${xarch})
        target_compile_options(${t} PRIVATE $<IF:$<BOOL:${MSVC}>,/W0,-w>)
        if(NOT MSVC)
            target_compile_options(${t} PRIVATE -O3)
        endif()
    endforeach()
    if(NOT WIN32)
        target_link_libraries(libastra_${xarch} PUBLIC ${CMAKE_DL_LIBS} m)
    endif()

    # Stage astralib-<arch>: astra headers (+winapi), .def files on Windows,
    # and the portable runtime sources (same files as the host stage).
    file(COPY "${ASTRA_SRC}/include/" DESTINATION "${XSTAGE}/include")
    if(WIN32)
        file(COPY "${ASTRA_SRC}/win32/include/" DESTINATION "${XSTAGE}/include")
        file(GLOB xdefs_files "${ASTRA_SRC}/win32/lib/*.def")
        file(COPY ${xdefs_files} DESTINATION "${XLIBDIR}")
    endif()
    set(XSTAGED_OUTPUTS "")
    foreach(rt_file IN LISTS ASTRA_RUNTIME_SOURCES)
        get_filename_component(rt_name "${rt_file}" NAME)
        set(xstaged "${XSTAGE}/${rt_name}")
        add_custom_command(
            OUTPUT "${xstaged}"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    "${rt_file}" "${xstaged}"
            DEPENDS "${rt_file}"
            VERBATIM)
        list(APPEND XSTAGED_OUTPUTS "${xstaged}")
    endforeach()

    # libastra1-<arch>.a + libaruntime-<arch>.a + runmain.o are built by a
    # real C compiler for the target (Astra assembles/links only). Without
    # one, the astra-<arch> driver still builds but nothing can link.
    astra_find_cc(${xarch} xcc)
    if(xcc)
        message(STATUS "libastra: ${xarch} runtime objects via ${xcc}")
        set(xcc_flags -O2 -std=gnu11 -w -fno-semantic-interposition
            -I${XSTAGE} -I${ASTRA_ROOT}/runtime -I${ASTRA_ROOT}/backend/python
            -I${XSTAGE}/include -I${XBUILD} -I${ASTRA_SRC})
        if(WIN32)
            list(APPEND xcc_flags -I${XSTAGE}/include/winapi)
        endif()
        set(xobjs "")
        foreach(src IN LISTS xlib1_srcs)
            get_filename_component(obj "${src}" NAME_WE)
            set(obj "${XBUILD}/obj/cc_${obj}.o")
            add_custom_command(OUTPUT "${obj}"
                COMMAND "${xcc}" ${xcc_flags}
                        -c "${ASTRA_SRC}/${src}" -o "${obj}"
                DEPENDS "${ASTRA_SRC}/${src}"
                COMMENT "cc-${xarch} ${src}"
                VERBATIM)
            list(APPEND xobjs "${obj}")
        endforeach()
        add_custom_command(OUTPUT "${XLIBDIR}/libastra1.a"
            COMMAND ${CMAKE_AR} rcs "${XLIBDIR}/libastra1.a" ${xobjs}
            DEPENDS ${xobjs}
            COMMENT "ar-${xarch} libastra1.a"
            VERBATIM)

        # runmain.o: the astra_run() entry used by JIT/in-process runs.
        if(NOT xarch STREQUAL "i8086")
        add_custom_command(OUTPUT "${XLIBDIR}/runmain.o"
            COMMAND "${xcc}" ${xcc_flags}
                    -c "${ASTRA_SRC}/lib/runmain.c" -o "${XLIBDIR}/runmain.o"
            DEPENDS "${ASTRA_SRC}/lib/runmain.c"
            COMMENT "cc-${xarch} lib/runmain.c"
            VERBATIM)
        endif()

        # libaruntime-<arch>.a: the A runtime modules, once per target.
        set(xrt_objs "")
        foreach(rt_file IN LISTS ASTRA_RUNTIME_SOURCES)
            if(NOT rt_file MATCHES "\\.c$")
                continue()
            endif()
            get_filename_component(rt_name "${rt_file}" NAME)
            set(rt_obj "${XBUILD}/obj/cc_rt_${rt_name}.o")
            add_custom_command(OUTPUT "${rt_obj}"
                COMMAND "${xcc}" ${xcc_flags}
                        -c "${rt_file}" -o "${rt_obj}"
                DEPENDS "${rt_file}"
                COMMENT "cc-${xarch} runtime ${rt_name}"
                VERBATIM)
            list(APPEND xrt_objs "${rt_obj}")
        endforeach()
        add_custom_command(OUTPUT "${XSTAGE}/libaruntime.a"
            COMMAND ${CMAKE_AR} rcs "${XSTAGE}/libaruntime.a" ${xrt_objs}
            DEPENDS ${xrt_objs}
            COMMENT "ar-${xarch} libaruntime.a"
            VERBATIM)
        set(XDEPS "${XLIBDIR}/libastra1.a" ${XSTAGED_OUTPUTS}
                  "${XSTAGE}/libaruntime.a")
        if(NOT xarch STREQUAL "i8086")
            list(APPEND XDEPS "${XLIBDIR}/runmain.o")
        endif()
    else()
        if(NOT xarch STREQUAL "i8086")
            message(WARNING
                "libastra: no C compiler found for ${xarch}; install a "
                "cross toolchain (<arch>-gcc) or set A_RUNTIME_CC_${xarch} "
                "— 'a build --target ${xarch}' will fail at link time")
        endif()
        set(XDEPS ${XSTAGED_OUTPUTS})
    endif()
    add_custom_target(astra_runtime_${xarch} ALL DEPENDS ${XDEPS})
    list(APPEND ASTRA_ALL_DEPS astra_runtime_${xarch})
    message(STATUS "libastra: cross backend for ${xarch}")
endforeach()
