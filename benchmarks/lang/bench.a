# Cross-language benchmark, A side. Run: ./build/a run benchmarks/lang/bench.a
import std:time

fn fib(n: i64) -> i64:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fn main():
    N = 20000000

    best = 1000000000000
    r = 0
    while r < 3:
        t0 = time.now()
        s = 0
        i = 0
        while i < N:
            s = (s * 31 + i) % 1000000007
            i = i + 1
        t1 = time.now()
        if t1 - t0 < best:
            best = t1 - t0
        r = r + 1
    print("int_loop " + str(best))

    best = 1000000000000
    r = 0
    while r < 3:
        t0 = time.now()
        x = 1.0
        i = 0
        while i < N:
            x = x * 1.000001 + 0.5
            i = i + 1
        t1 = time.now()
        if t1 - t0 < best:
            best = t1 - t0
        r = r + 1
    print("float_loop " + str(best))

    best = 1000000000000
    r = 0
    while r < 3:
        t0 = time.now()
        v = fib(30)
        if v < 0:
            print("unreachable")
        t1 = time.now()
        if t1 - t0 < best:
            best = t1 - t0
        r = r + 1
    print("fib30 " + str(best))

    S = 500000
    best = 1000000000000
    r = 0
    while r < 3:
        xs = []
        xsort = 12345
        i = 0
        while i < S:
            xsort = (xsort * 1103515245 + 12345) % 2147483648
            xs.append(xsort)
            i = i + 1
        t0 = time.now()
        xs.sort()
        t1 = time.now()
        if t1 - t0 < best:
            best = t1 - t0
        r = r + 1
    print("sort500k " + str(best))

    K = 500000
    best = 1000000000000
    r = 0
    while r < 3:
        m = {}
        xk = 999
        t0 = time.now()
        i = 0
        while i < K:
            xk = (xk * 1103515245 + 12345) % 2147483648
            m[xk % 1000000] = i
            i = i + 1
        acc = 0
        i = 0
        while i < K:
            xk = (xk * 1103515245 + 12345) % 2147483648
            hit = m.get(xk % 1000000)
            if hit != None:
                acc = acc + hit
            i = i + 1
        t1 = time.now()
        if t1 - t0 < best:
            best = t1 - t0
        r = r + 1
    print("dict500k " + str(best))

    M = 200000
    best = 1000000000000
    r = 0
    while r < 3:
        t0 = time.now()
        parts = []
        i = 0
        while i < M:
            parts.append("item" + str(i))
            i = i + 1
        out = join(parts, ",")
        if len(out) < 0:
            print("unreachable")
        t1 = time.now()
        if t1 - t0 < best:
            best = t1 - t0
        r = r + 1
    print("str200k " + str(best))
