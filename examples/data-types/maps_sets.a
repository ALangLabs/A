# Maps and sets
m = {"a": 1, "b": 2}
m["c"] = 3
print(m)
print(m["a"], m.get("c"), m.get("missing", 99))
print("a" in m, m.contains("b"))
print(m.keys())
print(m.values())
print(m.items())

m.update({"a": 10, "d": 4})
print(m.pop("b"))
print(m.copy())

s = {3, 1, 2, 2}
s.add(5)
s.discard(99)
print(s)
print(2 in s, s.contains(9))
print(s.union({1, 7}))
print(s.intersection({1, 3}))
print(s.difference({1}))

empty_map = {}
empty_set = set()
print(empty_map, empty_set)
