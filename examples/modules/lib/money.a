symbol = "$"

struct Money:
    cents

    fn format(self):
        whole = self.cents / 100
        part = self.cents % 100
        if part < 10:
            return symbol + str(whole) + ".0" + str(part)
        return symbol + str(whole) + "." + str(part)

fn of(dollars, cents):
    return Money(dollars * 100 + cents)
