# match patterns: literals, ranges, guards, wildcards
fn describe(code):
    return match code:
        200 => "OK"
        201 => "Created"
        400..499 => "Client error"
        500..599 => "Server error"
        _ => "Unknown"

print(describe(200), describe(404), describe(503), describe(302))

fn classify(n):
    return match n:
        0 => "zero"
        _ if n < 0 => "negative"
        _ if n > 100 => "large"
        _ => "small"

print(classify(0), classify(-7), classify(999), classify(5))
