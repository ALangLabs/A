#
# The language now has `comptime` parameters (parsed; call-site specialization
# is tracked in TODO.md) and real traits. This module keeps the runtime helpers
# that remain useful: value tags for dispatch and constant-range builders.
import prelude
import core
import json

fn comptime_version() -> str:
    return "0.0.1"

fn type_tag(x) -> str:
    # Runtime tag used for dispatch; mirrors what a `where` bound checks.
    kind = json.kind(x)
    if kind == "number":
        if "." in str(x):
            return "float"
        return "int"
    return kind

fn is_int(x) -> bool:
    return type_tag(x) == "int"

fn is_float(x) -> bool:
    return type_tag(x) == "float"

fn is_string(x) -> bool:
    return type_tag(x) == "string"

fn is_array(x) -> bool:
    return type_tag(x) == "array"

fn repeat_const(n: i64, x: i64) -> [i64]:
    # `@unroll`-style constant repetition; folds once specialization lands.
    out = []
    i = 0
    while i < n:
        out.append(x)
        i = i + 1
    return out

fn const_range(lo: i64, hi: i64) -> [i64]:
    # `vectorize` over a constant range: the `where 0 <= lo < hi` bound.
    if hi < lo:
        core.panic("const_range: hi < lo")
    return [n for n in lo..hi + 1]
