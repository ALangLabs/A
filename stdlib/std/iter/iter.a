# Iterator helpers (Mojo `std/iter` analog).
#
# Typed combinators over A lists and ranges. Constraints that Mojo expresses
# with `where` (non-zero step, equal lengths) are checked at runtime here
# because call-site trait enforcement for generic parameters is still TODO.
import core

fn repeat<T>(n: i64, x: T) -> [T]:
    out = []
    i = 0
    while i < n:
        out.append(x)
        i = i + 1
    return out

fn range_step(lo: i64, hi: i64, step: i64) -> [i64]:
    if step == 0:
        core.panic("range_step: step is 0")
    out = []
    n = lo
    while (step > 0) == (n < hi):
        out.append(n)
        n = n + step
    return out

fn zip_apply<T>(f: fn(T, T) -> T, a: [T], b: [T]) -> [T]:
    if len(a) != len(b):
        core.panic("zip_apply: lengths differ")
    out = []
    i = 0
    while i < len(a):
        out.append(f(a[i], b[i]))
        i = i + 1
    return out

fn take<T>(n: i64, xs: [T]) -> [T]:
    out = []
    i = 0
    while i < n and i < len(xs):
        out.append(xs[i])
        i = i + 1
    return out

fn enumerate_pairs(xs: [i64]) -> [[i64]]:
    out = []
    i = 0
    while i < len(xs):
        out.append([i, xs[i]])
        i = i + 1
    return out
