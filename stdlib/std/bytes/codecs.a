# std.bytes.codecs — easy encode/decode API with encoding-name dispatch.
#
# Syntax (Python-like, easy):
#   from std:bytes import encode, decode
#   b = encode("héllo", "utf-8")          # -> Bytes
#   s = decode(b, "utf-8")                 # -> String
#   s = decode(b, "utf-8", "replace")      # error handling
#
# Supported encodings (names normalized like Python: case-insensitive, -/_ ignored):
#   utf-8, utf8, u8, utf
#   utf-8-sig (BOM on encode; strips BOM on decode)
#   ascii, us-ascii, 646
#   latin-1, latin1, iso-8859-1, iso8859-1, 8859, cp819, latin, l1
#   utf-16, utf16 (BOM-aware; encode emits UTF-16LE BOM)
#   utf-16-le, utf-16le, utf16le
#   utf-16-be, utf-16be, utf16be
#   utf-32, utf32 (BOM-aware; encode emits UTF-32LE BOM)
#   utf-32-le, utf-32le, utf32le
#   utf-32-be, utf-32be, utf32be
import std:core
from "common.a" import _norm_encoding, _check_errors
from "utf8.a" import utf8_encode, utf8_decode, utf8_encode_errors, utf8_decode_errors
from "latin1.a" import latin1_encode, latin1_decode, ascii_encode, ascii_decode
from "utf16.a" import utf16_encode, utf16_decode, utf16le_encode, utf16le_decode, utf16be_encode, utf16be_decode
from "utf32.a" import utf32_encode, utf32_decode, utf32le_encode, utf32le_decode, utf32be_encode, utf32be_decode

"""_utf8sig_encode(s, errors) -> [i64]"""
fn _utf8sig_encode(s: String, errors: String):
    out = [239, 187, 191]
    rest = utf8_encode_errors(s, errors)
    for b in rest:
        out.append(b)
    return out

"""_utf8sig_decode(bytes, errors) -> String"""
fn _utf8sig_decode(bytes, errors: String):
    n = len(bytes)
    if n >= 3 and bytes[0] == 239 and bytes[1] == 187 and bytes[2] == 191:
        rest = []
        i = 3
        while i < n:
            rest.append(bytes[i])
            i = i + 1
        return utf8_decode_errors(rest, errors)
    return utf8_decode_errors(bytes, errors)

"""_as_byte_list(data) -> indexable/iterable bytes"""
fn _as_byte_list(data):
    if type(data) == "Bytes":
        return data
    return data

"""encode(text, encoding, errors) -> Bytes. encoding defaults to utf-8, errors to strict."""
fn encode(text: String, encoding = "utf-8", errors = "strict"):
    _check_errors(errors)
    enc = _norm_encoding(encoding)
    out = []
    if enc == "utf8" or enc == "u8" or enc == "utf":
        out = utf8_encode_errors(text, errors)
    elif enc == "utf8sig":
        out = _utf8sig_encode(text, errors)
    elif enc == "ascii" or enc == "usascii" or enc == "646":
        out = ascii_encode(text, errors)
    elif enc == "latin1" or enc == "iso88591" or enc == "8859" or enc == "cp819" or enc == "latin" or enc == "l1":
        out = latin1_encode(text, errors)
    elif enc == "utf16" or enc == "utf16le" or enc == "ucs2" or enc == "ucs2le":
        # "utf-16" (no LE/BE suffix) in our API: emit BOM + LE (common). utf16le explicit: no BOM.
        if enc == "utf16":
            out = utf16_encode(text, errors)
        else:
            out = utf16le_encode(text, errors)
    elif enc == "utf16be" or enc == "ucs2be":
        out = utf16be_encode(text, errors)
    elif enc == "utf32" or enc == "utf32le" or enc == "ucs4" or enc == "ucs4le":
        if enc == "utf32":
            out = utf32_encode(text, errors)
        else:
            out = utf32le_encode(text, errors)
    elif enc == "utf32be" or enc == "ucs4be":
        out = utf32be_encode(text, errors)
    else:
        core.panic("bytes.encode: unsupported encoding '" + encoding + "' (normalized '" + enc + "'). Supported: utf-8, utf-8-sig, ascii, latin-1/iso-8859-1, utf-16/le/be, utf-32/le/be")
    return Bytes(out)

"""encode_list(text, encoding, errors) -> [i64] (compat/list form)."""
fn encode_list(text: String, encoding = "utf-8", errors = "strict"):
    b = encode(text, encoding, errors)
    return list(b)

"""decode(data, encoding, errors) -> String."""
fn decode(data, encoding = "utf-8", errors = "strict"):
    _check_errors(errors)
    enc = _norm_encoding(encoding)
    b = data
    if enc == "utf8" or enc == "u8" or enc == "utf":
        return utf8_decode_errors(b, errors)
    elif enc == "utf8sig":
        return _utf8sig_decode(b, errors)
    elif enc == "ascii" or enc == "usascii" or enc == "646":
        return ascii_decode(b, errors)
    elif enc == "latin1" or enc == "iso88591" or enc == "8859" or enc == "cp819" or enc == "latin" or enc == "l1":
        return latin1_decode(b, errors)
    elif enc == "utf16" or enc == "ucs2":
        return utf16_decode(b, errors)
    elif enc == "utf16le" or enc == "ucs2le":
        return utf16le_decode(b, errors)
    elif enc == "utf16be" or enc == "ucs2be":
        return utf16be_decode(b, errors)
    elif enc == "utf32" or enc == "ucs4":
        return utf32_decode(b, errors)
    elif enc == "utf32le" or enc == "ucs4le":
        return utf32le_decode(b, errors)
    elif enc == "utf32be" or enc == "ucs4be":
        return utf32be_decode(b, errors)
    else:
        core.panic("bytes.decode: unsupported encoding '" + encoding + "' (normalized '" + enc + "'). Supported: utf-8, utf-8-sig, ascii, latin-1/iso-8859-1, utf-16/le/be, utf-32/le/be")
    return ""

"""supported_encodings() -> [String] list of primary supported encoding names."""
fn supported_encodings():
    return ["utf-8", "utf-8-sig", "ascii", "latin-1", "iso-8859-1", "utf-16", "utf-16-le", "utf-16-be", "utf-32", "utf-32-le", "utf-32-be"]
