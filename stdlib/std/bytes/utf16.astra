# std.bytes.utf16 — UTF-16 codecs (LE/BE and BOM-aware).
import std:core
from "common.astra" import chr, ord, _check_errors, _is_strict, _is_replace, _is_ignore

"""_u16_enc_le(cp, out)"""
fn _u16_enc_le(cp, out):
    if cp <= 65535:
        if cp >= 55296 and cp <= 57343:
            core.panic("utf-16: surrogate code point cannot be encoded")
        out.append(cp % 256)
        out.append(cp / 256)
    else:
        v = cp - 65536
        hi = 55296 + v / 1024
        lo = 56320 + v % 1024
        out.append(hi % 256)
        out.append(hi / 256)
        out.append(lo % 256)
        out.append(lo / 256)

"""_u16_enc_be(cp, out)"""
fn _u16_enc_be(cp, out):
    if cp <= 65535:
        if cp >= 55296 and cp <= 57343:
            core.panic("utf-16: surrogate code point cannot be encoded")
        out.append(cp / 256)
        out.append(cp % 256)
    else:
        v = cp - 65536
        hi = 55296 + v / 1024
        lo = 56320 + v % 1024
        out.append(hi / 256)
        out.append(hi % 256)
        out.append(lo / 256)
        out.append(lo % 256)

"""utf16le_encode(s, errors) -> [i64]"""
fn utf16le_encode(s: String, errors: String):
    _check_errors(errors)
    out = []
    for c in s.chars():
        cp = ord(c)!
        _u16_enc_le(cp, out)
    return out

"""utf16be_encode(s, errors) -> [i64]"""
fn utf16be_encode(s: String, errors: String):
    _check_errors(errors)
    out = []
    for c in s.chars():
        cp = ord(c)!
        _u16_enc_be(cp, out)
    return out

"""utf16_encode(s, errors) -> [i64] (BOM + UTF-16LE, Python default on little-endian is common; we emit LE BOM)."""
fn utf16_encode(s: String, errors: String):
    _check_errors(errors)
    out = [255, 254]  # BOM LE
    for c in s.chars():
        cp = ord(c)!
        _u16_enc_le(cp, out)
    return out

"""_u16_dec(bytes, le: bool, errors) -> String"""
fn _u16_dec(bytes, le, errors):
    _check_errors(errors)
    parts = []
    i = 0
    n = len(bytes)
    while i + 1 < n:
        b0 = bytes[i]
        b1 = bytes[i + 1]
        u = 0
        if le:
            u = b0 + b1 * 256
        else:
            u = b0 * 256 + b1
        i = i + 2
        if u >= 55296 and u <= 56319:
            # high surrogate
            if i + 1 >= n:
                if _is_ignore(errors):
                    continue
                if _is_replace(errors):
                    parts.append("�")
                    continue
                core.panic("utf-16: truncated surrogate pair (strict)")
            b2 = bytes[i]
            b3 = bytes[i + 1]
            lo = 0
            if le:
                lo = b2 + b3 * 256
            else:
                lo = b2 * 256 + b3
            i = i + 2
            if lo < 56320 or lo > 57343:
                if _is_ignore(errors):
                    i = i - 2
                    continue
                if _is_replace(errors):
                    parts.append("�")
                    i = i - 2
                    continue
                core.panic("utf-16: invalid surrogate pair (strict)")
            cp = 65536 + (u - 55296) * 1024 + (lo - 56320)
            c = chr(cp)
            parts.append(c ?? "�")
        elif u >= 56320 and u <= 57343:
            if _is_ignore(errors):
                continue
            if _is_replace(errors):
                parts.append("�")
                continue
            core.panic("utf-16: lone low surrogate (strict)")
        else:
            c = chr(u)
            parts.append(c ?? "�")
    if i < n:
        # odd trailing byte
        if _is_ignore(errors):
            pass
        elif _is_replace(errors):
            parts.append("�")
        else:
            core.panic("utf-16: truncated data (strict)")
    return join(parts, "")

"""utf16le_decode(bytes, errors) -> String"""
fn utf16le_decode(bytes, errors: String):
    return _u16_dec(bytes, true, errors)

"""utf16be_decode(bytes, errors) -> String"""
fn utf16be_decode(bytes, errors: String):
    return _u16_dec(bytes, false, errors)

"""utf16_decode(bytes, errors) -> String (BOM-aware, defaults to UTF-16LE if no BOM, like Python? Python uses native; we'll default to LE)."""
fn utf16_decode(bytes, errors: String):
    _check_errors(errors)
    n = len(bytes)
    if n >= 2:
        b0 = bytes[0]
        b1 = bytes[1]
        if b0 == 255 and b1 == 254:
            # LE BOM
            rest = []
            i = 2
            while i < n:
                rest.append(bytes[i])
                i = i + 1
            return _u16_dec(rest, true, errors)
        if b0 == 254 and b1 == 255:
            rest = []
            i = 2
            while i < n:
                rest.append(bytes[i])
                i = i + 1
            return _u16_dec(rest, false, errors)
    return _u16_dec(bytes, true, errors)
