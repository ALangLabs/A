# std.bytes selftest — codepoint helpers and the native UTF-8 conversions.
# Run: ./build/a test stdlib/std/bytes/selftest.astra
import std:core
from "bytes.astra" import utf8_decode, utf8_encode, b2s, s2b, s2b_fast, chr, ord

fn assert_eq(a, b):
    assert(a == b)

fn test_utf8_encode_ascii_and_multibyte():
    assert_eq(utf8_encode("hi"), [104, 105])
    assert_eq(utf8_encode("é"), [195, 169])
    assert_eq(utf8_encode("€"), [226, 130, 172])
    assert_eq(utf8_encode("😀"), [240, 159, 152, 128])
    assert_eq(utf8_encode(""), [])

fn test_utf8_decode_roundtrip():
    for s in ["", "hi", "é", "€", "aé€😀z"]:
        b = utf8_encode(s)
        d = utf8_decode(b)
        assert(d != None)
        assert_eq(d!, s)

fn test_utf8_decode_rejects_bad():
    # lone continuation byte, truncated sequence, overlong NUL, surrogate
    assert_eq(utf8_decode([128]) == None, true)
    assert_eq(utf8_decode([195]) == None, true)
    assert_eq(utf8_decode([226, 130]) == None, true)
    assert_eq(utf8_decode([192, 128]) == None, true)
    assert_eq(utf8_decode([237, 160, 128]) == None, true)
    # bytes outside 0..255 are not bytes at all
    assert_eq(utf8_decode([256]) == None, true)
    assert_eq(utf8_decode([-1]) == None, true)

fn test_utf8_decode_keeps_ascii_runs():
    # 1 MiB of ASCII must decode exactly (and quickly: single native pass)
    src = []
    i = 0
    while i < 1048576:
        src.append(65)
        i = i + 1
    d = utf8_decode(src)
    assert(d != None)
    assert_eq(len(d!), 1048576)

fn test_b2s_and_s2b():
    assert_eq(b2s([104, 105]), "hi")
    assert_eq(b2s([233]), "é")
    assert_eq(b2s([]), "")
    assert_eq(s2b("hi"), [104, 105])
    assert_eq(s2b("é"), [233])
    assert_eq(s2b_fast("é"), [195, 169])

fn test_ord_chr():
    assert_eq(ord("A")!, 65)
    assert_eq(ord("é")!, 233)
    assert_eq(chr(65)!, "A")
    assert_eq(chr(233)!, "é")
    assert_eq(len(utf8_encode(chr(128512)!)), 4)

fn test_b2s_after_decode():
    # view-free: the decoded string is independent of the source list
    src = [104, 105]
    s = utf8_decode(src)!
    src[0] = 74
    assert_eq(s, "hi")

fn test_bytes_value_basics():
    # Bytes is a first-class buffer: len/index/store/iteration/slice/equality
    b: Bytes = Bytes("hey")
    assert_eq(len(b), 3)
    assert_eq(b[0], 104)
    assert_eq(type(b), "Bytes")
    b[0] = 72
    assert_eq(core.bytes_to_str(b)!, "Hey")
    assert_eq(b[0..2], Bytes("He"))
    assert_eq(list(b), [72, 101, 121])
    total = 0
    for c in b:
        total = total + c
    assert_eq(total, 72 + 101 + 121)
    assert_eq(Bytes([1, 2, 3]) == Bytes([1, 2, 3]), true)
    assert_eq(Bytes([1, 2, 3]) == Bytes([1, 2]), false)
    # Bytes + Bytes concatenates
    assert_eq(len(Bytes("ab") + Bytes("cd")), 4)

fn test_bytes_binary_roundtrip():
    # Payloads that are not UTF-8 stay exact: no decode, no replacement chars.
    raw: Bytes = Bytes(3)
    raw[0] = 255
    raw[1] = 0
    raw[2] = 128
    assert_eq(len(raw), 3)
    assert_eq(core.bytes_to_str(raw) == None, true)
    assert_eq(repr(raw).contains("xff"), true)
    assert_eq(repr(raw).contains("x00"), true)
    # append accepts Bytes, String, [i64] and a single byte
    acc: Bytes = Bytes(0)
    core.bytes_append(acc, raw)
    core.bytes_append(acc, "ab")
    core.bytes_append(acc, [67])
    core.bytes_append(acc, 68)
    assert_eq(len(acc), 7)
    assert_eq(acc[3], 97)  # "ab" starts right after the three raw bytes
    assert_eq(acc[4], 98)
    assert_eq(acc[6], 68)
    # a copy is independent of the source
    copy: Bytes = Bytes(raw)
    raw[0] = 1
    assert_eq(copy[0], 255)

fn test_bytes_large_buffer():
    # 1 MiB: one allocation, index stores are O(1), decode is one native pass
    big: Bytes = Bytes(1048576)
    i = 0
    while i < 1048576:
        big[i] = 97
        i = i + 1
    assert_eq(len(big), 1048576)
    assert_eq(len(core.bytes_to_str(big)!), 1048576)
    assert_eq(len(utf8_decode(big)!), 1048576)

fn main():
    test_utf8_encode_ascii_and_multibyte()
    test_utf8_decode_roundtrip()
    test_utf8_decode_rejects_bad()
    test_utf8_decode_keeps_ascii_runs()
    test_b2s_and_s2b()
    test_ord_chr()
    test_b2s_after_decode()
    test_bytes_value_basics()
    test_bytes_binary_roundtrip()
    test_bytes_large_buffer()
    print("stdio.bytes selftest: all tests passed")
