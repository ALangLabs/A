# This package is backed by the native module `json` implemented in the
# toolchain (see compiler/astra/frontend/name-resolution/native_modules.hpp).
# `import json` / `import std:json` resolves to the native implementation
# (parse/stringify/pretty/is_valid/get/at/len/has/keys/kind/as_*/set/delete).
#
# Python-style `dumps`/`loads` (with indent/sort_keys/separators) live in
# dumps.a — they cannot be re-exported from this file because `import json`
# inside the package __init__ would self-import. Import them via:
#
#   from "std/json/dumps.a" import dumps, loads
