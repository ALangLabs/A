# std.json selftest — dumps/loads (pure-A layer over the native module).
# Run: ./build/a test stdlib/std/json/selftest.astra
from "std/json/dumps.astra" import dumps, loads
import std:json

fn assert_eq(a, b):
    assert(a == b)

fn test_dumps_scalars():
    assert_eq(dumps(42), "42")
    assert_eq(dumps(-7), "-7")
    assert_eq(dumps(1.5), "1.5")
    assert_eq(dumps(true), "true")
    assert_eq(dumps(false), "false")
    assert_eq(dumps(None), "null")
    assert_eq(dumps("hi"), "\"hi\"")

fn test_dumps_string_escapes():
    assert_eq(dumps("a\"b"), "\"a\\\"b\"")
    assert_eq(dumps("a\\b"), "\"a\\\\b\"")
    assert_eq(dumps("a\nb"), "\"a\\nb\"")
    assert_eq(dumps("tab\there"), "\"tab\\there\"")

fn test_dumps_containers():
    assert_eq(dumps([1, 2, 3]), "[1, 2, 3]")
    assert_eq(dumps([]), "[]")
    assert_eq(dumps({"a": 1}), "\{\"a\": 1\}")
    assert_eq(dumps({}), "\{\}")
    # heterogeneous structures come from loads() (Json is dynamically typed)
    nested = loads("\{\"x\": [1, \{\"y\": true\}]\}")
    assert_eq(dumps(nested), "\{\"x\": [1, \{\"y\": true\}]\}")

fn test_dumps_sort_keys():
    m = {"b": 1, "a": 2, "c": 3}
    assert_eq(dumps(m, -1, true), "\{\"a\": 2, \"b\": 1, \"c\": 3\}")
    assert_eq(dumps(m), "\{\"b\": 1, \"a\": 2, \"c\": 3\}")

fn test_dumps_indent():
    m = loads("\{\"a\": 1, \"b\": [2, 3]\}")
    out = dumps(m, 2)
    # Python json.dumps(m, indent=2):
    # {
    #   "a": 1,
    #   "b": [
    #     2,
    #     3
    #   ]
    # }
    assert_eq(out, "\{\n  \"a\": 1,\n  \"b\": [\n    2,\n    3\n  ]\n\}")

fn test_dumps_separators():
    m = {"a": 1, "b": 2}
    assert_eq(dumps(m, -1, false, ["|", "="]), "\{\"a\"=1|\"b\"=2\}")

fn test_dumps_ensure_ascii():
    # default (Python parity): non-ASCII escaped as \uXXXX
    assert_eq(dumps("h\u{e9}llo"), "\"h\\u00e9llo\"")
    assert_eq(dumps("\u{65e5}\u{672c}"), "\"\\u65e5\\u672c\"")
    # ensure_ascii = false: raw UTF-8 passthrough
    assert_eq(dumps("h\u{e9}llo", -1, false, None, false), "\"héllo\"")
    # astral char -> UTF-16 surrogate pair (U+1F600 -> D83D DE00)
    assert_eq(dumps("\u{1f600}"), "\"\\ud83d\\ude00\"")
    # ASCII unaffected either way
    assert_eq(dumps("abc", -1, false, None, false), "\"abc\"")

fn test_loads_roundtrip():
    text = "\{\"a\": [1, 2, \{\"b\": null\}], \"c\": \"x\\ny\"\}"
    v = loads(text)
    kind = json.kind(v)
    assert_eq(kind, "object")
    assert_eq(json.len(v), 2)
    arr = json.get(v, "a")!
    assert_eq(json.len(arr), 3)
    inner = json.at(arr, 2)!
    assert_eq(json.get(inner, "b")!, None)
    assert_eq(json.get(v, "c")!, "x\ny")
    # dumps(loads(x)) stability for simple values
    assert_eq(loads(dumps([1, 2, 3])), [1, 2, 3])
    mixed = []
    mixed.append(1)
    mixed.append("a")
    mixed.append(true)
    vm = loads(dumps(mixed))
    assert_eq(json.at(vm, 0)!, 1)
    assert_eq(json.at(vm, 1)!, "a")
    assert_eq(json.at(vm, 2)!, true)

test_dumps_scalars()
test_dumps_string_escapes()
test_dumps_containers()
test_dumps_sort_keys()
test_dumps_indent()
test_dumps_separators()
test_dumps_ensure_ascii()
test_loads_roundtrip()
print("json selftest ok")
