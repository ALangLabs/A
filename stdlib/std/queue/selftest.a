# std.queue selftest — run: ./build/a test stdlib/std/queue/selftest.a
from "std/queue/__init__.a" import queue_new, Queue, lifo_queue_new, priority_queue_new

fn assert_eq(a, b):
    assert(a == b)

fn assert_true(c):
    assert(c)

fn test_fifo():
    q = queue_new()
    assert_true(q.empty())
    q.put(1)
    q.put(2)
    q.put(3)
    assert_eq(q.qsize(), 3)
    assert_eq(q.get(), 1)
    assert_eq(q.get(), 2)
    assert_eq(q.peek(), 3)
    assert_eq(q.try_get(), 3)
    assert_eq(q.try_get(), None)

fn test_bounded():
    q = queue_new(2)
    assert_true(q.try_put("a"))
    assert_true(q.try_put("b"))
    assert_eq(q.try_put("c"), false)
    assert_eq(q.qsize(), 2)
    q.get()
    assert_true(q.try_put("c"))
    assert_eq(q.to_list(), ["b", "c"])

fn test_task_done_join():
    q = queue_new()
    q.put("job")
    q.put("job2")
    q.task_done()
    q.get()
    q.task_done()
    q.get()
    q.join()  # returns immediately once unfinished == 0

fn test_unfinished():
    q = queue_new()
    q.put(1)
    q.try_get()
    # unfinished stays 1 until task_done (Python semantics)
    q.task_done()
    q.join()

fn test_generic():
    q = Queue([1.5], 0, 0)
    q.put(2.5)
    assert_eq(q.get(), 1.5)
    assert_eq(q.get(), 2.5)

test_fifo()
test_bounded()
test_task_done_join()
test_unfinished()
test_generic()
print("queue selftest ok")

fn test_lifo_queue():
    q = lifo_queue_new()
    assert_eq(q.qsize(), 0)
    q.put("first")
    q.put("second")
    q.put("third")
    assert_eq(q.qsize(), 3)
    assert_eq(q.peek(), "third")
    assert_eq(q.get(), "third")
    assert_eq(q.get(), "second")
    assert_eq(q.try_get(), "first")
    assert(q.try_get() == None)
    q.task_done()
    q.task_done()
    q.task_done()

fn test_priority_queue():
    q = priority_queue_new()
    q.put_prio(5.0, "five")
    q.put_prio(1.0, "one")
    q.put_prio(3.0, "three")
    # equal priorities -> FIFO
    q.put_prio(1.0, "one_b")
    assert_eq(q.qsize(), 4)
    assert_eq(q.peek(), "one")
    assert_eq(q.get(), "one")
    assert_eq(q.get(), "one_b")
    assert_eq(q.get(), "three")
    assert_eq(q.get(), "five")
    assert(q.try_get() == None)
    q.task_done()
    q.task_done()
    q.task_done()
    q.task_done()
    # bounded
    b = priority_queue_new(2)
    b.put_prio(1.0, "x")
    b.put_prio(2.0, "y")
    assert(not b.try_put_prio(3.0, "z"))
    assert_eq(b.qsize(), 2)
