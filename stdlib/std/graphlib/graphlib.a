# graphlib — port of Python 3.14 Lib/graphlib.py.
#
# TopologicalSorter: functionality to topologically sort a graph of
# hashable nodes.
#
# Semantic mapping notes (see docs/standard-library/python-porting.md):
#  - Python raises ValueError/CycleError; here contract violations are
#    runtime errors via panic() (the sorter's state is unusable after a
#    cyclic prepare(), unlike Python where get_ready() still works).
#  - get_ready() returns a tuple in Python; here a materialized [T].
#  - static_order() returns a generator in Python; here a [T] list.
#  - __bool__ has no A equivalent; use is_active().
#  - add(node, *predecessors) -> add(node, predecessors) taking an array;
#    done(*nodes) -> done(nodes) taking an array.
#  - TopologicalSorter(graph=None) has no optional ctor args in A; use
#    TopologicalSorter_new() for an empty sorter and
#    TopologicalSorter_from(graph) where graph is a {node: [predecessors]}
#    map (the A analog of Python's dict-of-iterables).
#
# Node status values stored in _NodeInfo.npredecessors (Python uses
# _NODE_OUT = -1 and _NODE_DONE = -2).

_NODE_OUT = -1
_NODE_DONE = -2

class _NodeInfo:
    node
    npredecessors
    successors

class TopologicalSorter:
    node2info
    ready_nodes
    prepared
    npassedout
    nfinished

    fn _get_nodeinfo(self, node):
        if node in self.node2info:
            return self.node2info[node]
        info = _NodeInfo(node, 0, [])
        self.node2info[node] = info
        return info

    fn add(self, node, predecessors):
        """Add a new node and its predecessors to the graph.

        `predecessors` is an array of nodes. Adding the same node twice
        unions the dependency sets. Nodes mentioned only as predecessors
        are added automatically with no predecessors of their own.
        Panics if called after prepare()."""
        if self.prepared:
            panic("Nodes cannot be added after a call to prepare()")
        nodeinfo = self._get_nodeinfo(node)
        nodeinfo.npredecessors += len(predecessors)
        for pred in predecessors:
            pred_info = self._get_nodeinfo(pred)
            pred_info.successors.append(node)

    fn add_node(self, node):
        """Convenience: add a node with no predecessors."""
        self.add(node, [])

    fn prepare(self):
        """Mark the graph as finished and check for cycles.

        Panics if a cycle exists (Python raises CycleError) or if nodes
        have already been passed out via get_ready()."""
        if self.npassedout > 0:
            panic("cannot prepare() after starting sort")
        if not self.prepared:
            self.ready_nodes = []
            for node in self.node2info:
                info = self.node2info[node]
                if info.npredecessors == 0:
                    self.ready_nodes.append(node)
            self.prepared = true
        # ready_nodes is set before the cycle check on purpose: in Python
        # a caught CycleError still lets the user drain get_ready(). Here a
        # cycle is a hard runtime error instead.
        cycle = self._find_cycle()
        if len(cycle) > 0:
            panic("nodes are in a cycle")

    fn get_ready(self):
        """Return all nodes that are ready as an array.

        Initially returns all nodes with no predecessors; after done() is
        called on them, later calls return newly unblocked nodes. Returns
        [] once no more progress can be made. Panics if prepare() was not
        called first."""
        if not self.prepared:
            panic("prepare() must be called first")
        result = self.ready_nodes
        self.ready_nodes = []
        for node in result:
            self.node2info[node].npredecessors = _NODE_OUT
        self.npassedout += len(result)
        return result

    fn is_active(self):
        """True if more progress can be made (Python __bool__ equivalent)."""
        if not self.prepared:
            panic("prepare() must be called first")
        return self.nfinished < self.npassedout or len(self.ready_nodes) > 0

    fn done(self, nodes):
        """Mark a set of nodes returned by get_ready() as processed.

        `nodes` is an array (typically a previous get_ready() result).
        Panics on unknown nodes, nodes not yet returned by get_ready(),
        or nodes already marked done."""
        if not self.prepared:
            panic("prepare() must be called first")
        for node in nodes:
            if node not in self.node2info:
                panic("node was not added using add()")
            nodeinfo = self.node2info[node]
            stat = nodeinfo.npredecessors
            if stat != _NODE_OUT:
                if stat >= 0:
                    panic("node was not passed out (still not ready)")
                elif stat == _NODE_DONE:
                    panic("node was already marked done")
                else:
                    panic("node: unknown status")
            nodeinfo.npredecessors = _NODE_DONE
            for successor in nodeinfo.successors:
                successor_info = self.node2info[successor]
                successor_info.npredecessors -= 1
                if successor_info.npredecessors == 0:
                    self.ready_nodes.append(successor)
            self.nfinished += 1

    fn done_one(self, node):
        """Convenience: done() for a single node."""
        self.done([node])

    fn _find_cycle(self):
        # Iterative DFS mirroring Python's _find_cycle. Returns the cycle
        # as an array of nodes (first == last), or [] if acyclic.
        n2i = self.node2info
        stack = []
        itstack = []
        seen = {}
        node2stacki = {}
        for root in n2i:
            if root in seen:
                continue
            node = root
            while true:
                if node in seen:
                    if node in node2stacki:
                        start = node2stacki[node]
                        cyc = []
                        i = start
                        while i < len(stack):
                            cyc.append(stack[i])
                            i += 1
                        cyc.append(node)
                        return cyc
                    # seen but not on the current stack: just advance
                else:
                    seen[node] = true
                    node2stacki[node] = len(stack)
                    stack.append(node)
                    itstack.append(0)
                # Backtrack to the topmost stack entry that still has an
                # unvisited successor; pop exhausted frames.
                advanced = false
                while len(stack) > 0:
                    top = stack[len(stack) - 1]
                    succs = n2i[top].successors
                    idx = itstack[len(itstack) - 1]
                    if idx < len(succs):
                        itstack[len(itstack) - 1] = idx + 1
                        node = succs[idx]
                        advanced = true
                        break
                    node2stacki.pop(top)
                    stack.pop()
                    itstack.pop()
                if not advanced:
                    break
        return []

    fn static_order(self):
        """Return all nodes in topological order as an array.

        Panics if the graph contains a cycle. The particular order may
        depend on insertion order, as in Python."""
        self.prepare()
        out = []
        while self.is_active():
            group = self.get_ready()
            for node in group:
                out.append(node)
            self.done(group)
        return out

# --- constructors (A has no optional/default ctor args) ---

fn TopologicalSorter_new():
    """Empty sorter; equivalent to Python's TopologicalSorter()."""
    return TopologicalSorter({}, [], false, 0, 0)

fn TopologicalSorter_from(graph):
    """Sorter preloaded from a {node: [predecessors]} map.

    `graph` is an A map from node to an array of predecessor nodes,
    mirroring Python's TopologicalSorter({node: predecessors})."""
    ts = TopologicalSorter_new()
    for node in graph:
        ts.add(node, graph[node])
    return ts
