# std.types.simple_namespace — CPython `types.SimpleNamespace` port.
#
# Python: `types.SimpleNamespace(**kwargs)` gives an object with arbitrary
# attributes (`ns.a`, `ns.b = 1`), `vars(ns)`, equality by __dict__, and a
# `namespace(a=1)` repr.
#
# A classes have fixed fields and there is no dynamic attribute access, so
# this port stores attributes in a plain dynamic map `data` manipulated via
# methods: `ns.get("a")`, `ns.set("a", v)`, `ns.has("a")`, `ns.keys()`.
# Because A maps built by incremental assignment accept heterogeneous
# values, `data` behaves like Python's `__dict__` for practical purposes.
#
# Deviations:
#   * No `ns.attr` syntax — use `.get`/`.set`/`.has`.
#   * No `**kwargs` constructor — start empty via `simple_namespace()` or
#     pass a map to `SimpleNamespace(data)`.
#   * Equality (`==`) is not provided; compare `.data` maps if needed.
#   * `repr`/`str` render `namespace(k=v, ...)` like CPython; values are
#     formatted with `pprint.saferepr` (full one-line repr).
import pprint

## SimpleNamespace — attribute bag backed by a dynamic map.
struct SimpleNamespace:
    data

    ## get(self, name) -> value or None when absent (dict.get analog).
    fn get(self, name):
        return self.data.get(name)

    ## get_or(self, name, default) -> value or `default` when absent.
    fn get_or(self, name, default):
        return self.data.get(name, default)

    ## set(self, name, value) -> assign attribute (ns.name = value analog).
    fn set(self, name, value):
        self.data[name] = value

    ## has(self, name) -> bool attribute presence.
    fn has(self, name):
        return self.data.contains(name)

    ## remove(self, name) -> drop attribute; runtime error when absent
    ## (Python raises AttributeError; A has no exceptions).
    fn remove(self, name):
        self.data.pop(name)

    ## keys(self) -> [name] in insertion order.
    fn keys(self):
        return self.data.keys()

    ## items(self) -> [(name, value)] pairs in insertion order.
    fn items(self):
        return self.data.items()

    ## len(self) -> attribute count.
    fn len(self):
        return len(self.data)

    ## repr(self) -> 'namespace(k=v, ...)' (CPython SimpleNamespace.__repr__).
    fn repr(self):
        parts = []
        for k in self.data:
            parts.append(k + "=" + pprint.saferepr(self.data[k]))
        return "namespace(" + ", ".join(parts) + ")"

    ## str(self) -> same as repr (CPython str(ns) == repr(ns)).
    fn str(self):
        return self.repr()

## simple_namespace() -> empty SimpleNamespace (Python `SimpleNamespace()`).
fn simple_namespace():
    return SimpleNamespace({})
