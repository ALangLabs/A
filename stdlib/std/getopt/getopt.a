# std.getopt — port of Python 3.14 Lib/getopt.py.
#
# Parser for command line options (Unix getopt() conventions, plus GNU
# long options). API:
#   getopt(args, shortopts, longopts)      -> (opts, args)
#   gnu_getopt(args, shortopts, longopts)  -> (opts, prog_args)
#
# Semantic mapping notes (see docs/standard-library/python-porting.md):
#   * Python raises GetoptError; A has no exceptions, so parse errors are
#     runtime errors via core.panic carrying the same message text
#     Python puts in GetoptError.msg. `GetoptError` exists as a struct
#     for API vocabulary only (Python's `error` alias cannot be
#     expressed — a struct type is not a value).
#   * `opts` is a list of (name, value) tuples; `name` keeps Python's
#     "-x" / "--long" spelling and `value` is "" when the option takes
#     no argument. Internal helpers mutate the caller's `opts` list
#     (A lists are references) and return the remaining `args`.
#   * `gnu_getopt`'s `return_in_order` mode emits (None, [args]) marker
#     tuples — identical to Python.
#   * POSIXLY_CORRECT is read through `import env` (env.get returns ""
#     when unset).
#   * `longopts` may be a single String (wrapped into a one-element list,
#     matching Python's isinstance(longopts, str) branch) or a list.
#   * Internal has-arg codes: 0 = none, 1 = required (':'), 2 = optional
#     ('::' / '=?').
import core
import env
import json

## GetoptError: vocabulary struct mirroring Python's exception fields.
## Errors are raised via core.panic (A has no exceptions); construct this
## only if you need to carry (msg, opt) pairs yourself.
struct GetoptError:
    msg
    opt

## _slice(s, start, end) -> substring s[start:end] (chars, end exclusive).
fn _slice(s: String, start: i64, end: i64) -> String:
    cs = s.chars()
    out = ""
    i = start
    while i < end and i < len(cs):
        out = out + str(cs[i])
        i = i + 1
    return out

## _char_at(s, i) -> s[i] as a one-character String.
fn _char_at(s: String, i: i64) -> String:
    return str(s.chars()[i])

## _as_long_list(longopts) -> [String]; wraps a bare String like Python.
fn _as_long_list(longopts) -> [String]:
    if json.kind(longopts) == "string":
        return [longopts]
    return longopts

## getopt(args, shortopts, longopts) -> (opts, args)
##
## Parses command line options and parameter list. `args` is the argument
## list without the program name. `shortopts` is the option-letter string
## (':' = required arg, '::' = optional arg). `longopts` is a list of
## "name" / "name=" / "name=?" strings.
fn getopt(args: [String], shortopts: String, longopts):
    opts = []
    lopts = _as_long_list(longopts)
    while len(args) > 0 and args[0].startswith("-") and args[0] != "-":
        if args[0] == "--":
            args = args[1..]
            break
        if _slice(args[0], 0, 2) == "--":
            args = _do_longs(opts, _slice(args[0], 2, len(args[0])), lopts, args[1..])
        else:
            args = _do_shorts(opts, _slice(args[0], 1, len(args[0])), shortopts, args[1..])
    return (opts, args)

## gnu_getopt(args, shortopts, longopts) -> (opts, prog_args)
##
## GNU-style scanning: options and non-option arguments may be intermixed.
## A leading '-' in `shortopts` returns non-options in order as
## (None, [args]) marker tuples; a leading '+' stops at the first
## non-option. POSIXLY_CORRECT in the environment implies '+' mode.
fn gnu_getopt(args: [String], shortopts: String, longopts):
    opts = []
    prog_args = []
    lopts = _as_long_list(longopts)

    return_in_order = false
    all_options_first = false
    if shortopts.startswith("-"):
        shortopts = _slice(shortopts, 1, len(shortopts))
        return_in_order = true
    elif shortopts.startswith("+"):
        shortopts = _slice(shortopts, 1, len(shortopts))
        all_options_first = true
    elif env.get("POSIXLY_CORRECT") != "":
        all_options_first = true

    while len(args) > 0:
        if args[0] == "--":
            for a in args[1..]:
                prog_args.append(a)
            break
        if _slice(args[0], 0, 2) == "--":
            if return_in_order and len(prog_args) > 0:
                opts.append((None, prog_args))
                prog_args = []
            args = _do_longs(opts, _slice(args[0], 2, len(args[0])), lopts, args[1..])
        elif _slice(args[0], 0, 1) == "-" and args[0] != "-":
            if return_in_order and len(prog_args) > 0:
                opts.append((None, prog_args))
                prog_args = []
            args = _do_shorts(opts, _slice(args[0], 1, len(args[0])), shortopts, args[1..])
        else:
            if all_options_first:
                for a in args:
                    prog_args.append(a)
                break
            else:
                prog_args.append(args[0])
                args = args[1..]
    return (opts, prog_args)

## _do_longs(opts, opt, longopts, args) -> remaining args (opts mutated).
fn _do_longs(opts, opt: String, longopts: [String], args: [String]) -> [String]:
    eq = opt.find("=")
    optarg = ""
    has_inline = false
    if eq >= 0:
        optarg = _slice(opt, eq + 1, len(opt))
        opt = _slice(opt, 0, eq)
        has_inline = true
    (has_arg, opt) = _long_has_args(opt, longopts)
    if has_arg != 0:
        if not has_inline and has_arg == 1:
            if len(args) == 0:
                core.panic("option --" + opt + " requires argument")
            optarg = args[0]
            args = args[1..]
    elif has_inline:
        core.panic("option --" + opt + " must not have an argument")
    opts.append(("--" + opt, optarg))
    return args

## _long_has_args(opt, longopts) -> (has_arg_code, full_option_name)
fn _long_has_args(opt: String, longopts: [String]) -> (i64, String):
    possibilities = []
    for o in longopts:
        if o.startswith(opt):
            possibilities.append(o)
    if len(possibilities) == 0:
        core.panic("option --" + opt + " not recognized")
    if possibilities.contains(opt):
        return (0, opt)
    if possibilities.contains(opt + "="):
        return (1, opt)
    if possibilities.contains(opt + "=?"):
        return (2, opt)
    if len(possibilities) > 1:
        core.panic("option --" + opt + " not a unique prefix; possible options: " + ", ".join(possibilities))
    unique_match = possibilities[0]
    if unique_match.endswith("=?"):
        return (2, _slice(unique_match, 0, len(unique_match) - 2))
    if unique_match.endswith("="):
        return (1, _slice(unique_match, 0, len(unique_match) - 1))
    return (0, unique_match)

## _do_shorts(opts, optstring, shortopts, args) -> remaining args.
fn _do_shorts(opts, optstring: String, shortopts: String, args: [String]) -> [String]:
    while optstring != "":
        opt = _char_at(optstring, 0)
        optstring = _slice(optstring, 1, len(optstring))
        has_arg = _short_has_arg(opt, shortopts)
        if has_arg != 0:
            if optstring == "" and has_arg == 1:
                if len(args) == 0:
                    core.panic("option -" + opt + " requires argument")
                optstring = args[0]
                args = args[1..]
            optarg = optstring
            optstring = ""
        else:
            optarg = ""
        opts.append(("-" + opt, optarg))
    return args

## _short_has_arg(opt, shortopts) -> 0 | 1 | 2
fn _short_has_arg(opt: String, shortopts: String) -> i64:
    i = 0
    n = len(shortopts)
    while i < n:
        c = _char_at(shortopts, i)
        if c == opt and opt != ":":
            if not shortopts.startswith(":", i + 1):
                return 0
            if shortopts.startswith("::", i + 1):
                return 2
            return 1
        i = i + 1
    core.panic("option -" + opt + " not recognized")
