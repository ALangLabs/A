# std.bisect selftest — run: ./build/a test stdlib/std/bisect/selftest.a
from "std/bisect/__init__.a" import bisect_left, bisect_right, bisect, insort_left, insort_right, insort, bisort

fn assert_eq(a, b):
    assert(a == b)

fn test_bisect_left_right():
    xs = [1, 2, 2, 4, 5]
    assert_eq(bisect_left(xs, 2), 1)
    assert_eq(bisect_right(xs, 2), 3)
    assert_eq(bisect_left(xs, 0), 0)
    assert_eq(bisect_right(xs, 9), 5)
    assert_eq(bisect_left(xs, 3), 3)
    # sub-range bounds
    assert_eq(bisect_left(xs, 2, 2), 2)
    assert_eq(bisect_right(xs, 2, 0, 2), 2)
    # alias
    assert_eq(bisect(xs, 4), 4)

fn test_insort():
    xs = [1, 3, 5]
    insort_left(xs, 3)
    assert_eq(xs, [1, 3, 3, 5])
    insort_right(xs, 3)
    assert_eq(xs, [1, 3, 3, 3, 5])
    insort(xs, 0)
    assert_eq(xs, [0, 1, 3, 3, 3, 5])
    insort_left(xs, 9)
    assert_eq(xs[6], 9)

fn test_bisort():
    xs = [5, 1, 4, 1, 5, 9, 2, 6]
    ys = bisort(xs)
    assert_eq(ys, [1, 1, 2, 4, 5, 5, 6, 9])
    assert_eq(xs, [5, 1, 4, 1, 5, 9, 2, 6])
    assert_eq(bisort([]), [])
    assert_eq(bisort([3]), [3])

fn test_bisect_strings():
    xs = ["apple", "banana", "cherry"]
    assert_eq(bisect_left(xs, "banana"), 1)
    assert_eq(bisect_right(xs, "banana"), 2)
    assert_eq(bisect_left(xs, "blueberry"), 2)
    insort_right(xs, "blueberry")
    assert_eq(xs, ["apple", "banana", "blueberry", "cherry"])

test_bisect_left_right()
test_insort()
test_bisort()
test_bisect_strings()
print("bisect selftest ok")
