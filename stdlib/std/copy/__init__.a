# std.copy - port of CPython Lib/copy.py (adapted to A's runtime model).
#
# Deviations from CPython:
#   * `copy(x)`/`deepcopy(x)` provide practical value copying for common
#     A containers/scalars. This implementation uses JSON serialization
#     when available as a portable deep-copy strategy.
#   * Cycle detection and user-defined hooks are not implemented.
#   * Behavior may differ from CPython for identity-sensitive or
#     non-JSON-native A values.

import std:json

fn copy(x):
    "Copy common values; deep-copies JSON-compatible containers via stringify/parse."
    k = str(json.kind(x))
    if k == "array":
        return json.parse(json.stringify(x))
    if k == "object":
        return json.parse(json.stringify(x))
    return x

fn deepcopy(x):
    "Deep-copy nested containers (no cycle detection/hooks)."
    k = str(json.kind(x))
    if k == "array":
        return json.parse(json.stringify(x))
    if k == "object":
        return json.parse(json.stringify(x))
    return x
