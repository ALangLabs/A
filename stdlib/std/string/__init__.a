# std.string - port of CPython Lib/string.py (constants + selected helpers).
#
# Pure-A subset. Provides ASCII character classification constants and
# `capwords`. `Template` is provided below; `Formatter` is not ported.
#
# Deviations from CPython:
#   * `capwords(s, sep)` takes exactly 2 args (A has no default params).
#     Pass `None` for `sep` to get whitespace splitting/collapsing behavior.
#   * Only ASCII constants are provided.

whitespace = " \t\n\r"
ascii_lowercase = "abcdefghijklmnopqrstuvwxyz"
ascii_uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
ascii_letters = ascii_lowercase + ascii_uppercase
digits = "0123456789"
hexdigits = "0123456789abcdefABCDEF"
octdigits = "01234567"
punctuation = "!\"#$%&'()*+,-./:;<=>?@[\\]^_~"
printable = digits + ascii_letters + punctuation + whitespace

fn _is_space_char(ch):
    if ch == " ":
        return true
    if ch == "\t":
        return true
    if ch == "\n":
        return true
    if ch == "\r":
        return true
    return false

fn _capitalize_word(w):
    if len(w) == 0:
        return w
    s = str(w)
    first = str(s[0]).upper()
    rest = ""
    i = 1
    while i < len(s):
        rest = rest + str(s[i]).lower()
        i = i + 1
    return first + rest

fn _split_whitespace_runs(s):
    out = []
    cur = ""
    src = str(s)
    i = 0
    while i < len(src):
        ch = str(src[i])
        if _is_space_char(ch):
            if len(cur) > 0:
                out.append(cur)
                cur = ""
        else:
            cur = cur + ch
        i = i + 1
    if len(cur) > 0:
        out.append(cur)
    return out

fn _split_on_sep(s, sep):
    src = str(s)
    sp = str(sep)
    if sp == "":
        return [src]
    out = []
    cur = ""
    i = 0
    seplen = len(sp)
    srclen = len(src)
    while i < srclen:
        if i + seplen <= srclen:
            # compare slice
            is_match = true
            j = 0
            while j < seplen:
                if str(src[i + j]) != str(sp[j]):
                    is_match = false
                    break
                j = j + 1
            if is_match:
                out.append(cur)
                cur = ""
                i = i + seplen
                continue
        cur = cur + str(src[i])
        i = i + 1
    out.append(cur)
    return out

fn capwords(s, sep):
    "Capitalize words using split/capitalize/join. Pass None for whitespace behavior."
    words = []
    join_sep = " "
    if sep == None:
        words = _split_whitespace_runs(str(s))
        join_sep = " "
    else:
        join_sep = str(sep)
        words = _split_on_sep(str(s), join_sep)
    caps = []
    i = 0
    while i < len(words):
        caps.append(_capitalize_word(words[i]))
        i = i + 1
    out = ""
    i = 0
    while i < len(caps):
        if i > 0:
            out = out + join_sep
        out = out + caps[i]
        i = i + 1
    return out

# --- string.Template port -------------------------------------------------------
#
# Python `string.Template`: `$identifier` and `${identifier}` placeholders
# substituted from a mapping; `$$` is a literal delimiter. Deviations:
#   * delimiter must be a single character (Python allows str but only
#     single-char delimiters are meaningful in practice).
#   * idpattern is fixed to Python's default `[_a-z][_a-z0-9]*`
#     (case-insensitive); custom idpatterns are not supported.
#   * substitute() panics on a missing key (Python raises KeyError).
#     Invalid placeholders (a lone '$' or '$' before a non-identifier
#     char) are left as literal text in both modes, matching CPython;
#     only malformed '${...}' forms panic.
#   * The mapping must be an A map/dict; attribute-style objects are not
#     supported.

import std:core

fn _tmpl_is_alpha(ch):
    return (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z")

fn _tmpl_is_digit(ch):
    return ch >= "0" and ch <= "9"

fn _tmpl_is_id_start(ch):
    return _tmpl_is_alpha(ch) or ch == "_"

fn _tmpl_is_id_char(ch):
    return _tmpl_is_alpha(ch) or _tmpl_is_digit(ch) or ch == "_"

fn _tmpl_braced(src, i, n, delim, mapping, safe, out):
    # src[i] == '{'; find closing '}' from i+1. Returns new index or -1.
    key = ""
    j = i + 1
    while j < n:
        ch = str(src[j])
        if ch == "\}":
            if len(key) == 0:
                core.panic("Template: invalid placeholder")
            if key in mapping:
                out[0] = out[0] + str(mapping[key])
                return j + 1
            if safe:
                return -1
            core.panic("Template: key '" + key + "' not found")
            return -1
        key = key + ch
        j = j + 1
    core.panic("Template: invalid placeholder (unterminated brace)")
    return -1

fn _tmpl_named(src, i, n, mapping, safe, out):
    # src[i] is the delimiter; read an identifier starting at i+1.
    key = ""
    j = i + 1
    first = true
    while j < n:
        ch = str(src[j])
        if first:
            if not _tmpl_is_id_start(ch):
                break
        else:
            if not _tmpl_is_id_char(ch):
                break
        key = key + ch
        first = false
        j = j + 1
    if len(key) == 0:
        return -1
    if key in mapping:
        out[0] = out[0] + str(mapping[key])
        return j
    if safe:
        return -1
    core.panic("Template: key '" + key + "' not found")
    return -1

fn _template_substitute(src, delim, mapping, safe):
    s = str(src)
    d = str(delim)
    n = len(s)
    out = [""]
    i = 0
    while i < n:
        ch = str(s[i])
        if ch == d and len(d) == 1:
            if i + 1 < n and str(s[i + 1]) == d:
                out[0] = out[0] + d
                i = i + 2
                continue
            nxt = -1
            if i + 1 < n and str(s[i + 1]) == "\{":
                nxt = _tmpl_braced(s, i + 1, n, d, mapping, safe, out)
            else:
                nxt = _tmpl_named(s, i, n, mapping, safe, out)
            if nxt < 0:
                # safe_substitute: emit the '$' literally and continue
                out[0] = out[0] + d
                i = i + 1
                continue
            i = nxt
            continue
        out[0] = out[0] + ch
        i = i + 1
    return out[0]

"""
Template: string.Template port — `$name`/`${name}` substitution.
Construct via `Template_new(template)` or `Template_new(template, delim)`.
"""
class Template:
    template
    delimiter

    """substitute(mapping) -> string with placeholders replaced; panics on missing keys."""
    fn substitute(self, mapping):
        return _template_substitute(self.template, self.delimiter, mapping, false)

    """safe_substitute(mapping) -> like substitute but leaves unknown placeholders as-is."""
    fn safe_substitute(self, mapping):
        return _template_substitute(self.template, self.delimiter, mapping, true)

"""Template_new(template, delimiter = "$") -> Template."""
fn Template_new(template, delimiter = "$"):
    return Template(str(template), str(delimiter))

# --- str.translate / str.maketrans port ---------------------------------------
#
# Python `s.translate(table)` maps each character through `table`, a dict
# produced by `str.maketrans` (or any mapping ord->ord/str/None). A map
# keys are strings, so tables here key single-character strings:
#
#   t = string.maketrans("abc", "xyz")     # a->x, b->y, c->z
#   s.translate(t)  ->  string.translate(s, t)
#   string.translate(s, {"a": None})       # delete 'a'
#
# Deviations:
#   * Keys/values are single-character strings (not ordinals); a value of
#     None deletes the character, any other string replaces it.
#   * maketrans(x, y) requires equal-length strings (Python allows the
#     two-arg form only for equal lengths too).
#   * Characters not present in the table pass through unchanged
#     (Python: missing keys are kept).

"""
maketrans(frm, to) -> {char: char} translation table for equal-length
strings (Python str.maketrans(x, y)).
"""
fn maketrans(frm, to):
    a = str(frm)
    b = str(to)
    if len(a) != len(b):
        core.panic("maketrans: 'from' and 'to' strings must have equal length")
    table = {}
    i = 0
    while i < len(a):
        table[str(a[i])] = str(b[i])
        i = i + 1
    return table

"""
translate(s, table) -> s with each character replaced per `table`
({single-char-string: replacement-or-None}); absent keys are kept and
None values delete the character (Python str.translate).
"""
fn translate(s, table):
    src = str(s)
    out = ""
    i = 0
    while i < len(src):
        ch = str(src[i])
        if ch in table:
            v = table[ch]
            if v == None:
                i = i + 1
                continue
            out = out + str(v)
        else:
            out = out + ch
        i = i + 1
    return out
