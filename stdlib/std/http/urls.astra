# std.http.urls — URL parsing (Python urllib.parse.urlsplit analogue).
#
# urlsplit(url) -> UrlParts {scheme, host, port, path, query}
# Defaults: http -> 80, https -> 443. Returns None on unparseable input.
# quote/urlencode percent-encode query components (RFC 3986).
from std:bytes import chr
import std:core

class UrlParts:
    scheme: String
    host: String
    port: i64
    path: String
    query: String

"""_default_port(scheme) -> i64"""
fn _default_port(scheme: String):
    if scheme == "https":
        return 443
    if scheme == "http":
        return 80
    return 0

"""
_split_port(authority) -> (host, port). Splits on the last ':' outside
brackets; port is -1 when absent and -2 when present but invalid.
"""
fn _split_port(authority: String):
    # Only a ':' outside brackets can introduce a port (IPv6 literals).
    i = authority.rfind(":")
    if authority.startswith("["):
        close = authority.find("]")
        if close >= 0 and i <= close:
            i = -1
    if i < 0:
        return (authority, -1)
    host = authority[0..i]
    port_s = authority[i + 1..]
    if port_s == "":
        return (host, -1)
    if not port_s.isdigit():
        return (host, -2)  # invalid port: caller rejects the URL
    port = int(port_s)
    if port > 65535:
        return (host, -2)
    return (host, port)

"""
urlsplit(url) -> UrlParts? parsing "scheme://host[:port]/path?query".
Only http/https are meaningful; other schemes still parse but port defaults
to 0. None when the URL has no "://" or empty host.
"""
fn urlsplit(url: String):
    s = url.strip()
    i = s.find("://")
    if i < 0:
        return None
    scheme = s[0..i].lower()
    rest = s[i + 3..]
    # strip fragment and query from the tail search space
    end = len(rest)
    h = rest.find("#")
    if h >= 0:
        end = h
    q = rest.find("?")
    qend = end
    if q >= 0 and q < end:
        qend = q
    slash = rest.find("/")
    auth_end = qend
    if slash >= 0 and slash < qend:
        auth_end = slash
    authority = rest[0..auth_end]
    at = authority.rfind("@")
    hostport = authority
    if at >= 0:
        hostport = authority[at + 1..]
    (host, port) = _split_port(hostport)
    if host == "" or port == -2:
        return None
    host = host.lower()
    # Bracketed IPv6 literals connect without the brackets; the Host header
    # and pool key stay unambiguous because the port is a separate field.
    if host.startswith("[") and host.endswith("]") and len(host) > 2:
        host = host[1..len(host) - 1]
    if host.contains("[") or host.contains("]"):
        return None  # unbalanced brackets are not a valid host
    if port <= 0:
        port = _default_port(scheme)
    tail = rest[auth_end..end]
    path = tail
    query = ""
    if q >= 0 and q < end:
        query = rest[q + 1..end]
        path = rest[auth_end..q]
    if path == "":
        path = "/"
    return Some(UrlParts(scheme, host, port, path, query))

"""_bracket_host(host) -> host wrapped in [] when it is an IPv6 literal."""
fn _bracket_host(host: String):
    if host.contains(":") and not host.startswith("["):
        return "[" + host + "]"
    return host

"""urlunsplit(parts) -> String"""
fn urlunsplit(parts: UrlParts):
    u = parts.scheme + "://" + _bracket_host(parts.host)
    if parts.port > 0 and parts.port != _default_port(parts.scheme):
        u = u + ":" + str(parts.port)
    u = u + parts.path
    if parts.query != "":
        u = u + "?" + parts.query
    return u

"""_unreserved(c) -> bool: RFC 3986 characters a query may keep unescaped."""
fn _unreserved(c: i64):
    if c >= 48 and c <= 57:
        return true
    if c >= 65 and c <= 90:
        return true
    if c >= 97 and c <= 122:
        return true
    return c == 45 or c == 46 or c == 95 or c == 126

"""
quote(s) -> String percent-encoding every byte outside the RFC 3986
unreserved set (urllib.parse.quote with no safe characters). UTF-8 input
is encoded bytewise.
"""
fn quote(s: String):
    hex = "0123456789ABCDEF"
    out = ""
    # Percent-encoding is byte-oriented: walk the UTF-8 encoding so multi-byte
    # characters become one %XX triplet per byte, not per code point.
    for b in core.bytes_utf8_encode(s):
        if _unreserved(b):
            out = out + chr(b)!

        else:
            out = out + "%" + hex[b / 16] + hex[b % 16]
    return out

"""urlencode(params) -> String "k=v&k2=v2" with keys and values quoted."""
fn urlencode(params: {String: String}):
    out = ""
    for k in params.keys():
        if out != "":
            out = out + "&"
        out = out + quote(k) + "=" + quote(params[k])
    return out
