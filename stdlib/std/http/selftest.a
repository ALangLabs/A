# std.http selftest — urls.a / client.a helpers plus the net socket layer.
# Run: ./build/a test stdlib/std/http/selftest.a
from "urls.a" import UrlParts, urlsplit, urlunsplit
from "client.a" import _headers_map, _parse_hex, _dechunk, _is_redirect_status
import std:net

fn assert_eq(a, b):
    assert(a == b)

fn test_urlsplit_basic():
    p = urlsplit("http://example.com/")
    assert(p != None)
    q = p!
    assert_eq(q.scheme, "http")
    assert_eq(q.host, "example.com")
    assert_eq(q.port, 80)
    assert_eq(q.path, "/")
    assert_eq(q.query, "")

fn test_urlsplit_https_port_query_fragment():
    p = urlsplit("https://example.com:8443/a/b?x=1&y=2#frag")
    assert(p != None)
    q = p!
    assert_eq(q.scheme, "https")
    assert_eq(q.host, "example.com")
    assert_eq(q.port, 8443)
    assert_eq(q.path, "/a/b")
    assert_eq(q.query, "x=1&y=2")

fn test_urlsplit_query_without_path_and_slash_in_query():
    # '?' before any '/' must not leak into the authority
    p = urlsplit("http://host?q=/x")
    assert(p != None)
    q = p!
    assert_eq(q.host, "host")
    assert_eq(q.port, 80)
    assert_eq(q.path, "/")
    assert_eq(q.query, "q=/x")

fn test_urlsplit_auth_and_fragment_only_query():
    p = urlsplit("http://user:pass@example.com:8080/p#frag?notquery")
    assert(p != None)
    q = p!
    assert_eq(q.host, "example.com")
    assert_eq(q.port, 8080)
    assert_eq(q.path, "/p")
    assert_eq(q.query, "")

fn test_urlsplit_rejects_bad():
    assert_eq(urlsplit("not a url") == None, true)
    assert_eq(urlsplit("http:///path") == None, true)

fn test_urlunsplit_roundtrip():
    for u in ["http://example.com/", "https://example.com:8443/a/b?x=1", "http://h:81/p?q=2"]:
        p = urlsplit(u)
        assert(p != None)
        assert_eq(urlunsplit(p!), u)
    # default port is elided on output
    p2 = urlsplit("http://example.com:80/x")
    assert(p2 != None)
    assert_eq(urlunsplit(p2!), "http://example.com/x")

fn test_headers_map():
    lines = ["Content-Type: Application/JSON", "X-A: 1", "bad line", "x-a: 2", "Empty:"]
    m = _headers_map(lines)
    assert_eq(m["content-type"], "Application/JSON")
    assert_eq(m["x-a"], "2")
    assert_eq(m["empty"], "")
    assert_eq(m.get("missing") == None, true)

fn test_parse_hex():
    assert_eq(_parse_hex("1a"), 26)
    assert_eq(_parse_hex("A"), 10)
    assert_eq(_parse_hex("ff;ext=1"), 255)
    assert_eq(_parse_hex("  10\r"), 16)
    assert_eq(_parse_hex("zz"), 0)

fn test_dechunk():
    # two chunks, second contains CRLF inside the data
    s = "5\r\nhello\r\n4\r\na\r\nb\r\n0\r\n\r\n"
    assert_eq(_dechunk(s), "helloa\r\nb")
    assert_eq(_dechunk("0\r\n\r\n"), "")
    assert_eq(_dechunk("3;foo=bar\r\nabc\r\n0\r\n"), "abc")

fn test_is_redirect_status():
    assert_eq(_is_redirect_status(301), true)
    assert_eq(_is_redirect_status(302), true)
    assert_eq(_is_redirect_status(303), true)
    assert_eq(_is_redirect_status(307), true)
    assert_eq(_is_redirect_status(308), true)
    assert_eq(_is_redirect_status(300), false)
    assert_eq(_is_redirect_status(304), false)
    assert_eq(_is_redirect_status(200), false)
    assert_eq(_is_redirect_status(404), false)

fn test_udp_roundtrip():
    u = net.udp_socket()
    assert(u > 0)
    net.udp_bind(u, "127.0.0.1", 0)
    port = net.local_port(u)
    assert(port > 0)
    assert_eq(net.udp_send(u, "127.0.0.1", port, "ping"), 4)
    net.set_timeout(u, 1000)
    (data, host, peer) = net.udp_recv(u, 64)
    assert_eq(data, "ping")
    assert_eq(host, "127.0.0.1")
    assert_eq(peer, port)
    assert_eq(net.recv_status(u), 0)
    net.close(u)

fn test_tcp_listen_nonblocking():
    l = net.tcp_listen("127.0.0.1", 0)
    assert(l > 0)
    assert(net.local_port(l) > 0)
    net.set_nonblocking(l, true)
    assert_eq(net.accept(l), -1)          # nothing pending on a fresh listener
    assert_eq(len(net.poll([l], 0)), 0)   # ...and nothing readable
    net.close(l)
