# std.io — in-memory text/byte streams (Python `io` subset).
#
# NOTE: bare `import io` resolves to the *native* io module
# (print/eprint/input/flush). This package is reached via the quoted
# path, same convention as `std/collections`:
#
#   from "std/io/__init__.a" import StringIO, BytesIO
#
# `StringIO` is the analogue of `io.StringIO` (text), `BytesIO` of
# `io.BytesIO` (bytes as `[i64]` 0-255, matching `std.bytes`). Both keep
# a cursor: `write` overwrites at the cursor and extends the buffer,
# padding any gap with NUL (CPython behaviour); `read`/`readline`/
# `seek`/`tell`/`truncate` follow Python semantics.
#
# Deviations:
#   * There is no file-object interop: A's `print`/`input` cannot take a
#     stream argument, so StringIO/BytesIO are used via their methods
#     (getvalue) rather than as `file=` targets.
#   * `encoding`/`errors`/`newline` arguments are not supported.
#   * `closed` is a public bool field; methods panic after `close()`
#     (Python raises ValueError).
#   * Indices/positions are in CHARACTERS for StringIO and BYTES for
#     BytesIO, matching Python.
import std:core
import std:terminal

"""
_srange(s, a, b) -> substring s[a:b] in characters (end exclusive,
clamped). A strings have no slice syntax here, so this walks chars().
"""
fn _srange(s, a, b):
    cs = s.chars()
    n = len(cs)
    if a < 0:
        a = 0
    if b > n:
        b = n
    out = ""
    i = a
    while i < b:
        out = out + str(cs[i])
        i = i + 1
    return out

"""
_slen(s) -> length of s in characters.
"""
fn _slen(s):
    return len(s.chars())

"""_nul(k) -> k NUL characters (gap padding for cursor writes)."""
fn _nul(k):
    out = ""
    i = 0
    while i < k:
        out = out + "\x00"
        i = i + 1
    return out

"""
StringIO: in-memory text stream with a cursor (Python io.StringIO).
Construct via `StringIO_new(initial)` or `StringIO_new()`.
Fields `data`/`pos`/`closed` are public for inspection; use the methods.
"""
class StringIO:
    data: String
    pos: i64
    closed: bool

    """_check() -> panic when the stream is closed (Python ValueError)."""
    fn _check(self):
        if self.closed:
            core.panic("I/O operation on closed StringIO")

    """
    write(self, s) -> number of characters written; overwrites at the
    cursor, padding any gap with NUL (Python StringIO.write).
    """
    fn write(self, s):
        self._check()
        text = str(s)
        n = _slen(text)
        oldlen = _slen(self.data)
        if self.pos > oldlen:
            # cursor beyond end: pad the gap with NUL (CPython behaviour)
            self.data = self.data + _nul(self.pos - oldlen)
        self.data = _srange(self.data, 0, self.pos) + text + _srange(self.data, self.pos + n, _slen(self.data))
        self.pos = self.pos + n
        return n

    """writelines(self, lines) -> write each element (no separators added)."""
    fn writelines(self, lines):
        self._check()
        for line in lines:
            self.write(line)

    """getvalue(self) -> the entire buffer regardless of cursor position."""
    fn getvalue(self):
        return self.data

    """tell(self) -> current cursor position."""
    fn tell(self):
        return self.pos

    """
    seek(self, offset, whence = 0) -> new absolute position; returns the
    OLD position (Python file.seek). whence: 0=start, 1=current, 2=end.
    """
    fn seek(self, offset, whence = 0):
        self._check()
        old = self.pos
        base = 0
        if whence == 1:
            base = self.pos
        elif whence == 2:
            base = _slen(self.data)
        elif whence != 0:
            core.panic("StringIO.seek: invalid whence")
        np = base + offset
        if np < 0:
            core.panic("StringIO.seek: negative seek position")
        self.pos = np
        return old

    """
    read(self, size = -1) -> up to `size` characters from the cursor
    (all remaining when size < 0); advances the cursor.
    """
    fn read(self, size = -1):
        self._check()
        n = _slen(self.data)
        end = n
        if size >= 0 and self.pos + size < end:
            end = self.pos + size
        out = _srange(self.data, self.pos, end)
        self.pos = end
        return out

    """readline(self) -> one line including the trailing '\\n' (if any)."""
    fn readline(self):
        self._check()
        n = _slen(self.data)
        cs = self.data.chars()
        i = self.pos
        end = n
        while i < n:
            if str(cs[i]) == "\n":
                end = i + 1
                break
            i = i + 1
        out = _srange(self.data, self.pos, end)
        self.pos = end
        return out

    """readlines(self) -> all remaining lines as an array."""
    fn readlines(self):
        self._check()
        out = []
        while self.pos < _slen(self.data):
            out.append(self.readline())
        return out

    """
    truncate(self, size = -1) -> resize the buffer to `size` characters
    (current length when size < 0); the cursor is pulled back if needed.
    Returns the new size (Python returns the size).
    """
    fn truncate(self, size = -1):
        self._check()
        n = _slen(self.data)
        if size < 0 or size > n:
            size = n
        self.data = _srange(self.data, 0, size)
        if self.pos > size:
            self.pos = size
        return size

    """flush(self) -> no-op (in-memory stream; kept for file-like parity)."""
    fn flush(self):
        return None

    """close(self) -> mark the stream closed; later ops panic."""
    fn close(self):
        self.closed = true

    """is_closed(self) -> true after close() (Python `closed` attribute)."""
    fn is_closed(self):
        return self.closed

"""
StringIO_new(initial = "") -> StringIO over `initial` text with the
cursor at position 0 (Python `io.StringIO(initial_value)`).
"""
fn StringIO_new(initial = ""):
    return StringIO(str(initial), 0, false)

# ---------------------------------------------------------------------------
# BytesIO — in-memory binary stream over a [i64] byte array (0-255).
# ---------------------------------------------------------------------------

"""
_bytes_pad(data, n) -> data extended with zero bytes to length n.
"""
fn _bytes_pad(data, n):
    out = data.copy()
    i = len(out)
    while i < n:
        out.append(0)
        i = i + 1
    return out

"""
BytesIO: in-memory byte stream with a cursor (Python io.BytesIO).
Construct via `BytesIO_new(initial)` or `BytesIO_new()`; `initial` is a
[i64] of byte values 0-255 (same convention as `std.bytes`).
"""
class BytesIO:
    data: [i64]
    pos: i64
    closed: bool

    fn _check(self):
        if self.closed:
            core.panic("I/O operation on closed BytesIO")

    """
    write(self, bs) -> number of bytes written; overwrites at the cursor,
    padding any gap with zero bytes (Python BytesIO.write). `bs` must be
    an array of ints in 0-255 (no validation — documented).
    """
    fn write(self, bs):
        self._check()
        n = len(bs)
        end = self.pos + n
        need = _bytes_pad(self.data, end)
        i = 0
        while i < n:
            need[self.pos + i] = bs[i]
            i = i + 1
        self.data = need
        self.pos = end
        return n

    """writelines(self, lines) -> write each byte array (no separators)."""
    fn writelines(self, lines):
        self._check()
        for line in lines:
            self.write(line)

    """getvalue(self) -> copy of the entire buffer."""
    fn getvalue(self):
        return self.data.copy()

    """tell(self) -> current cursor position."""
    fn tell(self):
        return self.pos

    """
    seek(self, offset, whence = 0) -> new absolute position; returns the
    OLD position. whence: 0=start, 1=current, 2=end.
    """
    fn seek(self, offset, whence = 0):
        self._check()
        old = self.pos
        base = 0
        if whence == 1:
            base = self.pos
        elif whence == 2:
            base = len(self.data)
        elif whence != 0:
            core.panic("BytesIO.seek: invalid whence")
        np = base + offset
        if np < 0:
            core.panic("BytesIO.seek: negative seek position")
        self.pos = np
        return old

    """
    read(self, size = -1) -> up to `size` bytes from the cursor (all
    remaining when size < 0); advances the cursor.
    """
    fn read(self, size = -1):
        self._check()
        n = len(self.data)
        end = n
        if size >= 0 and self.pos + size < end:
            end = self.pos + size
        out = []
        i = self.pos
        while i < end:
            out.append(self.data[i])
            i = i + 1
        self.pos = end
        return out

    """readline(self) -> bytes through the next 0x0A byte (inclusive)."""
    fn readline(self):
        self._check()
        n = len(self.data)
        i = self.pos
        end = n
        while i < n:
            if self.data[i] == 10:
                end = i + 1
                break
            i = i + 1
        out = []
        j = self.pos
        while j < end:
            out.append(self.data[j])
            j = j + 1
        self.pos = end
        return out

    """readlines(self) -> all remaining lines as an array of byte arrays."""
    fn readlines(self):
        self._check()
        out = []
        while self.pos < len(self.data):
            out.append(self.readline())
        return out

    """
    truncate(self, size = -1) -> resize the buffer to `size` bytes
    (current length when size < 0); cursor pulled back if needed.
    Returns the new size.
    """
    fn truncate(self, size = -1):
        self._check()
        n = len(self.data)
        if size < 0 or size > n:
            size = n
        self.data = self.data[0..size]
        if self.pos > size:
            self.pos = size
        return size

    """flush(self) -> no-op (in-memory stream; file-like parity)."""
    fn flush(self):
        return None

    """close(self) -> mark the stream closed; later ops panic."""
    fn close(self):
        self.closed = true

    """is_closed(self) -> true after close()."""
    fn is_closed(self):
        return self.closed

"""
BytesIO_new(initial = []) -> BytesIO over `initial` bytes ([i64] 0-255)
with the cursor at position 0 (Python `io.BytesIO(initial_bytes)`).
"""
fn BytesIO_new(initial = []):
    return BytesIO(initial.copy(), 0, false)

# ---------------------------------------------------------------------------
# Standard input
# ---------------------------------------------------------------------------

"""
read_line() -> String: reads one line from standard input.

Returns the line without the trailing '\\n' (a trailing '\\r' of CRLF
endings is stripped too). At end-of-file it returns whatever was read —
the empty string when nothing remains — instead of panicking like the
`input()` builtin does. A final line without a newline is returned as-is.

Implemented on `std:terminal.read_char`, so it is safe on terminals and
pipes alike; avoid mixing it with `input()`/`read_file` on stdin in the
same program (stdio buffering vs. raw fd reads do not share a buffer).

    from "std/io/__init__.a" import read_line
    name = read_line()
"""
fn read_line():
    parts = []
    while true:
        c = terminal.read_char()
        if c == None:
            c = ""
        if c == "" or c == "\n":
            break
        parts.append(c)
    n = len(parts)
    if n > 0 and parts[n - 1] == "\r":
        parts.pop()
    return parts.join("")
