# std.io selftest — run: ./build/a test stdlib/std/io/selftest.a
from "std/io/__init__.astra" import StringIO, StringIO_new, BytesIO, BytesIO_new

fn assert_eq(a, b):
    assert(a == b)

fn test_stringio_write_read():
    s = StringIO_new()
    assert_eq(s.write("hello"), 5)
    assert_eq(s.tell(), 5)
    assert_eq(s.getvalue(), "hello")
    s.seek(0)
    assert_eq(s.read(2), "he")
    assert_eq(s.read(), "llo")
    assert_eq(s.read(), "")

fn test_stringio_overwrite():
    s = StringIO_new("hello")
    s.seek(1)
    s.write("XY")
    assert_eq(s.getvalue(), "hXYlo")
    s.seek(0)
    assert_eq(s.read(5), "hXYlo")

fn test_stringio_gap_pad():
    s = StringIO_new()
    s.seek(3)
    s.write("x")
    assert_eq(s.tell(), 4)
    assert_eq(len(s.getvalue()), 4)
    assert_eq(s.getvalue(), "\x00\x00\x00x")

fn test_stringio_lines():
    s = StringIO_new("a\nb\nc")
    assert_eq(s.readline(), "a\n")
    assert_eq(s.readline(), "b\n")
    lines = s.readlines()
    assert_eq(len(lines), 1)
    assert_eq(lines[0], "c")

fn test_stringio_truncate_seek():
    s = StringIO_new("abcdef")
    s.seek(4)
    assert_eq(s.truncate(3), 3)
    assert_eq(s.getvalue(), "abc")
    assert_eq(s.tell(), 3)
    old = s.seek(-2, 2)
    assert_eq(old, 3)
    assert_eq(s.tell(), 1)
    assert_eq(s.read(), "bc")
    s.writelines(["1", "2"])
    assert_eq(s.getvalue(), "abc12")

fn test_stringio_close():
    s = StringIO_new("x")
    s.close()
    assert_eq(s.is_closed(), true)

fn test_bytesio():
    b = BytesIO_new([104, 105])  # "hi"
    assert_eq(b.read(1), [104])
    b.seek(0)
    assert_eq(b.write([72, 73]), 2)
    assert_eq(b.getvalue(), [72, 73])
    b.seek(4)
    b.write([33])
    assert_eq(b.getvalue(), [72, 73, 0, 0, 33])
    assert_eq(b.tell(), 5)
    b.seek(0)
    assert_eq(b.readline(), [72, 73, 0, 0, 33])
    b2 = BytesIO_new([97, 10, 98])
    assert_eq(b2.readline(), [97, 10])
    b2.truncate(1)
    assert_eq(b2.getvalue(), [97])
    b2.close()
    assert_eq(b2.is_closed(), true)

test_stringio_write_read()
test_stringio_overwrite()
test_stringio_gap_pad()
test_stringio_lines()
test_stringio_truncate_seek()
test_stringio_close()
test_bytesio()
print("io selftest ok")
