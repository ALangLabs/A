# shlex — port of Python 3.14 Lib/shlex.py.
#
# A lexical analyzer class for simple shell-like syntaxes.
#
# Semantic mapping notes (see docs/standard-library/python-porting.md):
#  - Python's instream is a file-like object; here it is a plain String plus
#    a codepoint cursor (`_chars`/`_pos`). `push_source`/`pop_source` carry
#    the cursor state on the filestack.
#  - `shlex(instream=None)` (stdin) has no A equivalent; use
#    `Shlex_new(source, posix, punctuation_chars)` with a string.
#  - Iteration (`for tok in lex`) has no A equivalent; `split()` and
#    `get_token()` return materialized values. `get_token()` returns None
#    at EOF in posix mode, "" otherwise (Python returns None / '').
#  - Python raises ValueError on unterminated quotes/escapes; here those
#    are runtime errors via core.panic (documented in README.md).
#  - `sourcehook` reads files through `import fs` (whole-file strings;
#    there is no file-object IO in A).
import std:core
import std:fs
import std:json

_WORDCHARS_BASE = "abcdfeghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
_WORDCHARS_POSIX_EXTRA = "ßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞ"
_SAFE_CHARS = "%+,-./0123456789:=@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"

"""_str_chars(s) -> [String] of single characters (codepoints)."""
fn _str_chars(s):
    out = []
    for c in s:
        out.append(str(c))
    return out

"""_join_chars(cs, start, end) -> string of cs[start:end] (end exclusive)."""
fn _join_chars(cs, start, end):
    out = ""
    i = start
    while i < end and i < len(cs):
        out = out + cs[i]
        i = i + 1
    return out

"""_slice(s, start, end) -> substring s[start:end] in characters."""
fn _slice(s, start, end):
    return _join_chars(_str_chars(s), start, end)

"""_is_abs(path) -> true for POSIX-absolute paths ('/' prefix)."""
fn _is_abs(path):
    return path.startswith("/")

"""_dirname(path) -> directory portion of a '/'-separated path ("" if none)."""
fn _dirname(path):
    i = path.rfind("/")
    if i < 0:
        return ""
    return _slice(path, 0, i)

"""_join_path(dir, name) -> dir + "/" + name (dir "" -> name)."""
fn _join_path(dir, name):
    if dir == "":
        return name
    if dir.endswith("/"):
        return dir + name
    return dir + "/" + name

class Shlex:
    instream            # current source text (String)
    infile              # String or None
    posix               # bool
    eof                 # None (posix) or "" (non-posix)
    commenters          # String, e.g. "#"
    wordchars           # String of word characters
    whitespace          # String, default " \t\r\n"
    whitespace_split    # bool
    quotes              # String, default "'\""
    escape              # String, default "\\"
    escapedquotes       # String, default "\""
    state               # " ", a quote char, an escape char, "a", "c", or None
    pushback            # [String] token pushback stack (front = next out)
    lineno
    debug
    token
    filestack           # [{infile, instream, lineno, pos, chars}]
    source              # None, or the inclusion character
    _punctuation_chars  # String
    _pushback_chars     # [String] char pushback stack
    _pos                # int cursor into _chars
    _chars              # [String] cached characters of instream

    """_set_instream(self, s) -> make `s` the current input source."""
    fn _set_instream(self, s):
        self.instream = s
        self._chars = _str_chars(s)
        self._pos = 0

    """_next_char(self) -> next input char as a 1-char String, or None at EOF."""
    fn _next_char(self):
        if self._pos >= len(self._chars):
            return None
        c = self._chars[self._pos]
        self._pos = self._pos + 1
        return c

    """_read_line(self) -> consume through the next '\n' (like readline())."""
    fn _read_line(self):
        out = ""
        while self._pos < len(self._chars):
            c = self._chars[self._pos]
            self._pos = self._pos + 1
            out = out + c
            if c == "\n":
                break
        return out

    """
    push_token(self, tok) -> push a token onto the stack popped by
    get_token (LIFO, like Python's deque.appendleft/popleft pair).
    """
    fn push_token(self, tok):
        self.pushback.insert(0, tok)

    """
    push_source(self, newstream, newfile) -> push an input source onto
    the lexer's input source stack. `newfile` may be None.
    """
    fn push_source(self, newstream, newfile):
        entry = {}
        entry["infile"] = self.infile
        entry["instream"] = self.instream
        entry["lineno"] = self.lineno
        entry["pos"] = self._pos
        entry["chars"] = self._chars
        self.filestack.insert(0, entry)
        self.infile = newfile
        self._set_instream(newstream)
        self.lineno = 1

    """pop_source(self) -> pop the input source stack."""
    fn pop_source(self):
        entry = self.filestack.pop(0)
        self.infile = entry["infile"]
        self.instream = entry["instream"]
        self.lineno = entry["lineno"]
        self._pos = entry["pos"]
        self._chars = entry["chars"]
        self.state = " "

    """get_token(self) -> next token, or self.eof at end of input."""
    fn get_token(self):
        if len(self.pushback) > 0:
            return self.pushback.pop(0)
        raw = self.read_token()
        if self.source != None:
            while raw == self.source:
                spec = self.sourcehook(self.read_token())
                if spec != None:
                    self.push_source(spec[1], spec[0])
                raw = self.get_token()
        while raw == self.eof:
            if len(self.filestack) == 0:
                return self.eof
            self.pop_source()
            raw = self.get_token()
        return raw

    """
    read_token(self) -> scan the next raw token (String, or None at EOF
    in posix mode). Ported line-for-line from Python shlex.read_token.
    """
    fn read_token(self):
        quoted = false
        escapedstate = " "
        while true:
            if self._punctuation_chars != "" and len(self._pushback_chars) > 0:
                nextchar = self._pushback_chars.pop()
            else:
                nextchar = self._next_char()
            if nextchar == "\n":
                self.lineno = self.lineno + 1
            if self.state == None:
                self.token = ""
                break
            elif self.state == " ":
                if nextchar == None:
                    self.state = None
                    break
                elif nextchar in self.whitespace:
                    if self.token != "" or (self.posix and quoted):
                        break
                elif nextchar in self.commenters:
                    self._read_line()
                    self.lineno = self.lineno + 1
                elif self.posix and nextchar in self.escape:
                    escapedstate = "a"
                    self.state = nextchar
                elif nextchar in self.wordchars:
                    self.token = nextchar
                    self.state = "a"
                elif nextchar in self._punctuation_chars:
                    self.token = nextchar
                    self.state = "c"
                elif nextchar in self.quotes:
                    if not self.posix:
                        self.token = nextchar
                    self.state = nextchar
                elif self.whitespace_split:
                    self.token = nextchar
                    self.state = "a"
                else:
                    self.token = nextchar
                    if self.token != "" or (self.posix and quoted):
                        break
            elif self.state in self.quotes:
                quoted = true
                if nextchar == None:
                    core.panic("shlex: No closing quotation")
                if nextchar == self.state:
                    if not self.posix:
                        self.token = self.token + nextchar
                        self.state = " "
                        break
                    else:
                        self.state = "a"
                elif self.posix and nextchar in self.escape and self.state in self.escapedquotes:
                    escapedstate = self.state
                    self.state = nextchar
                else:
                    self.token = self.token + nextchar
            elif self.state in self.escape:
                if nextchar == None:
                    core.panic("shlex: No escaped character")
                if escapedstate in self.quotes and nextchar != self.state and nextchar != escapedstate:
                    self.token = self.token + self.state
                self.token = self.token + nextchar
                self.state = escapedstate
            elif self.state == "a" or self.state == "c":
                if nextchar == None:
                    self.state = None
                    break
                elif nextchar in self.whitespace:
                    self.state = " "
                    if self.token != "" or (self.posix and quoted):
                        break
                elif nextchar in self.commenters:
                    self._read_line()
                    self.lineno = self.lineno + 1
                    if self.posix:
                        self.state = " "
                        if self.token != "" or (self.posix and quoted):
                            break
                elif self.state == "c":
                    if nextchar in self._punctuation_chars:
                        self.token = self.token + nextchar
                    else:
                        if nextchar not in self.whitespace:
                            self._pushback_chars.append(nextchar)
                        self.state = " "
                        break
                elif self.posix and nextchar in self.quotes:
                    self.state = nextchar
                elif self.posix and nextchar in self.escape:
                    escapedstate = "a"
                    self.state = nextchar
                elif nextchar in self.wordchars or nextchar in self.quotes or (self.whitespace_split and nextchar not in self._punctuation_chars):
                    self.token = self.token + nextchar
                else:
                    if self._punctuation_chars != "":
                        self._pushback_chars.append(nextchar)
                    else:
                        self.pushback.insert(0, nextchar)
                    self.state = " "
                    if self.token != "" or (self.posix and quoted):
                        break
        result = self.token
        self.token = ""
        if self.posix and not quoted and result == "":
            result = None
        return result

    """
    sourcehook(self, newfile) -> (newfile, contents) for a filename to
    be sourced, or None when the file cannot be read as a relative
    include. Python raises IOError; A surfaces a runtime error from
    fs.read_file for missing files (see README.md).
    """
    fn sourcehook(self, newfile):
        if newfile.startswith("\""):
            newfile = _slice(newfile, 1, len(newfile) - 1)
        if self.infile != None and self.infile != "" and not _is_abs(newfile):
            newfile = _join_path(_dirname(self.infile), newfile)
        return (newfile, fs.read_file(newfile))

    """
    error_leader(self) -> C-compiler-like, Emacs-friendly error leader
    for the current infile/lineno, e.g. `"file", line 3: `.
    """
    fn error_leader(self):
        return "\"" + str(self.infile) + "\", line " + str(self.lineno) + ": "

    """
    read_line(self) -> consume and return the rest of the current
    input line (convenience addition; Python shlex has no read_line).
    """
    fn read_line(self):
        return self._read_line()

"""
Shlex_new(source, posix, punctuation_chars) -> Shlex over `source`.
`punctuation_chars`: false/"" -> none, true -> "();<>|&", or a string
of punctuation characters (Python's punctuation_chars argument).
"""
fn Shlex_new(source, posix, punctuation_chars):
    pc = ""
    pkind = json.kind(punctuation_chars)
    if pkind == "bool":
        if punctuation_chars:
            pc = "();<>|&"
    elif pkind == "string":
        pc = punctuation_chars
    else:
        core.panic("shlex: punctuation_chars must be a bool or string")
    wordchars = _WORDCHARS_BASE
    if posix:
        wordchars = wordchars + _WORDCHARS_POSIX_EXTRA
    if pc != "":
        wordchars = wordchars + "~-./*?="
        kept = ""
        for c in wordchars:
            sc = str(c)
            if not (sc in pc):
                kept = kept + sc
        wordchars = kept
    eof = None
    if not posix:
        eof = ""
    lx = Shlex(source, None, posix, eof, "#", wordchars, " \t\r\n", false,
               "'\"", "\\", "\"", " ", [], 1, 0, "", [], None, pc, [], 0, [])
    lx._set_instream(source)
    return lx

"""
split(s, comments, posix) -> [String] shell-like split of `s`.
Python: split(s, comments=False, posix=True); A has no default args, so
pass all three. `comments` true keeps '#' comments enabled.
"""
fn split(s, comments, posix):
    if s == None:
        core.panic("shlex.split: s argument must not be None")
    lex = Shlex_new(s, posix, false)
    lex.whitespace_split = true
    if not comments:
        lex.commenters = ""
    out = []
    while true:
        tok = lex.get_token()
        if tok == lex.eof:
            break
        out.append(tok)
    return out

"""quote(s) -> shell-escaped version of the string `s`."""
fn quote(s):
    if s == "":
        return "''"
    if s.isascii():
        safe = true
        for c in s:
            sc = str(c)
            if not (sc in _SAFE_CHARS):
                safe = false
                break
        if safe:
            return s
    return "'" + s.replace("'", "'\"'\"'") + "'"

"""join(split_command) -> shell-escaped string from an array of args."""
fn join(split_command):
    parts = []
    for arg in split_command:
        parts.append(quote(arg))
    return " ".join(parts)
