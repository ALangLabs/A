# std.format.csv (format helper).
#
# Port of CPython's `csv` module core: RFC 4180-style quoting on write and
# a state-machine parser on read. Deviations from CPython:
#   * QUOTE_MINIMAL only for fields (always-quote variant provided);
#     QUOTE_NONE / QUOTE_NONNUMERIC / escapechar / dialect objects absent.
#   * `csv_text` writes '\r\n' line terminators like csv.writer's default
#     lineterminator; pass a different terminator as the optional arg.
#   * `csv_parse` returns a materialized array of rows (Python yields
#     iterators). Truly blank physical lines are skipped.
#   * No `csv.field_size_limit` / Sniffer.

fn _needs_quote(f: str) -> bool:
    i = 0
    n = len(f)
    while i < n:
        c = str(f[i])
        if c == "," or c == "\"" or c == "\n" or c == "\r":
            return true
        i = i + 1
    return false

fn _quote_field(f: str) -> str:
    # Double every '"' and wrap in quotes.
    inner = ""
    i = 0
    n = len(f)
    while i < n:
        c = str(f[i])
        if c == "\"":
            inner = inner + "\"\""
        else:
            inner = inner + c
        i = i + 1
    return "\"" + inner + "\""

"""
csv_field(v) -> single CSV field, quoted only when required
(contains ',', '"', '\n' or '\r') — csv.QUOTE_MINIMAL semantics.
"""
fn csv_field(v):
    f = str(v)
    if _needs_quote(f):
        return _quote_field(f)
    return f

"""
csv_field_always(v) -> single CSV field always wrapped in quotes
(csv.QUOTE_ALL semantics for one field).
"""
fn csv_field_always(v):
    return _quote_field(str(v))

"""
csv_row(values) -> one CSV record (no line terminator), fields quoted
per QUOTE_MINIMAL. `values` may be any array; elements are str()'d.
"""
fn csv_row(values):
    parts = []
    for v in values:
        parts.append(csv_field(v))
    text = ""
    i = 0
    while i < len(parts):
        if i > 0:
            text = text + ","
        text = text + parts[i]
        i = i + 1
    return text

"""
csv_rows(rows) -> array of CSV record strings, one per row.
"""
fn csv_rows(rows):
    out = []
    for r in rows:
        out.append(csv_row(r))
    return out

"""
csv_text(rows, lineterminator) -> full CSV document text.
lineterminator defaults to "\r\n" (csv.writer default).
"""
fn csv_text(rows, lineterminator = "\r\n"):
    recs = csv_rows(rows)
    out = ""
    i = 0
    while i < len(recs):
        out = out + recs[i] + lineterminator
        i = i + 1
    return out

# --- parsing ---

fn _is_nl_at(s, i):
    # returns 1 for '\n', 2 for '\r\n', 3 for lone '\r', else 0
    n = len(s)
    if i >= n:
        return 0
    c = str(s[i])
    if c == "\n":
        return 1
    if c == "\r":
        if i + 1 < n and str(s[i + 1]) == "\n":
            return 2
        return 3
    return 0

fn _nl_len(kind):
    if kind == 2:
        return 2
    return 1

fn _push_field(row, field):
    row.append(field)

fn _substr_copy(s, start, end):
    out = ""
    i = start
    while i < end:
        out = out + str(s[i])
        i = i + 1
    return out

"""
_parse_record(s, pos) -> (fields, new_pos, kind)

Parses one CSV record starting at `pos`. Returns the field list, the
position just past the record terminator (or len(s) at EOF), and the
terminator kind (0 = EOF). Handles quoted fields, embedded newlines in
quotes, and doubled-quote escapes. A record may span multiple physical
lines when quotes are open.
"""
fn _parse_record(s, pos):
    n = len(s)
    row = []
    field = ""
    i = pos
    # state: 0 = start of field, 1 = in unquoted field, 2 = in quoted field,
    #        3 = just closed quote (only delimiter/newline may follow)
    state = 0
    while i < n:
        c = str(s[i])
        if state == 2:
            if c == "\"":
                if i + 1 < n and str(s[i + 1]) == "\"":
                    field = field + "\""
                    i = i + 2
                    continue
                state = 3
                i = i + 1
                continue
            field = field + c
            i = i + 1
            continue
        # states 0, 1, 3
        if c == ",":
            _push_field(row, field)
            field = ""
            state = 0
            i = i + 1
            continue
        nl = _is_nl_at(s, i)
        if nl != 0:
            _push_field(row, field)
            return (row, i + _nl_len(nl), nl)
        if state == 3:
            # stray characters after closing quote: keep literally
            field = field + c
            state = 1
            i = i + 1
            continue
        if c == "\"" and state == 0:
            state = 2
            i = i + 1
            continue
        if c == "\"" and state == 1:
            # quote inside unquoted field: literal (CPython behaviour)
            field = field + c
            i = i + 1
            continue
        field = field + c
        state = 1
        i = i + 1
    # EOF: flush pending field/row
    _push_field(row, field)
    return (row, i, 0)

"""
csv_parse(text) -> [[str]] — parse CSV document text into rows.

Blank physical lines (zero characters between terminators) are skipped.
A line containing only a terminator yields no row (matches the common
expectation that empty lines carry no data).
"""
fn csv_parse(text):
    s = str(text)
    n = len(s)
    rows = []
    pos = 0
    while pos < n:
        # skip blank lines
        nl = _is_nl_at(s, pos)
        if nl != 0:
            pos = pos + _nl_len(nl)
            continue
        (row, next_pos, kind) = _parse_record(s, pos)
        rows.append(row)
        pos = next_pos
        if kind == 0:
            break
    return rows

"""
parse_row(line) -> [str] — parse a single CSV record (no embedded
newlines). Equivalent to csv_parse(line + "\\n")[0] but without the
allocation; a record containing an opening quote with no close consumes
to end of line.
"""
fn parse_row(line):
    s = str(line)
    # strip a trailing newline pair if present so the record ends cleanly
    n = len(s)
    end = n
    if n >= 2 and str(s[n - 2]) == "\r" and str(s[n - 1]) == "\n":
        end = n - 2
    elif n >= 1 and (str(s[n - 1]) == "\n" or str(s[n - 1]) == "\r"):
        end = n - 1
    sub = _substr_copy(s, 0, end)
    (row, _, _) = _parse_record(sub, 0)
    return row
