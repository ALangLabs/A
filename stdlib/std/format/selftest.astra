# std.format selftest — run: ./build/a test stdlib/std/format/selftest.astra
import std:format

fn assert_eq(a, b):
    assert(a == b)

fn test_csv_field():
    assert_eq(format.csv_field("abc"), "abc")
    assert_eq(format.csv_field("a,b"), "\"a,b\"")
    assert_eq(format.csv_field("a\"b"), "\"a\"\"b\"")
    assert_eq(format.csv_field("a\nb"), "\"a\nb\"")
    assert_eq(format.csv_field_always("abc"), "\"abc\"")

fn test_csv_row_text():
    assert_eq(format.csv_row(["a", "b,c", "d\"e"]), "a,\"b,c\",\"d\"\"e\"")
    t = format.csv_text([["a", "b"], ["1", "2"]])
    assert_eq(t, "a,b\r\n1,2\r\n")
    t2 = format.csv_text([["a"]], "\n")
    assert_eq(t2, "a\n")

fn test_csv_parse():
    rows = format.csv_parse("a,b,c\n1,2,3\n")
    assert_eq(len(rows), 2)
    assert_eq(rows[0][0], "a")
    assert_eq(rows[1][2], "3")
    rows2 = format.csv_parse("\"a,b\",\"c\"\"d\"\n\"x\ny\",z\n")
    assert_eq(len(rows2), 2)
    assert_eq(rows2[0][0], "a,b")
    assert_eq(rows2[0][1], "c\"d")
    assert_eq(rows2[1][0], "x\ny")
    assert_eq(rows2[1][1], "z")
    # round-trip
    rt = format.csv_parse(format.csv_text([["a,b", "c"], ["d\"e", "f\ng"]]))
    assert_eq(len(rt), 2)
    assert_eq(rt[0][0], "a,b")
    assert_eq(rt[0][1], "c")
    assert_eq(rt[1][0], "d\"e")
    assert_eq(rt[1][1], "f\ng")
    # CRLF
    rc = format.csv_parse("a,b\r\n1,2\r\n")
    assert_eq(len(rc), 2)
    assert_eq(rc[1][1], "2")

fn test_parse_row():
    r = format.parse_row("a,\"b,c\",d")
    assert_eq(len(r), 3)
    assert_eq(r[1], "b,c")
    r2 = format.parse_row("x,y\r\n")
    assert_eq(len(r2), 2)
    assert_eq(r2[1], "y")

fn test_table():
    tb = format.table(["name", "age"], [["ann", "3"], ["bob", "10"]])
    assert(tb.contains("name | age"))
    assert(tb.contains("ann | 3"))
    assert_eq(format.join_rows([1, 2]), "row\n---\n1\n2")

fn main():
    test_csv_field()
    test_csv_row_text()
    test_csv_parse()
    test_parse_row()
    test_table()
    print("format selftest OK")
