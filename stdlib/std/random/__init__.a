# std.random — seedable pseudo-random numbers (Python `random` subset).
#
# Pure-A PRNG: the MINSTD / Park-Miller generator
#
#     state = (state * 48271) mod 2147483647     state in [1, 2147483645]
#
# chosen because every intermediate fits comfortably in i64 (max product
# ~2^46), so no overflow-checked arithmetic can fire. Period 2^31 - 2.
#
# Usage:
#   import std:random
#   random.seed(42)
#   x = random.random()          # [0.0, 1.0)
#   n = random.randint(1, 10)    # inclusive
#   c = random.choice(["a", "b"])
#   rng = random.Random(7)       # independent stream
#   rng.shuffle(deck)
#
# Deviations from Python:
#   * Not cryptographically secure (weaker than CPython's Mersenne Twister;
#     fine for simulations, shuffling, games — not for keys/tokens).
#   * seed(s): s may be an integer, a float, or any value stringified then
#     hashed (djb2). seed()/seed(None) reseeds from time.now() milliseconds.
#   * random() builds a 53-bit float from two 31-bit draws (like Python).
#   * randint/randrange/sample/choice use rejection sampling where practical
#     (no modulo bias for ranges <= 2^31-1).
#   * shuffle(x) shuffles the array in place AND returns it (Python returns
#     None); use shuffled(x) for a copy.
#   * sample(population, k) requires k <= len(population); panics otherwise.
#   * getrandbits(k) supports 1 <= k <= 62 (two 31-bit draws max).
#   * randbytes(n) returns [i64] of n bytes in 0..255.
#   * Module-level functions share one global Random instance; construct
#     Random(seed) for independent streams.
import std:core
import std:time
import std:json
import std:bytes
import std:math

# NOTE: the Park-Miller constants are inlined as literals in every function
# below (2147483647 modulus, 48271 multiplier, 2147483646 max state/span).
# Module-level variables read as 0.0 inside `a test` test functions
# (toolchain quirk), so named constants would silently break there.

"""
_pm_step(st) -> next Park-Miller state (i64 in [1, 2147483646]).
Shared by the Random methods and the module-level scalar fast paths so
both produce the identical stream for a given state.
"""
fn _pm_step(st):
    return (st * 48271) % 2147483647

"""
_next_raw(self) -> i64 in [1, 2147483646]; advances the Park-Miller state.
"""
fn _next_raw(self):
    self.state = _pm_step(self.state)
    return self.state

"""
_next31(self) -> i64 in [0, 2^31-2]; one uniform 31-bit-ish draw.
Steps the state directly (inlined _next_raw) to save a call per draw.
"""
fn _next31(self):
    self.state = _pm_step(self.state)
    return self.state - 1

"""
_randbelow(self, n) -> i64 in [0, n); rejection sampling so there is no
modulo bias. n must be >= 1.
"""
fn _randbelow(self, n):
    if n <= 0:
        core.panic("randbelow: n must be positive")
    if n == 1:
        return 0
    if n > 2147483646:
        # Range wider than one draw: fall back to a single modulo draw
        # (bias is negligible relative to the range size).
        return _next31(self) % n
    limit = (2147483646 / n) * n
    while true:
        x = _next31(self)
        if x < limit:
            return x % n
    return 0  # unreachable; satisfies the return checker

"""
_seed_hash(s) -> i64 seed derived from an arbitrary value's string form
(djb2 over code points). Deterministic across runs for equal inputs.
"""
fn _seed_hash(s):
    h = 5381
    text = str(s)
    i = 0
    while i < len(text):
        c = bytes.ord(text[i])
        cp = c ?? 0
        h = ((h * 33) + cp) % 2147483647
        if h <= 0:
            h = h + 2147483647 - 1
        i = i + 1
    if h <= 0:
        h = 1
    return h

"""
_is_int_value(s) -> true when s is a Json number without a fraction or
exponent (i.e. an integer literal safe for int()).
"""
fn _is_int_value(s):
    if json.kind(s) != "number":
        return false
    t = str(s)
    if "." in t or "e" in t or "E" in t:
        return false
    # int(s) must stay inside i64; longer digit strings go through the hash.
    if len(t) > 18:
        return false
    return true

"""
_pow2(n) -> 2^n as i64 (n <= 62).
"""
fn _pow2(n):
    r = 1
    i = 0
    while i < n:
        r = r * 2
        i = i + 1
    return r

"""
Random: a seedable PRNG stream. Field `state` is public for inspection;
prefer the methods.
"""
class Random:
    state: i64

    """Random(seed) -> stream; seed may be i64, float, String, or None."""
    fn seed(self, s = None):
        if s == None:
            # Wall-clock entropy; millisecond resolution is enough for
            # non-adversarial use (documented deviation).
            raw = time.now()
            self.state = (raw % 2147483646) + 1
        elif _is_int_value(s):
            v = int(str(s))
            self.state = v % 2147483646
            if self.state <= 0:
                self.state = self.state + 2147483646
        else:
            self.state = _seed_hash(s)

    """_u62(self) -> float in [0, 1) from two 31-bit draws (62 bits total)."""
    fn _u62(self):
        hi = _next31(self)
        lo = _next31(self)
        # hi * 2^31 + lo  (< 2^62, safe); / 2^62 -> [0, 1)
        return float(hi * 2147483648 + lo) / 4611686018427387904.0

    """random(self) -> float in [0.0, 1.0)."""
    fn random(self):
        return self._u62()

    """randint(self, a, b) -> i64 in [a, b] inclusive."""
    fn randint(self, a, b):
        if b < a:
            core.panic("randint: empty range")
        width = b - a + 1
        return a + _randbelow(self, width)

    """
    randrange(self, start, stop = None, step = 1) -> i64.
    Python semantics: randrange(stop), randrange(start, stop),
    randrange(start, stop, step). `stop = None` selects the 1-arg form.
    """
    fn randrange(self, start, stop = None, step = 1):
        if step == 0:
            core.panic("randrange: step is 0")
        lo = start
        hi = stop
        if hi == None:
            hi = start
            lo = 0
        if step > 0:
            width = hi - lo
            if width <= 0:
                core.panic("randrange: empty range")
            count = (width + step - 1) / step
            if count <= 0:
                core.panic("randrange: empty range")
            return lo + step * _randbelow(self, count)
        # negative step: values lo, lo+step, ... while > hi
        span = lo - hi
        if span <= 0:
            core.panic("randrange: empty range")
        count = (span - step - 1) / (-step)
        if count <= 0:
            core.panic("randrange: empty range")
        return lo + step * _randbelow(self, count)

    """choice(self, seq) -> random element of a non-empty array."""
    fn choice(self, seq):
        if len(seq) == 0:
            core.panic("choice: empty sequence")
        return seq[_randbelow(self, len(seq))]

    """choices(self, seq, k) -> array of k independent choices (with replacement)."""
    fn choices(self, seq, k):
        if len(seq) == 0:
            core.panic("choices: empty sequence")
        out = []
        i = 0
        while i < k:
            out.append(self.choice(seq))
            i = i + 1
        return out

    """
    choices_weighted(self, seq, weights, k) -> array of k choices where
    each element's probability is proportional to its weight
    (Python random.choices(population, weights=..., k=...); a separate
    name because A has no keyword arguments). `weights` must have the
    same length as `seq`; panics on mismatch, empty weights, or a
    non-positive total weight.
    """
    fn choices_weighted(self, seq, weights, k):
        if len(seq) == 0:
            core.panic("choices_weighted: empty sequence")
        if len(weights) != len(seq):
            core.panic("choices_weighted: weights must match population length")
        total = 0.0
        for x in weights:
            total = total + (x + 0.0)
        if total <= 0.0:
            core.panic("choices_weighted: total weight must be positive")
        # cumulative weights for linear-scan selection
        cum = []
        acc = 0.0
        for x in weights:
            acc = acc + (x + 0.0)
            cum.append(acc)
        out = []
        i = 0
        while i < k:
            u = self.random() * total
            j = 0
            while j < len(cum) - 1 and cum[j] < u:
                j = j + 1
            out.append(seq[j])
            i = i + 1
        return out

    """sample(self, population, k) -> new array of k unique elements."""
    fn sample(self, population, k):
        n = len(population)
        if k < 0 or k > n:
            core.panic("sample: k out of range")
        pool = population.copy()
        out = []
        i = 0
        while i < k:
            j = i + _randbelow(self, n - i)
            tmp = pool[i]
            pool[i] = pool[j]
            pool[j] = tmp
            out.append(pool[i])
            i = i + 1
        return out

    """shuffle(self, x) -> x shuffled in place (also returned)."""
    fn shuffle(self, x):
        n = len(x)
        i = n - 1
        while i > 0:
            j = _randbelow(self, i + 1)
            tmp = x[i]
            x[i] = x[j]
            x[j] = tmp
            i = i - 1
        return x

    """shuffled(self, x) -> new array with x's elements shuffled."""
    fn shuffled(self, x):
        out = x.copy()
        return self.shuffle(out)

    """uniform(self, a, b) -> float in [a, b] (endpoints possible)."""
    fn uniform(self, a, b):
        # `x + 0.0` coerces int->float; float() miscompiles on float args
        # inside class methods (backend quirk).
        return (a + 0.0) + ((b + 0.0) - (a + 0.0)) * self._u62()

    """
    triangular(self, low, high, mode) -> float; continuous distribution
    peaked at `mode` (Python random.triangular).
    """
    fn triangular(self, low, high, mode):
        u = self._u62()
        lo = low + 0.0
        hi = high + 0.0
        mo = mode + 0.0
        fc = (mo - lo) / (hi - lo)
        if u < fc:
            return lo + math.sqrt((mo - lo) * (hi - lo) * u)
        return hi - math.sqrt((hi - mo) * (hi - lo) * (1.0 - u))

    """getrandbits(self, k) -> i64 with k random bits (1 <= k <= 62)."""
    fn getrandbits(self, k):
        if k < 1 or k > 62:
            core.panic("getrandbits: k must be in [1, 62]")
        if k <= 31:
            return _next31(self) % _pow2(k)
        hi_bits = k - 31
        hi = _next31(self) % _pow2(hi_bits)
        lo = _next31(self)
        return hi * 2147483648 + lo

    """
    gauss(self, mu, sigma) -> float; normal distribution via the
    Box-Muller transform (Python random.gauss; no cached second value —
    each call consumes two uniforms, a documented deviation).
    """
    fn gauss(self, mu, sigma):
        u1 = self.random()
        while u1 <= 0.0:
            u1 = self.random()
        u2 = self.random()
        r = math.sqrt(-2.0 * math.log(u1))
        theta = 6.283185307179586 * u2
        m = mu + 0.0
        s = sigma + 0.0
        return m + s * r * math.cos(theta)

    """normalvariate(self, mu, sigma) -> alias of gauss (Python parity)."""
    fn normalvariate(self, mu, sigma):
        return self.gauss(mu, sigma)

    """
    expovariate(self, lambd) -> float; exponential distribution with
    rate parameter lambd (Python random.expovariate).
    """
    fn expovariate(self, lambd):
        if lambd <= 0.0:
            core.panic("expovariate: lambd must be positive")
        u = self.random()
        while u >= 1.0:
            u = self.random()
        return -math.log(1.0 - u) / (lambd + 0.0)

    """
    gammavariate(self, alpha, beta) -> float; Gamma distribution with
    shape alpha and scale beta (Python random.gammavariate). Uses the
    Marsaglia-Tsang method for alpha >= 1 and the standard alpha<1
    boost (Gamma(a) = Gamma(a+1) * U^(1/a)).
    """
    fn gammavariate(self, alpha, beta):
        if alpha <= 0.0 or beta <= 0.0:
            core.panic("gammavariate: alpha and beta must be positive")
        if alpha < 1.0:
            return self.gammavariate(alpha + 1.0, beta) * math.pow(self.random(), 1.0 / (alpha + 0.0))
        d = (alpha + 0.0) - 0.3333333333333333
        c = 1.0 / math.sqrt(9.0 * d)
        while true:
            x = self.gauss(0.0, 1.0)
            v = 1.0 + c * x
            if v <= 0.0:
                continue
            v = v * v * v
            u = self.random()
            if u <= 0.0:
                continue
            if math.log(u) < 0.5 * x * x + d - d * v + d * math.log(v):
                return d * v * (beta + 0.0)
        return 0.0  # unreachable; satisfies the return checker

    """
    betavariate(self, alpha, beta) -> float in [0, 1]; Beta
    distribution (Python random.betavariate; ratio of two gammas).
    """
    fn betavariate(self, alpha, beta):
        if alpha <= 0.0 or beta <= 0.0:
            core.panic("betavariate: alpha and beta must be positive")
        y = self.gammavariate(alpha, 1.0)
        z = self.gammavariate(beta, 1.0)
        s = y + z
        if s == 0.0:
            return 0.0
        return y / s

    """lognormvariate(self, mu, sigma) -> float; log-normal distribution."""
    fn lognormvariate(self, mu, sigma):
        return math.exp(self.gauss(mu, sigma))

    """
    paretovariate(self, alpha) -> float; Pareto distribution with
    shape alpha (Python random.paretovariate).
    """
    fn paretovariate(self, alpha):
        if alpha <= 0.0:
            core.panic("paretovariate: alpha must be positive")
        return math.pow(1.0 - self.random(), -1.0 / (alpha + 0.0)) - 1.0

    """
    weibullvariate(self, alpha, beta) -> float; Weibull distribution
    (Python random.weibullvariate).
    """
    fn weibullvariate(self, alpha, beta):
        if alpha <= 0.0 or beta <= 0.0:
            core.panic("weibullvariate: alpha and beta must be positive")
        return (beta + 0.0) * math.pow(-math.log(1.0 - self.random()), 1.0 / (alpha + 0.0))

    """randbytes(self, n) -> [i64] of n bytes, each in 0..255."""
    fn randbytes(self, n):
        out = []
        i = 0
        while i < n:
            out.append(_randbelow(self, 256))
            i = i + 1
        return out

"""
Random_new(seed) -> Random with `seed(s)` applied. Use this instead of
`Random(s)` when s is a String/float/negative/large seed: positional
construction only assigns the raw `state` field (fine for small positive
integer seeds, which coincide with seed()'s mapping), while Random_new
runs the full seed logic for any value.
"""
fn Random_new(seed):
    r = Random(1)
    r.seed(seed)
    return r

# -- module-level API (shared global stream) ---------------------------------
#
# The stream state lives in the scalar `_gstate` and is round-tripped through
# a fresh Random on every call. A shared Random INSTANCE cannot be used here:
# under `a test` no module top-level code runs, so `_default = Random(1)` is
# never executed and `_default` reads as 0.0 ("'float' object has no attribute
# 'state'"). Scalar module vars DO persist writes made inside functions, but
# an uninitialized one reads as float 0.0 and int-typed locals/comparisons
# reject it ("internal: not an integer") — so `_gstate` is kept FLOAT-typed
# end to end (the Park-Miller state < 2^31 is exact in a double) and every
# read goes through `+ 0.0` / `int(...)`. `_gstate <= 0` means "unseeded" ->
# seed from the wall clock (same as the old _default_seeded flag; explicit
# seed() always wins).

_gstate = 0.0

fn _load():
    s = _gstate + 0.0
    if s <= 0.0:
        s = (time.now() % 2147483646) + 1.0
        _gstate = s
    return Random(int(s))

fn _store(r):
    _gstate = r.state + 0.0

# -- scalar fast paths ---------------------------------------------------------
#
# The scalar helpers below operate on `_gstate` directly (i64 domain; the
# Park-Miller state < 2^31 is exact in the float-typed module var). They
# consume draws in exactly the same order as the Random methods, so the
# module-level stream is bit-identical to before — but each call avoids
# constructing a temporary Random instance (~20x faster for draw-heavy
# loops). The complex distribution wrappers below still round-trip through
# _load()/_store() because they need several draws per call.

"""_gload_i() -> i64 global state; seeds from the wall clock when unset."""
fn _gload_i():
    s = _gstate + 0.0
    if s <= 0.0:
        s = (time.now() % 2147483646) + 1.0
        _gstate = s
    return int(s)

"""_gstore_i(st) -> persist an advanced i64 state back to _gstate."""
fn _gstore_i(st):
    _gstate = st + 0.0

"""_gunif() -> float in [0.0, 1.0); same two-draw sequence as Random._u62."""
fn _gunif():
    st = _gload_i()
    st = _pm_step(st)
    hi = st - 1
    st = _pm_step(st)
    lo = st - 1
    _gstore_i(st)
    # hi * 2^31 + lo  (< 2^62, safe); / 2^62 -> [0, 1)
    return float(hi * 2147483648 + lo) / 4611686018427387904.0

"""
_grandbelow(n) -> i64 in [0, n) from the global stream; identical draws to
Random._randbelow, including the no-draw n == 1 case.
"""
fn _grandbelow(n):
    if n <= 0:
        core.panic("randbelow: n must be positive")
    st = _gload_i()  # also performs the lazy wall-clock seed
    if n == 1:
        return 0  # no draw consumed (matches Random._randbelow)
    if n > 2147483646:
        # Range wider than one draw: single modulo draw (negligible bias).
        st = _pm_step(st)
        v = (st - 1) % n
        _gstore_i(st)
        return v
    limit = (2147483646 / n) * n
    while true:
        st = _pm_step(st)
        x = st - 1
        if x < limit:
            _gstore_i(st)
            return x % n
    return 0  # unreachable; satisfies the return checker

"""seed(s = None) -> reseed the global stream."""
fn seed(s = None):
    r = _load()
    r.seed(s)
    _store(r)

"""random() -> float in [0.0, 1.0) from the global stream."""
fn random():
    return _gunif()

"""randint(a, b) -> i64 in [a, b] inclusive."""
fn randint(a, b):
    if b < a:
        core.panic("randint: empty range")
    return a + _grandbelow(b - a + 1)

"""randrange(start, stop = None, step = 1) -> i64 (Python semantics)."""
fn randrange(start, stop = None, step = 1):
    if step == 0:
        core.panic("randrange: step is 0")
    lo = start
    hi = stop
    if hi == None:
        hi = start
        lo = 0
    if step > 0:
        width = hi - lo
        if width <= 0:
            core.panic("randrange: empty range")
        count = (width + step - 1) / step
        if count <= 0:
            core.panic("randrange: empty range")
        return lo + step * _grandbelow(count)
    # negative step: values lo, lo+step, ... while > hi
    span = lo - hi
    if span <= 0:
        core.panic("randrange: empty range")
    count = (span - step - 1) / (-step)
    if count <= 0:
        core.panic("randrange: empty range")
    return lo + step * _grandbelow(count)

"""choice(seq) -> random element of a non-empty array."""
fn choice(seq):
    n = len(seq)
    if n == 0:
        core.panic("choice: empty sequence")
    return seq[_grandbelow(n)]

"""choices(seq, k) -> array of k independent choices."""
fn choices(seq, k):
    n = len(seq)
    if n == 0:
        core.panic("choices: empty sequence")
    out = []
    i = 0
    while i < k:
        out.append(seq[_grandbelow(n)])
        i = i + 1
    return out

"""choices_weighted(seq, weights, k) -> weighted choices (global stream)."""
fn choices_weighted(seq, weights, k):
    if len(seq) == 0:
        core.panic("choices_weighted: empty sequence")
    if len(weights) != len(seq):
        core.panic("choices_weighted: weights must match population length")
    total = 0.0
    for x in weights:
        total = total + (x + 0.0)
    if total <= 0.0:
        core.panic("choices_weighted: total weight must be positive")
    # cumulative weights for linear-scan selection
    cum = []
    acc = 0.0
    for x in weights:
        acc = acc + (x + 0.0)
        cum.append(acc)
    nc = len(cum)
    out = []
    i = 0
    while i < k:
        u = _gunif() * total
        j = 0
        while j < nc - 1 and cum[j] < u:
            j = j + 1
        out.append(seq[j])
        i = i + 1
    return out

"""sample(population, k) -> new array of k unique elements."""
fn sample(population, k):
    n = len(population)
    if k < 0 or k > n:
        core.panic("sample: k out of range")
    pool = population.copy()
    out = []
    i = 0
    while i < k:
        j = i + _grandbelow(n - i)
        tmp = pool[i]
        pool[i] = pool[j]
        pool[j] = tmp
        out.append(pool[i])
        i = i + 1
    return out

"""shuffle(x) -> x shuffled in place (also returned)."""
fn shuffle(x):
    n = len(x)
    i = n - 1
    while i > 0:
        j = _grandbelow(i + 1)
        tmp = x[i]
        x[i] = x[j]
        x[j] = tmp
        i = i - 1
    return x

"""shuffled(x) -> new array with x's elements shuffled."""
fn shuffled(x):
    out = x.copy()
    return shuffle(out)

"""uniform(a, b) -> float in [a, b]."""
fn uniform(a, b):
    # `x + 0.0` coerces int->float; float() miscompiles on float args
    # inside class methods (backend quirk).
    return (a + 0.0) + ((b + 0.0) - (a + 0.0)) * _gunif()

"""triangular(low, high, mode) -> float (sum-of-uniforms distribution)."""
fn triangular(low, high, mode):
    u = _gunif()
    lo = low + 0.0
    hi = high + 0.0
    mo = mode + 0.0
    fc = (mo - lo) / (hi - lo)
    if u < fc:
        return lo + math.sqrt((mo - lo) * (hi - lo) * u)
    return hi - math.sqrt((hi - mo) * (hi - lo) * (1.0 - u))

"""getrandbits(k) -> i64 with k random bits (1 <= k <= 62)."""
fn getrandbits(k):
    if k < 1 or k > 62:
        core.panic("getrandbits: k must be in [1, 62]")
    st = _gload_i()
    if k <= 31:
        st = _pm_step(st)
        v = (st - 1) % _pow2(k)
        _gstore_i(st)
        return v
    hi_bits = k - 31
    st = _pm_step(st)
    hi = (st - 1) % _pow2(hi_bits)
    st = _pm_step(st)
    lo = st - 1
    _gstore_i(st)
    return hi * 2147483648 + lo

"""randbytes(n) -> [i64] of n bytes in 0..255."""
fn randbytes(n):
    out = []
    i = 0
    while i < n:
        out.append(_grandbelow(256))
        i = i + 1
    return out

"""gauss(mu, sigma) -> normally distributed float (global stream)."""
fn gauss(mu, sigma):
    r = _load()
    v = r.gauss(mu, sigma)
    _store(r)
    return v

"""normalvariate(mu, sigma) -> alias of gauss (global stream)."""
fn normalvariate(mu, sigma):
    r = _load()
    v = r.normalvariate(mu, sigma)
    _store(r)
    return v

"""expovariate(lambd) -> exponentially distributed float (global stream)."""
fn expovariate(lambd):
    r = _load()
    v = r.expovariate(lambd)
    _store(r)
    return v

"""gammavariate(alpha, beta) -> Gamma-distributed float (global stream)."""
fn gammavariate(alpha, beta):
    r = _load()
    v = r.gammavariate(alpha, beta)
    _store(r)
    return v

"""betavariate(alpha, beta) -> Beta-distributed float in [0, 1] (global stream)."""
fn betavariate(alpha, beta):
    r = _load()
    v = r.betavariate(alpha, beta)
    _store(r)
    return v

