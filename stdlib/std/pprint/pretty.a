# std.pprint.pretty — CPython `pprint` port (part 1: PrettyPrinter engine).
#
# CPython `pprint` pretty-prints Python objects to a stream with width/
# depth/indent controls. This port reproduces the core algorithm:
#
#   * `_safe_repr(object, context, maxlevels, level)` -> (text, readable,
#     recursive) triple, powering `saferepr`/`isreadable`/`isrecursive`.
#   * `_format`/`_format_items`/`_format_dict_items` — the width-aware
#     line-breaking writer, ported from CPython 3.14 `pprint.py`.
#
# Port notes (see README.md):
#   * Output goes to stdout (`pprint`) or a returned string (`pformat`);
#     there is no `stream=` parameter.
#   * Recursion detection uses a `{object: true}` context map. A hashes
#     arrays/maps/sets/structs/Json by identity, matching CPython's
#     `id(object)` keys. `_recursion` markers omit the id (A has none).
#   * Dispatch is by `json.kind` + `json.as_array`/`as_map` probes +
#     `str` prefix for sets/tuples, instead of `type(object).__repr__`.
#   * Sets and tuples are decomposed via the `binary` codec
#     (encode -> decode -> Json array) because A tuples cannot be iterated;
#     elements surface as `Json` and nested tuples/sets degrade to lists.
#   * Dict keys are emitted in insertion order; `sort_dicts` sorts only when
#     every key is a string (A cannot safely sort heterogeneous keys —
#     CPython falls back to unsorted via `_safe_key` anyway).
#   * Strings that exceed the width are wrapped in parentheses with chunks
#     on continuation lines — an approximation of CPython's word-based
#     `_pprint_str` (no regex engine in A).
#   * `underscore_numbers` is honored for ints; `compact` is honored.
import json
import binary
import core

## _slice(s, start, end) -> substring s[start:end] (chars, end exclusive).
fn _slice(s, start, end):
    cs = s.chars()
    out = ""
    i = start
    while i < end and i < len(cs):
        out = out + str(cs[i])
        i = i + 1
    return out

## _floordiv(a, b) -> floor(a / b) for b > 0.
fn _floordiv(a, b):
    q = a / b
    if a < 0 and a % b != 0:
        q = q - 1
    return q

## _max(a, b) -> larger of two ints.
fn _max(a: i64, b: i64) -> i64:
    if a > b:
        return a
    return b

## _py_str_repr(s) -> Python-style repr of a string (single quotes,
## escapes for backslash, the quote char, \n, \t, \r).
fn _py_str_repr(s):
    quote = "'"
    if s.contains("'") and not s.contains("\""):
        quote = "\""
    out = quote
    for c in s:
        sc = str(c)
        if sc == "\\":
            out = out + "\\\\"
        elif sc == quote:
            out = out + "\\" + quote
        elif sc == "\n":
            out = out + "\\n"
        elif sc == "\t":
            out = out + "\\t"
        elif sc == "\r":
            out = out + "\\r"
        else:
            out = out + sc
    out = out + quote
    return out

## _seq_kind(x) -> "set" | "tuple" | "other" for kind=="array" non-lists.
fn _seq_kind(x):
    s = str(x)
    if s.startswith("{"):
        return "set"
    if s.startswith("("):
        return "tuple"
    return "other"

## _items(x) -> [Json] elements for native sets/tuples via binary codec.
fn _items(x):
    d = binary.decode(binary.encode(x))
    if d == None:
        return []
    return (json.as_array(d!) ?? [])

## _keys(mm) -> [key] collected from a (possibly non-string-keyed) map.
fn _keys(mm):
    ks = []
    for k in mm:
        ks.append(k)
    return ks

## _all_strings(ks) -> true when every key's json.kind is "string".
fn _all_strings(ks):
    for k in ks:
        if json.kind(k) != "string":
            return false
    return true

## _sorted_keys(mm, ks, sort_dicts) -> ks, sorted when safe.
fn _sorted_keys(mm, ks, sort_dicts):
    if sort_dicts and _all_strings(ks):
        out = []
        for k in ks:
            out.append(k)
        out.sort()
        return out
    return ks

## _underscore_int(i) -> str(i) with '_' thousands separators
## (Python `f"{i:_d}"` / underscore_numbers=True).
fn _underscore_int(i: i64):
    s = str(i)
    neg = s.startswith("-")
    digits = s
    if neg:
        digits = _slice(s, 1, len(s))
    n = len(digits)
    first = n % 3
    out = ""
    idx = 0
    if first > 0:
        out = _slice(digits, 0, first)
        idx = first
    while idx < n:
        if out != "":
            out = out + "_"
        out = out + _slice(digits, idx, idx + 3)
        idx = idx + 3
    if neg:
        out = "-" + out
    return out

## _recursion_name(x) -> type word for '<Recursion on ...>' markers.
fn _recursion_name(x):
    kind = json.kind(x)
    if kind == "array":
        if json.as_array(x) != None:
            return "list"
        t = _seq_kind(x)
        if t == "set":
            return "set"
        if t == "tuple":
            return "tuple"
        return "list"
    if kind == "object":
        return "dict"
    return "object"

## _recursion(x) -> '<Recursion on TYPE>' (CPython includes id=...; A has no
## stable object id, so the id is omitted — documented deviation).
fn _recursion(x):
    return "<Recursion on " + _recursion_name(x) + ">"

## SafeRepr — (text, readable, recursive) triple from _safe_repr
## (CPython returns a plain tuple; A tuples cannot be indexed).
struct SafeRepr:
    text: str
    readable: bool
    recursive: bool

## Buf — mutable string sink for _format (CPython writes to a stream).
struct Buf:
    parts: [str]

    fn put(self, s):
        self.parts.append(s)

    fn text(self):
        return "".join(self.parts)

## PrettyPrinter — configurable pretty-printer (CPython
## `pprint.PrettyPrinter`).
##
## Constructor field order (positional, no defaults in A):
##   indent, width, depth, compact, sort_dicts, underscore_numbers
## `depth <= 0` means unlimited (CPython `depth=None`; note CPython also
## treats depth=0 as unlimited since 0 is falsy).
## There is no `stream` field: `pprint` writes to stdout, `pformat`
## returns the string.
struct PrettyPrinter:
    indent: i64
    width: i64
    depth: i64
    compact: bool
    sort_dicts: bool
    underscore_numbers: bool
    _readable: bool
    _recursive: bool

    ## pprint(self, object) -> pretty-print to stdout + newline.
    fn pprint(self, object):
        buf = Buf([])
        self._format(object, buf, 0, 0, {}, 0)
        print(buf.text())

    ## pformat(self, object) -> pretty-printed string (no trailing newline).
    fn pformat(self, object):
        buf = Buf([])
        self._format(object, buf, 0, 0, {}, 0)
        return buf.text()

    ## isrecursive(self, object) -> bool (CPython PrettyPrinter.isrecursive).
    fn isrecursive(self, object):
        r = self._safe_repr(object, {}, 0, 0)
        return r.recursive

    ## isreadable(self, object) -> bool (CPython PrettyPrinter.isreadable).
    fn isreadable(self, object):
        r = self._safe_repr(object, {}, 0, 0)
        return r.readable and not r.recursive

    ## _format(self, object, buf, indent, allowance, context, level)
    ## -> width-aware writer (port of CPython PrettyPrinter._format).
    fn _format(self, object, buf, indent, allowance, context, level):
        if object in context:
            buf.put(_recursion(object))
            self._recursive = true
            self._readable = false
            return
        rep = self._repr(object, context, level)
        if not rep.readable:
            self._readable = false
        if rep.recursive:
            self._recursive = true
        max_width = self.width - indent - allowance
        if len(rep.text) > max_width:
            kind = json.kind(object)
            dispatched = false
            if kind == "object" and json.as_map(object) != None:
                context[object] = true
                self._pprint_dict(object, buf, indent, allowance, context, level + 1)
                context.pop(object)
                dispatched = true
            elif kind == "array":
                if json.as_array(object) != None:
                    context[object] = true
                    self._pprint_list(object, buf, indent, allowance, context, level + 1)
                    context.pop(object)
                    dispatched = true
                else:
                    t = _seq_kind(object)
                    if t == "set":
                        context[object] = true
                        self._pprint_set(object, buf, indent, allowance, context, level + 1)
                        context.pop(object)
                        dispatched = true
                    elif t == "tuple":
                        context[object] = true
                        self._pprint_tuple(object, buf, indent, allowance, context, level + 1)
                        context.pop(object)
                        dispatched = true
            elif kind == "string":
                context[object] = true
                self._pprint_str(object, buf, indent, allowance, context, level + 1)
                context.pop(object)
                dispatched = true
            if dispatched:
                return
        buf.put(rep.text)

    ## _pprint_dict(self, object, buf, indent, allowance, context, level)
    fn _pprint_dict(self, object, buf, indent, allowance, context, level):
        buf.put("{")
        if self.indent > 1:
            buf.put(" ".repeat(self.indent - 1))
        mm = (json.as_map(object))!
        ks = _sorted_keys(mm, _keys(mm), self.sort_dicts)
        if len(ks) > 0:
            self._format_dict_items(mm, ks, buf, indent, allowance + 1, context, level)
        buf.put("}")

    ## _format_dict_items(self, mm, ks, buf, indent, allowance, context, level)
    fn _format_dict_items(self, mm, ks, buf, indent, allowance, context, level):
        indent = indent + self.indent
        delimnl = ",\n" + " ".repeat(indent)
        last_index = len(ks) - 1
        i = 0
        while i < len(ks):
            last = i == last_index
            k = ks[i]
            rep = self._repr(k, context, level)
            buf.put(rep.text)
            buf.put(": ")
            self._format(mm[k], buf, indent + len(rep.text) + 2,
                         allowance if last else 1, context, level)
            if not last:
                buf.put(delimnl)
            i = i + 1

    ## _pprint_list(self, object, buf, indent, allowance, context, level)
    fn _pprint_list(self, object, buf, indent, allowance, context, level):
        buf.put("[")
        elems = (json.as_array(object))!
        self._format_items(elems, buf, indent, allowance + 1, context, level)
        buf.put("]")

    ## _pprint_set(self, object, buf, indent, allowance, context, level)
    fn _pprint_set(self, object, buf, indent, allowance, context, level):
        if len(object) == 0:
            buf.put(_py_str_repr("") if false else "set()")
            return
        buf.put("{")
        elems = _items(object)
        self._format_items(elems, buf, indent, allowance + 1, context, level)
        buf.put("}")

    ## _pprint_tuple(self, object, buf, indent, allowance, context, level)
    fn _pprint_tuple(self, object, buf, indent, allowance, context, level):
        elems = _items(object)
        n = len(elems)
        if n == 0:
            buf.put("()")
            return
        buf.put("(")
        endchar_len = 1
        if n == 1:
            endchar_len = 2
        self._format_items(elems, buf, indent, allowance + endchar_len, context, level)
        if n == 1:
            buf.put(",)")
        else:
            buf.put(")")

    ## _pprint_str(self, object, buf, indent, allowance, context, level)
    ## -> over-width string wrapping (approximation of CPython's
    ## word-based chunking; chunks are split on character boundaries).
    fn _pprint_str(self, object, buf, indent, allowance, context, level):
        rep = _py_str_repr(object)
        avail = self.width - indent - allowance
        if avail < 8:
            avail = 8
        if len(rep) <= avail:
            buf.put(rep)
            return
        buf.put("(")
        chunk = avail - 2
        if chunk < 4:
            chunk = 4
        cs = object.chars()
        n = len(cs)
        inner_indent = indent + 1
        sep = "\n" + " ".repeat(inner_indent)
        i = 0
        first = true
        while i < n:
            take = chunk
            if n - i < take:
                take = n - i
            piece = ""
            j = 0
            while j < take:
                piece = piece + str(cs[i + j])
                j = j + 1
            if not first:
                buf.put(sep)
            buf.put(_py_str_repr(piece))
            i = i + take
            first = false
        buf.put(")")

    ## _format_items(self, elems, buf, indent, allowance, context, level)
    ## -> port of CPython PrettyPrinter._format_items (compact/width logic).
    fn _format_items(self, elems, buf, indent, allowance, context, level):
        indent = indent + self.indent
        if self.indent > 1:
            buf.put(" ".repeat(self.indent - 1))
        delimnl = ",\n" + " ".repeat(indent)
        delim = ""
        max_width = self.width - indent + 1
        width = max_width
        n = len(elems)
        i = 0
        while i < n:
            ent = elems[i]
            last = i == n - 1
            if last:
                max_width = max_width - allowance
                width = width - allowance
            if self.compact:
                rep = self._repr(ent, context, level)
                w = len(rep.text) + 2
                if width < w:
                    width = max_width
                    if delim != "":
                        delim = delimnl
                if width >= w:
                    width = width - w
                    buf.put(delim)
                    delim = ", "
                    buf.put(rep.text)
                    i = i + 1
                    continue
            buf.put(delim)
            delim = delimnl
            self._format(ent, buf, indent, allowance if last else 1, context, level)
            i = i + 1

    ## _repr(self, object, context, level) -> SafeRepr on a context copy
    ## (CPython: self.format(object, context.copy(), self._depth, level)).
    fn _repr(self, object, context, level):
        r = self._safe_repr(object, context.copy(), self.depth, level)
        if not r.readable:
            self._readable = false
        if r.recursive:
            self._recursive = true
        return r

    ## _safe_repr(self, object, context, maxlevels, level) -> SafeRepr
    ## (port of CPython PrettyPrinter._safe_repr).
    fn _safe_repr(self, object, context, maxlevels, level):
        kind = json.kind(object)

        # -- scalar atoms -------------------------------------------------
        if kind == "null":
            return SafeRepr("None", true, false)
        if kind == "bool":
            if object:
                return SafeRepr("True", true, false)
            return SafeRepr("False", true, false)
        if kind == "number":
            if json.as_int(object) != None:
                if self.underscore_numbers:
                    return SafeRepr(_underscore_int(object), true, false)
                return SafeRepr(str(object), true, false)
            return SafeRepr(str(object), true, false)
        if kind == "string":
            return SafeRepr(_py_str_repr(object), true, false)

        # -- array-kind: list | set | tuple --------------------------------
        if kind == "array":
            arr = json.as_array(object)
            if arr != None:
                n = len(arr)
                if n == 0:
                    return SafeRepr("[]", true, false)
                if maxlevels > 0 and level >= maxlevels:
                    return SafeRepr("[...]", false, object in context)
                if object in context:
                    return SafeRepr(_recursion(object), false, true)
                context[object] = true
                readable = true
                recursive = false
                parts = []
                level = level + 1
                for e in arr:
                    r = self._safe_repr(e, context, maxlevels, level)
                    parts.append(r.text)
                    if not r.readable:
                        readable = false
                    if r.recursive:
                        recursive = true
                context.pop(object)
                return SafeRepr("[" + ", ".join(parts) + "]", readable, recursive)
            t = _seq_kind(object)
            if t == "set":
                n = len(object)
                if n == 0:
                    return SafeRepr("set()", true, false)
                if maxlevels > 0 and level >= maxlevels:
                    return SafeRepr("{...}", false, object in context)
                if object in context:
                    return SafeRepr(_recursion(object), false, true)
                context[object] = true
                elems = _items(object)
                readable = true
                recursive = false
                parts = []
                level = level + 1
                for e in elems:
                    r = self._safe_repr(e, context, maxlevels, level)
                    parts.append(r.text)
                    if not r.readable:
                        readable = false
                    if r.recursive:
                        recursive = true
                context.pop(object)
                return SafeRepr("{" + ", ".join(parts) + "}", readable, recursive)
            if t == "tuple":
                elems = _items(object)
                n = len(elems)
                if n == 0:
                    return SafeRepr("()", true, false)
                if maxlevels > 0 and level >= maxlevels:
                    return SafeRepr("(...)", false, object in context)
                if object in context:
                    return SafeRepr(_recursion(object), false, true)
                context[object] = true
                readable = true
                recursive = false
                parts = []
                level = level + 1
                for e in elems:
                    r = self._safe_repr(e, context, maxlevels, level)
                    parts.append(r.text)
                    if not r.readable:
                        readable = false
                    if r.recursive:
                        recursive = true
                context.pop(object)
                if n == 1:
                    return SafeRepr("(" + parts[0] + ",)", readable, recursive)
                return SafeRepr("(" + ", ".join(parts) + ")", readable, recursive)
            # Other array-kind values (should not occur): leaf repr.
            rep = str(object)
            return SafeRepr(rep, len(rep) > 0 and not rep.startswith("<"), false)

        # -- object-kind: dict | struct | Json object ----------------------
        if kind == "object":
            mm = json.as_map(object)
            if mm != None:
                ks = _sorted_keys(mm, _keys(mm), self.sort_dicts)
                n = len(ks)
                if n == 0:
                    return SafeRepr("{}", true, false)
                if maxlevels > 0 and level >= maxlevels:
                    return SafeRepr("{...}", false, object in context)
                if object in context:
                    return SafeRepr(_recursion(object), false, true)
                context[object] = true
                readable = true
                recursive = false
                parts = []
                level = level + 1
                for k in ks:
                    kr = self._safe_repr(k, context, maxlevels, level)
                    vr = self._safe_repr(mm[k], context, maxlevels, level)
                    parts.append(kr.text + ": " + vr.text)
                    if not kr.readable or not vr.readable:
                        readable = false
                    if kr.recursive or vr.recursive:
                        recursive = true
                context.pop(object)
                return SafeRepr("{" + ", ".join(parts) + "}", readable, recursive)
            rep = str(object)
            return SafeRepr(rep, len(rep) > 0 and not rep.startswith("<"), false)

        # -- everything else (ranges, closures, results, None handled above)
        rep = str(object)
        return SafeRepr(rep, len(rep) > 0 and not rep.startswith("<"), false)
