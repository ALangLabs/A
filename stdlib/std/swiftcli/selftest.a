# std.swiftcli selftest — parser behavior, coercion, help, errors, subcommands.
# Run: ./build/a test stdlib/std/swiftcli/selftest.a
import swiftcli

fn _p():
    p = swiftcli.new("tool", "desc", "1.2.3")
    p.flag("-v, --verbose", "verbose")
    p.count("-q, --quiet", "quiet")
    p.option("-n, --name", "world", "who")
    p.int_option("-r, --repeat", 1, "times")
    p.float_option("--rate", 0.5, "rate")
    p.bool_option("--feature", true, "feat")
    p.choice("-e, --env", ["dev", "prod"], "dev", "env")
    p.list_option("-t, --tag", "tag")
    p.positional("words", "extra", "*")
    return p

fn test_basics():
    r = _p().parse(["-n", "A", "--repeat", "3", "-v", "-qqq", "-t", "x", "-t=y", "--", "-n"])
    assert(r.kind == "ok")
    assert_eq(r.ns["name"], "A")
    assert_eq(r.ns["repeat"], 3)
    assert_eq(r.ns["verbose"], true)
    assert_eq(r.ns["quiet"], 3)
    assert_eq(r.ns["tag"], ["x", "y"])
    assert_eq(r.ns["words"], ["-n"])

fn test_defaults_and_env():
    r = _p().parse([])
    assert_eq(r.ns["name"], "world")
    assert_eq(r.ns["repeat"], 1)
    assert_eq(r.ns["rate"], 0.5)
    assert_eq(r.ns["env"], "dev")
    assert_eq(r.ns["feature"], true)

fn test_inline_and_cluster():
    r = _p().parse(["--name=B", "-nC", "--rate=2.5", "--feature=false", "--no-feature"])
    # last write wins for single-value options
    assert_eq(r.ns["name"], "C")
    assert_eq(r.ns["rate"], 2.5)
    assert_eq(r.ns["feature"], false)

fn test_bool_negation():
    r = _p().parse(["--no-feature"])
    assert_eq(r.ns["feature"], false)
    r2 = _p().parse(["--feature=true"])
    assert_eq(r2.ns["feature"], true)

fn test_list_option():
    r = _p().parse(["-ta", "--tag", "b", "--tag=c"])
    assert_eq(r.ns["tag"], ["a", "b", "c"])

fn test_positionals_star_plus():
    p = swiftcli.new("p")
    p.positional("first")
    p.positional("rest", "", "*")
    r = p.parse(["a"])
    assert_eq(r.ns["first"], "a")
    assert_eq(r.ns["rest"], [])
    r2 = p.parse(["a", "b", "c"])
    assert_eq(r2.ns["rest"], ["b", "c"])

    q = swiftcli.new("q")
    q.positional("req", "", "+")
    r3 = q.parse([])
    assert_eq(r3.kind, "error")
    r4 = q.parse(["x", "y"])
    assert_eq(r4.ns["req"], ["x", "y"])

fn test_optional_positional():
    p = swiftcli.new("p")
    p.positional("maybe", "", "?")
    r = p.parse([])
    assert_eq(r.ns["maybe"], None)
    r2 = p.parse(["v"])
    assert_eq(r2.ns["maybe"], "v")

fn test_errors():
    r = _p().parse(["--bogus"])
    assert_eq(r.kind, "error")
    assert(r.error.contains("unrecognized option"))
    r2 = _p().parse(["-z"])
    assert_eq(r2.kind, "error")
    r3 = _p().parse(["--repeat", "abc"])
    assert_eq(r3.kind, "error")
    assert(r3.error.contains("invalid int"))
    r4 = _p().parse(["--env", "staging"])
    assert_eq(r4.kind, "error")
    assert(r4.error.contains("invalid choice"))
    r5 = _p().parse(["--repeat"])
    assert_eq(r5.kind, "error")
    assert(r5.error.contains("requires a value"))
    # unrecognized trailing positional
    p2 = swiftcli.new("p2")
    p2.positional("one")
    r6 = p2.parse(["a", "b"])
    assert_eq(r6.kind, "error")
    assert(r6.error.contains("unrecognized arguments"))

fn test_required():
    p = swiftcli.new("p")
    p.option("--token")
    p.require("token")
    r = p.parse([])
    assert_eq(r.kind, "error")
    assert(r.error.contains("missing required"))
    r2 = p.parse(["--token", "t"])
    assert_eq(r2.kind, "ok")

fn test_prefix_and_ambiguous():
    p = swiftcli.new("p")
    p.flag("--verbose")
    p.flag("--version-x")
    r = p.parse(["--ver"])
    assert_eq(r.kind, "error")
    assert(r.error.contains("ambiguous"))
    r1b = p.parse(["--verb"])
    assert_eq(r1b.kind, "ok")
    assert_eq(r1b.ns["verbose"], true)
    p2 = swiftcli.new("p2")
    p2.flag("--verbose")
    p2.flag("--verify")
    r2 = p2.parse(["--verbo"])
    assert_eq(r2.kind, "ok")
    assert_eq(r2.ns["verbose"], true)

fn test_subcommands():
    p = swiftcli.new("tool", "", "1.0")
    p.positional("file", "", "?")
    sub = p.subcommand("serve", "serve it")
    sub.option("--port", "80")
    r = p.parse(["myfile.txt", "serve", "--port", "9"])
    assert_eq(r.kind, "ok")
    assert_eq(r.ns["command"], "serve")
    assert_eq(r.ns["file"], "myfile.txt")
    assert_eq(r.ns["port"], "9")
    r2 = p.parse(["serve", "--help"])
    assert_eq(r2.kind, "help")
    assert_eq(r2.command, "serve")

fn test_help_version():
    r = _p().parse(["--help"])
    assert_eq(r.kind, "help")
    assert(r.text.contains("Usage: tool"))
    assert(r.text.contains("--verbose"))
    assert(r.text.contains("--version"))
    r2 = _p().parse(["--version"])
    assert_eq(r2.kind, "version")
    assert_eq(r2.text, "1.2.3")

fn test_split_args():
    a = swiftcli.split_args("-n 'a b' --x=\"c d\" plain")
    assert_eq(a, ["-n", "a b", "--x=c d", "plain"])

fn test_or_panic_error():
    r = swiftcli.new("p").parse(["--nope"])
    # or_panic would panic; just check kind here
    assert_eq(r.kind, "error")

fn assert_eq(a, b):
    assert(a == b)
