#
# Loaded before every program by the module loader
# (see `compiler/astra/frontend/name-resolution/module_loader.cpp`); users access
# it via `import prelude`. Everything declared here is namespaced under
# `prelude.*`, so no global name clashes. Native modules (`math`, `io`,
# `fs`, `strings`, `collections`, `core`, `time`, `json`, `binary`,
# `testing`, `log`, `metrics`, `trace`, `net`, `http`) are untouched.
import std:core

fn prelude_version():
    return "0.0.1"

class Vec4:
    x
    y
    z
    w

    fn get(self, i):
        if i == 0:
            return self.x
        elif i == 1:
            return self.y
        elif i == 2:
            return self.z
        else:
            return self.w

    fn to_list(self):
        return [self.x, self.y, self.z, self.w]

    fn add(self, other):
        return Vec4(self.x + other.x, self.y + other.y, self.z + other.z, self.w + other.w)

    fn scale(self, s):
        return Vec4(self.x * s, self.y * s, self.z * s, self.w * s)

    fn dot(self, other):
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w

    fn sum(self):
        return self.x + self.y + self.z + self.w

class Result:
    ok
    value
    error

fn Ok(value):
    return Result(true, value, None)

fn Err(message):
    return Result(false, None, message)

fn unwrap(r):
    if r.ok:
        return r.value
    else:
        core.panic(r.error)

fn is_ok(r):
    return r.ok

fn is_err(r):
    return not r.ok

fn unwrap_or(r, fallback):
    if r.ok:
        return r.value
    else:
        return fallback

fn err_value(r):
    return r.error

# Higher-order helpers. Function parameters are typed so the checker can verify
fn map_result(r, f: fn(i64) -> i64):
    if r.ok:
        return Ok(f(r.value))
    return r

fn and_then(r, f: fn(i64) -> Result) -> Result:
    if r.ok:
        return f(r.value)
    return r

fn vectorize(f: fn(i64) -> i64, xs: [i64]) -> [i64]:
    return map(xs, f)

# Debug inspection (litprinter-style). `ic(...)` is desugared by the
# compiler into ic_impl(context, labels, *values): the context string and
# one source label per argument are injected as hidden leading arguments.
# ic(x) -> x, ic(x, y, ...) -> [x, y, ...], ic() -> None.

fn _ic_align(text: String, width: i64) -> String:
    lines = text.split("\n")
    if len(lines) <= 1:
        return text
    pad = ""
    i = 0
    while i < width + 2:
        pad += " "
        i += 1
    out = lines[0]
    i = 1
    while i < len(lines):
        if len(lines[i]) > 0:
            out += "\n" + pad + lines[i]
        else:
            out += "\n"
        i += 1
    return out

fn _ic_render(ctx: String, labels: [String], values):
    if len(values) == 0:
        eprint("ic| " + ctx)
        return None
    head = "ic| "
    if len(ctx) > 0:
        head = head + "[" + ctx + "] >>> "
    parts = []
    i = 0
    for v in values:
        r = repr(v)
        if i < len(labels) and len(labels[i]) > 0:
            r = labels[i] + ": " + r
        parts.append(r)
        i += 1
    body = ", ".join(parts)
    eprint(head + _ic_align(body, len(head)))
    if len(values) == 1:
        return values[0]
    return values

fn ic_impl(ctx: String, labels: [String], *values):
    return _ic_render(ctx, labels, values)

fn ic(*values):
    labels = []
    for v in values:
        labels.append("")
    return _ic_render("", labels, values)

fn __ic_format__(*args):
    ctx = args[0]
    if len(args) == 1:
        return "ic| " + ctx
    label = args[1]
    head = "ic| [" + ctx + "] >>> "
    if len(args) == 2:
        return head + _ic_align(label, len(head))
    return head + _ic_align(label + ": " + repr(args[2]), len(head))
