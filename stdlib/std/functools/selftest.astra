# std.functools selftest — partial/reduce/cache/lru_cache/sort_by/singledispatch.
# Run: ./build/a test stdlib/std/functools/selftest.a
from "std/functools/__init__.astra" import Partial, partial, partial1, partial2, partial3, partial4, CacheInfo, LRUCache, lru_cache, cache, sort_by, Dispatcher, singledispatch, reduce, reduce_init

fn assert_eq(a, b):
    assert(a == b)

fn assert_true(c):
    assert(c)

fn _add3(a, b, c):
    return a + b + c

fn _cat(a, b):
    return a + b

fn test_partial():
    p = partial1(_add3, 1)
    # partial1 binds only the first arg; remaining args via .call
    assert_eq(p.call([2, 3]), 6)
    p2 = partial3(_add3, 1, 2, 3)
    assert_eq(p2.call([]), 6)
    p3 = partial(_cat, [10])
    assert_eq(p3.call([5]), 15)
    # fields are public like Python's .func/.args
    assert_eq(p2.func, _add3)
    assert_eq(p2.bound, [1, 2, 3])

fn test_reduce():
    assert_eq(reduce(_cat, [1, 2, 3, 4]), 10)
    assert_eq(reduce_init(_cat, [1, 2, 3], 100), 106)
    assert_eq(reduce_init(_cat, [], 42), 42)

fn test_lru_cache():
    c = lru_cache(_add3, 0)
    a1 = []
    a1.append(1)
    a1.append(2)
    a1.append(3)
    assert_eq(c.call(a1), 6)
    # second identical call hits the cache
    assert_eq(c.call(a1), 6)
    info = c.cache_info()
    assert_eq(info.hits, 1)
    assert_eq(info.misses, 1)
    assert_eq(info.currsize, 1)
    c.cache_clear()
    assert_eq(c.cache_info().currsize, 0)
    # bounded eviction
    b = lru_cache(_cat, 2)
    b.call([1])
    b.call([2])
    b.call([3])
    assert_eq(b.cache_info().currsize, 2)
    # cache_parameters mirrors Python's mapping
    params = c.cache_parameters()
    assert_eq(params["typed"], false)
    assert_eq(params["maxsize"], 0)
    # user_function is stored (function values are not comparable with ==)
    assert(params.contains("user_function"))

fn test_cache_unbounded():
    c = cache(_cat)
    assert_eq(c.call([5]), 5)
    assert_eq(c.cache_info().maxsize, 0)

fn test_sort_by():
    xs = [3, 1, 2]
    out = sort_by(xs, fn_cmp_desc)
    assert_eq(out, [3, 2, 1])
    # original not mutated
    assert_eq(xs, [3, 1, 2])
    evens = sort_by([4, 1, 3, 2], fn_cmp_asc)
    assert_eq(evens, [1, 2, 3, 4])

fn fn_cmp_desc(a, b):
    return b - a

fn fn_cmp_asc(a, b):
    return a - b

fn _show(x):
    # NOTE: comparing x to numeric literals miscompiles when x is a
    # string under `a test`; the default impl just tags the kind.
    return "default"

fn test_singledispatch():
    d = singledispatch(_show)
    d.register("int", fn_int)
    d.register("float", fn_float)
    args = []
    args.append(7)
    assert_eq(d.call(args), "int-7")
    args2 = []
    args2.append(2.5)
    assert_eq(d.call(args2), "float")
    args3 = []
    args3.append("hi")
    assert_eq(d.call(args3), "default")

fn fn_int(x):
    return "int-" + str(x)

fn fn_float(x):
    return "float"
