# std.functools.cache / lru_cache (CPython functools memoization port).
#
# CPython exposes `cache` (= `lru_cache(maxsize=None)`) and `lru_cache` as
# decorators producing a wrapper with the same signature as the wrapped
# function. A has no decorators and no callable objects, so this port returns
# an `LRUCache` record invoked via `.call(args)` (array of call arguments).
#
# Deviations vs CPython:
#   * `@cache` / `@lru_cache(...)` decorator syntax -> `c = cache(fn)` /
#     `c = lru_cache(fn, maxsize)`; invoke with `c.call(args)`.
#   * keyword arguments in the cache key -> not supported (A named args are
#     interop-only); only positional arguments participate in the key.
#   * unhashable arguments (arrays, maps) -> A map keys hash arrays by
#     identity, so such calls simply never hit; CPython would raise TypeError.
#       Scalars, strings and tuples of hashables key by value.
#   * eviction maintains true LRU order in an `order` array (O(n) per
#     hit/miss; CPython uses a linked list).
#   * maxsize <= 0 means unbounded (like CPython's None).
#   * at most 8 call arguments (`_apply`/`_key` limit).
#   * `cache_info()` returns a `CacheInfo` struct instead of a namedtuple.
#   * `cache_parameters()` is not provided.
from "_apply.a" import _apply, _key

## CacheInfo mirrors the fields of CPython's `functools._CacheInfo`
## namedtuple: (hits, misses, maxsize, currsize).
struct CacheInfo:
    hits
    misses
    maxsize
    currsize

## LRUCache memoizes calls to `func`. Fields are public so advanced users can
## inspect/reset state; prefer the methods.
struct LRUCache:
    func
    cache      # {key: value}
    order      # [key] in least->most recently used order
    maxsize: i64
    hits: i64
    misses: i64

    ## call(self, args) -> memoized `func(args...)`.
    fn call(self, args):
        key = _key(args)
        if self.cache.contains(key):
            self.hits = self.hits + 1
            # Refresh recency: move key to the most-recently-used end.
            self.order.remove(key)
            self.order.append(key)
            return self.cache[key]
        self.misses = self.misses + 1
        value = _apply(self.func, args)
        self.cache[key] = value
        if self.maxsize > 0 and len(self.cache) > self.maxsize:
            oldest = self.order[0]
            self.cache.pop(oldest)
            self.order.remove_at(0)
        self.order.append(key)
        return value

    ## cache_clear(self) -> drop all cached values (hits/misses kept).
    fn cache_clear(self):
        self.cache = {}
        self.order = []

    ## cache_info(self) -> CacheInfo snapshot (hits, misses, maxsize, currsize).
    fn cache_info(self):
        return CacheInfo(self.hits, self.misses, self.maxsize, len(self.cache))

## lru_cache(func, maxsize) -> LRUCache wrapping `func`.
## `maxsize <= 0` gives an unbounded cache (CPython `maxsize=None`).
fn lru_cache(func, maxsize):
    return LRUCache(func, {}, [], maxsize, 0, 0)

## cache(func) -> unbounded memoizing wrapper (CPython `functools.cache`).
fn cache(func):
    return LRUCache(func, {}, [], 0, 0, 0)
