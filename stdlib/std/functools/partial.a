# std.functools.partial (CPython functools.partial port).
#
# CPython: `partial(func, /, *args, **keywords)` returns a callable that
# prepends `args`/`keywords` to every call. A has no `*args`, no callable
# objects (`__call__` is not dispatched), and named arguments are only
# supported for `import python:` interop objects, so this port is
# positional-only and returns a `Partial` record invoked via `.call(args)`.
#
# Deviations vs CPython:
#   * `p(*more)`            -> `p.call(more)` where `more` is an array.
#   * keyword binding       -> not supported (A named args are interop-only).
#   * `p.func` / `p.args`   -> `.func` / `.bound` fields (`.keywords` absent).
#   * `p.keywords`          -> absent.
#   * arbitrary arity       -> at most 8 total call arguments (`_apply`).
#   * partial objects are not themselves callable values.
from "_apply.a" import _apply

## Partial is the A analogue of a `functools.partial` object.
## `func` is the wrapped callable; `bound` is the array of pre-bound
## positional arguments. Call the remaining arguments with `.call(args)`.
struct Partial:
    func
    bound

    ## call(self, args) -> result of `func(bound..., args...)`.
    fn call(self, args):
        return _apply(self.func, self.bound + args)

## partial(func, bound) -> Partial binding the positional arguments in the
## `bound` array. Build heterogeneous `bound` arrays with `[]` + `append`
## (array literals require homogeneous element types).
fn partial(func, bound):
    return Partial(func, bound)

## Convenience constructors for the common small-arity cases.
fn partial1(func, a):
    bound = []
    bound.append(a)
    return Partial(func, bound)

fn partial2(func, a, b):
    bound = []
    bound.append(a)
    bound.append(b)
    return Partial(func, bound)

fn partial3(func, a, b, c):
    bound = []
    bound.append(a)
    bound.append(b)
    bound.append(c)
    return Partial(func, bound)

fn partial4(func, a, b, c, d):
    bound = []
    bound.append(a)
    bound.append(b)
    bound.append(c)
    bound.append(d)
    return Partial(func, bound)
