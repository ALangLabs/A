# std.fractions — port of Python 3.14 Lib/fractions.py (Fraction class).
#
# Exact rational arithmetic: numerator/denominator kept normalised
# (denominator > 0, gcd-reduced). Python raises exceptions; here contract
# violations are core.panic. `Fraction(v)` accepts i64, f64 (exact binary
# ratio via Fraction_from_float) and "n/d" strings are NOT parsed (A has no
# string->number split API need; use Fraction_new).
import std:math
import std:core
import std:json

fn _gcd_i(a: i64, b: i64) -> i64:
    x = a < 0 ? -a : a
    y = b < 0 ? -b : b
    while y != 0:
        t = x % y
        x = y
        y = t
    return x == 0 ? 1 : x

fn _floor_div(a: i64, b: i64) -> i64:
    q = a / b
    r = a % b
    if r != 0 and ((r < 0) != (b < 0)):
        q = q - 1
    return q

fn _pow2i(n: i64) -> i64:
    r = 1
    i = 0
    while i < n:
        r = r * 2
        i = i + 1
    return r

"""Fraction: exact rational n/d (fields public like Python's ._numerator)."""
class Fraction:
    n
    d

    fn numerator(self):
        return self.n

    fn denominator(self):
        return self.d

    fn add(self, other):
        return _mk(self.n * other.d + other.n * self.d, self.d * other.d)

    fn sub(self, other):
        return _mk(self.n * other.d - other.n * self.d, self.d * other.d)

    fn mul(self, other):
        return _mk(self.n * other.n, self.d * other.d)

    fn truediv(self, other):
        if other.n == 0:
            core.panic("Fraction: division by zero")
        return _mk(self.n * other.d, self.d * other.n)

    fn neg(self):
        return Fraction(-self.n, self.d)

    fn abs(self):
        return Fraction(self.n < 0 ? -self.n : self.n, self.d)

    fn eq(self, other):
        return self.n == other.n and self.d == other.d

    fn lt(self, other):
        return self.n * other.d < other.n * self.d

    fn le(self, other):
        return self.n * other.d <= other.n * self.d

    fn gt(self, other):
        return self.n * other.d > other.n * self.d

    fn ge(self, other):
        return self.n * other.d >= other.n * self.d

    fn floor(self):
        return _floor_div(self.n, self.d)

    fn ceil(self):
        return -_floor_div(-self.n, self.d)

    fn trunc(self):
        q = self.n / self.d
        r = self.n % self.d
        if r != 0 and ((r < 0) != (self.d < 0)):
            q = q + 1
        return q

    fn round(self):
        fl = _floor_div(self.n, self.d)
        rem = self.n - fl * self.d
        twice = rem * 2
        if twice < self.d:
            return fl
        if twice > self.d:
            return fl + 1
        if fl % 2 == 0:
            return fl
        return fl + 1

    fn limit_denominator(self, max_denominator: i64):
        if max_denominator < 1:
            core.panic("max_denominator should be at least 1")
        if self.d <= max_denominator:
            return self
        p0 = 0
        q0 = 1
        p1 = 1
        q1 = 0
        nn = self.n
        dd = self.d
        while dd != 0:
            a = nn / dd
            q2 = q0 + a * q1
            if q2 > max_denominator:
                break
            np1 = a * p1 + p0
            p0 = p1
            q0 = q1
            p1 = np1
            q1 = q2
            t = nn
            nn = dd
            dd = t % dd
        k = (max_denominator - q0) / q1
        b1 = _mk(p0 + k * p1, q0 + k * q1)
        b2 = _mk(p1, q1)
        d1 = b1.sub(self).abs()
        d2 = b2.sub(self).abs()
        if d1.le(d2):
            return b1
        return b2

    fn to_float(self):
        return float(self.n) / float(self.d)

    fn pow(self, e: i64):
        "self ** e for integer e (Python Fraction ** int -> Fraction)."
        if e == 0:
            return _mk(1, 1)
        neg_exp = false
        ee = e
        if ee < 0:
            neg_exp = true
            ee = -ee
        result = _mk(1, 1)
        base = self
        while ee > 0:
            if ee % 2 == 1:
                result = result.mul(base)
            base = base.mul(base)
            ee = ee / 2
        if neg_exp:
            if result.n == 0:
                core.panic("Fraction: 0 cannot be raised to a negative power")
            return _mk(result.d, result.n)
        return result

    fn as_integer_ratio(self):
        """-> [n, d] — the reduced numerator/denominator pair."""
        return [self.n, self.d]

    fn to_string(self):
        if self.d == 1:
            return str(self.n)
        return str(self.n) + "/" + str(self.d)

fn _mk(n, d):
    if d == 0:
        core.panic("Fraction: denominator is zero")
    if d < 0:
        n = -n
        d = -d
    g = _gcd_i(n, d)
    return Fraction(n / g, d / g)

"""Fraction_new(n, d) -> normalised Fraction (ints)."""
fn Fraction_new(n: i64, d: i64):
    return _mk(n, d)

"""Fraction_from_int(v) -> v/1."""
fn Fraction_from_int(v: i64):
    return _mk(v, 1)

"""
Fraction_from_float(f) -> exact binary ratio of the double f.
Panics on infinity and when the exact ratio needs a numerator or
 denominator beyond i64 (|binary exponent| too large — e.g. 1e-4,
 whose exact double has denominator 2^66). Python's bigint Fraction
 has no such limit; previously these cases silently overflowed.
"""
fn Fraction_from_float(f: f64):
    if f == 0.0:
        return _mk(0, 1)
    sign = 1
    x = f
    if x < 0:
        sign = -1
        x = -x
    if x > 1.7976931348623157e308:
        core.panic("Fraction: cannot convert infinity")
    e = 0
    # Normalise x into [0.5, 1) by powers of two. Scaling by 2^30 chunks is
    # exact (power-of-two multiply/divide never rounds), cutting the loop
    # count ~30x for extreme exponents; the tail loops below finish the job.
    while x >= 1073741824.0:
        x = x / 1073741824.0
        e = e + 30
    while x < 9.313225746154785e-10:
        x = x * 1073741824.0
        e = e - 30
    while x >= 1.0:
        x = x / 2.0
        e = e + 1
    while x < 0.5:
        x = x * 2.0
        e = e - 1
    m = int(x * 9007199254740992.0)
    shift = e - 53
    # m is in [2^52, 2^53); keep m*2^shift and 2^-shift inside i64.
    # Python's bigint Fraction handles these extremes; we panic instead
    # of silently overflowing (previously produced wrong ratios).
    if shift > 10 or shift < -62:
        core.panic("Fraction: float magnitude out of i64 range")
    if shift >= 0:
        return _mk(sign * m * _pow2i(shift), 1)
    return _mk(sign * m, _pow2i(-shift))

"""_as_fraction(v) -> Fraction for Fraction/i64/f64 inputs (Json dispatch)."""
fn _as_fraction(v):
    k = json.kind(v)
    if k == "number":
        i = json.as_int(v)
        if i != None:
            return _mk(i, 1)
        f = json.as_float(v)!
        return Fraction_from_float(f)
    if k == "null":
        core.panic("Fraction: unsupported operand type")
    return _mk(0, 1)

# --- string parsing -------------------------------------------------------------

fn _is_digit_ch(ch):
    return ch >= "0" and ch <= "9"

"""_parse_int_str(s) -> i64 for an optionally signed digit string; panics otherwise."""
fn _parse_int_str(s: String) -> i64:
    src = str(s)
    n = len(src)
    i = 0
    sign = 1
    if i < n and (str(src[i]) == "-" or str(src[i]) == "+"):
        if str(src[i]) == "-":
            sign = -1
        i = i + 1
    if i >= n:
        core.panic("Fraction: invalid integer '" + src + "'")
    v = 0
    while i < n:
        ch = str(src[i])
        if not _is_digit_ch(ch):
            core.panic("Fraction: invalid integer '" + src + "'")
        v = v * 10 + int(ch)
        i = i + 1
    return sign * v

fn _pow10i(e: i64) -> i64:
    r = 1
    i = 0
    while i < e:
        r = r * 10
        i = i + 1
    return r

"""
Fraction_from_str(s) -> Fraction parsed from a string.

Accepts the forms Python's Fraction(str) accepts:
  "n"        integer
  "-n" / "+n" signed integer
  "n/d"      fraction of two integers (either may be signed)
  "a.b"      decimal
  "a.bE-e"   decimal with exponent (e/E, optional sign)
Leading/trailing whitespace is ignored. Anything else panics.
"""
fn Fraction_from_str(s: String):
    src = str(s).strip()
    n = len(src)
    if n == 0:
        core.panic("Fraction: invalid literal")
    # fraction form "num/den"
    slash = src.find("/")
    if slash >= 0:
        num_s = _substr_str(src, 0, slash)
        den_s = _substr_str(src, slash + 1, n)
        return _mk(_parse_int_str(num_s), _parse_int_str(den_s))
    # decimal / scientific form
    i = 0
    sign = 1
    if str(src[i]) == "-" or str(src[i]) == "+":
        if str(src[i]) == "-":
            sign = -1
        i = i + 1
    digits = ""
    frac_len = 0
    seen_dot = false
    seen_digit = false
    while i < n:
        ch = str(src[i])
        if _is_digit_ch(ch):
            digits = digits + ch
            seen_digit = true
            if seen_dot:
                frac_len = frac_len + 1
            i = i + 1
            continue
        if ch == "." and not seen_dot:
            seen_dot = true
            i = i + 1
            continue
        break
    if not seen_digit:
        core.panic("Fraction: invalid literal '" + src + "'")
    # optional exponent
    exp_val = 0
    if i < n and (str(src[i]) == "e" or str(src[i]) == "E"):
        i = i + 1
        esign = 1
        if i < n and (str(src[i]) == "-" or str(src[i]) == "+"):
            if str(src[i]) == "-":
                esign = -1
            i = i + 1
        if i >= n:
            core.panic("Fraction: invalid literal '" + src + "'")
        ev = 0
        edigits = 0
        while i < n:
            ch = str(src[i])
            if not _is_digit_ch(ch):
                core.panic("Fraction: invalid literal '" + src + "'")
            ev = ev * 10 + int(ch)
            edigits = edigits + 1
            i = i + 1
        if edigits == 0:
            core.panic("Fraction: invalid literal '" + src + "'")
        exp_val = esign * ev
    if i != n:
        core.panic("Fraction: invalid literal '" + src + "'")
    num = _parse_int_str(digits)
    if num == 0:
        return _mk(0, 1)
    num = sign * num
    # value = num * 10^(exp_val - frac_len)
    scale = exp_val - frac_len
    if scale >= 0:
        return _mk(num * _pow10i(scale), 1)
    return _mk(num, _pow10i(-scale))

fn _substr_str(s, start, end):
    out = ""
    i = start
    while i < end:
        out = out + str(s[i])
        i = i + 1
    return out
