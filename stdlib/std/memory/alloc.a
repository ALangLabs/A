# std.memory.alloc wrappers (Mojo `std/memory` analog).
import arena

fn arena_new(capacity):
    return arena.new(capacity)

fn arena_pool(capacity):
    return arena.pool(capacity)

fn arena_region(capacity):
    return arena.region(capacity)

fn alloc(a, size):
    return arena.alloc(a, size)

fn release(a, handle):
    return arena.release(a, handle)

fn reset(a):
    return arena.reset(a)

fn used(a):
    return arena.used(a)

fn total(a):
    return arena.total(a)
