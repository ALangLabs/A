# std.memory (Mojo `std/memory` analog): arena wrappers.
# unsafe.get requires array-typed args; these wrappers document the
# unchecked surface and forward to the native arena module only.
import arena

fn arena_new(capacity):
    return arena.new(capacity)

fn arena_pool(capacity):
    return arena.pool(capacity)

fn arena_region(capacity):
    return arena.region(capacity)

fn alloc(a, size):
    return arena.alloc(a, size)

fn release(a, handle):
    arena.release(a, handle)

fn reset(a):
    arena.reset(a)

fn used(a):
    return arena.used(a)

fn total(a):
    return arena.total(a)

fn alloc_bytes(size):
    a = arena.new(size)
    return arena.alloc(a, size)
