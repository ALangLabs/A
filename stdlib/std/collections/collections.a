# std.collections (Mojo `std/collections` analog).
#
# Typed list and dictionary helpers built on A generics. Higher-order helpers
# take a typed function parameter, so the type checker verifies every call site
# instead of deferring failures to runtime.

fn map_list<T>(values: [T], f: fn(T) -> T) -> [T]:
    out = []
    for v in values:
        out.append(f(v))
    return out

fn filter_list<T>(values: [T], pred: fn(T) -> bool) -> [T]:
    out = []
    for v in values:
        if pred(v):
            out.append(v)
    return out

fn reduce_list<T>(values: [T], init: T, f: fn(T, T) -> T) -> T:
    total = init
    for v in values:
        total = f(total, v)
    return total

fn sum_list(values: [i64]) -> i64:
    total = 0
    for v in values:
        total = total + v
    return total

fn any_list(values: [bool]) -> bool:
    for v in values:
        if v:
            return true
    return false

fn all_list(values: [bool]) -> bool:
    for v in values:
        if not v:
            return false
    return true

fn len_of<T>(values: [T]) -> i64:
    return len(values)

fn list_reverse<T>(values: [T]) -> [T]:
    out = []
    i = len(values) - 1
    while i >= 0:
        out.append(values[i])
        i = i - 1
    return out

fn dict_get(d: {str: i64}, key: str, default: i64) -> i64:
    if key in d:
        return d[key]
    return default

fn dict_has(d: {str: i64}, key: str) -> bool:
    return key in d
