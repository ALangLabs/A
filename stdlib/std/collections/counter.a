# std.collections.counter — Python `collections.Counter` port.
#
# Counter is a dict subclass mapping elements to counts. A's `{K: V}` maps
# are already insertion-ordered and dynamically keyed, so `counts` is a
# plain map. Python's `+ & - |` operators have no class-operator analogue
# in A, so they are exposed as methods: `plus`/`minus`/`intersect`/`union`.
# Iterators (`elements`) return materialized lists per the porting guide.
import core
import json

## Stable merge sort of (key, count) tuples by count descending.
## Ties keep insertion order, matching CPython's most_common ordering.
fn _merge_by_count(left, right):
    out = []
    i = 0
    j = 0
    while i < len(left) and j < len(right):
        (_, lv) = left[i]
        (_, rv) = right[j]
        if lv >= rv:
            out.append(left[i])
            i = i + 1
        else:
            out.append(right[j])
            j = j + 1
    while i < len(left):
        out.append(left[i])
        i = i + 1
    while j < len(right):
        out.append(right[j])
        j = j + 1
    return out

fn _sort_by_count_desc(items):
    n = len(items)
    if n <= 1:
        return items
    mid = n / 2
    left = _sort_by_count_desc(items[0..mid])
    right = _sort_by_count_desc(items[mid..])
    return _merge_by_count(left, right)

## Counter: multiset / element-count map.
## `counts` is public so it composes with plain-map helpers.
struct Counter:
    counts

    ## _bump(k, delta) -> new count after adding delta (private helper).
    fn _bump(self, k, delta):
        n = 0
        if k in self.counts:
            n = self.counts[k]
        n = n + delta
        self.counts[k] = n
        return n

    ## update(src) -> add counts. `src` is an array (each element counts
    ## once, Python iterable form) or a map (values are added as counts,
    ## Python mapping form; counts must be integers). For another Counter
    ## pass `other.counts` or use `update_counter`.
    fn update(self, src):
        kind = json.kind(src)
        if kind == "array":
            for x in json.as_array(src)!:
                self._bump(x, 1)
        elif kind == "object":
            m = json.as_map(src)!
            for k in m:
                self._bump(k, json.as_int(m[k])!)
        else:
            core.panic("Counter.update expects an array or map")

    ## update_counter(other) -> add another Counter's counts.
    fn update_counter(self, other):
        for k in other.counts:
            self._bump(k, other.counts[k])

    ## subtract(src) -> subtract counts like update but decrementing;
    ## counts may go negative or zero (Python `subtract`).
    fn subtract(self, src):
        kind = json.kind(src)
        if kind == "array":
            for x in json.as_array(src)!:
                self._bump(x, -1)
        elif kind == "object":
            m = json.as_map(src)!
            for k in m:
                self._bump(k, -json.as_int(m[k])!)
        else:
            core.panic("Counter.subtract expects an array or map")

    ## subtract_counter(other) -> subtract another Counter's counts.
    fn subtract_counter(self, other):
        for k in other.counts:
            self._bump(k, -other.counts[k])

    ## elements() -> list with each element repeated its count
    ## (Python iterator materialized to a list; order = first-seen order).
    fn elements(self):
        out = []
        for k in self.counts:
            n = self.counts[k]
            i = 0
            while i < n:
                out.append(k)
                i = i + 1
        return out

    ## most_common(n) -> top-n (key, count) tuples sorted by count
    ## descending (ties keep first-seen order). n <= 0 returns all pairs.
    ## Python's `most_common()` defaults to all; pass -1 for that here.
    fn most_common(self, n):
        pairs = []
        for k in self.counts:
            pairs.append((k, self.counts[k]))
        sorted_pairs = _sort_by_count_desc(pairs)
        if n < 0 or n >= len(sorted_pairs):
            return sorted_pairs
        return sorted_pairs[0..n]

    ## most_common_all() -> every (key, count) pair, count-descending.
    fn most_common_all(self):
        return self.most_common(-1)

    ## total() -> sum of all counts (Python 3.10+ `total()`).
    fn total(self):
        t = 0
        for k in self.counts:
            t = t + self.counts[k]
        return t

    ## get(k) -> count for k, 0 when absent (Python `c[k]` returns 0 via
    ## `__missing__`).
    fn get(self, k):
        if k in self.counts:
            return self.counts[k]
        return 0

    ## set(k, n) -> assign an exact count (Python `c[k] = n`).
    fn set(self, k, n):
        self.counts[k] = n

    ## inc(k) -> add one occurrence.
    fn inc(self, k):
        self._bump(k, 1)

    ## dec(k) -> remove one occurrence (count may go negative/zero).
    fn dec(self, k):
        self._bump(k, -1)

    ## add(k, n) -> add n occurrences.
    fn add(self, k, n):
        self._bump(k, n)

    fn contains(self, k):
        return k in self.counts

    fn keys(self):
        return self.counts.keys()

    fn values(self):
        return self.counts.values()

    fn items(self):
        return self.counts.items()

    fn size(self):
        return len(self.counts)

    fn clear(self):
        self.counts.clear()

    fn copy(self):
        return Counter(self.counts.copy())

    ## plus(other) -> Counter with summed counts, keeping only positive
    ## results (Python `c1 + c2`).
    fn plus(self, other):
        out = Counter({})
        for k in self.counts:
            v = self.counts[k] + other.get(k)
            if v > 0:
                out.counts[k] = v
        for k in other.counts:
            if k not in self.counts:
                v = other.counts[k]
                if v > 0:
                    out.counts[k] = v
        return out

    ## minus(other) -> Counter with subtracted counts, keeping only
    ## positive results (Python `c1 - c2`).
    fn minus(self, other):
        out = Counter({})
        for k in self.counts:
            v = self.counts[k] - other.get(k)
            if v > 0:
                out.counts[k] = v
        return out

    ## intersect(other) -> Counter with min counts, keeping only
    ## positive results (Python `c1 & c2`).
    fn intersect(self, other):
        out = Counter({})
        for k in self.counts:
            v = self.counts[k]
            ov = other.get(k)
            if ov < v:
                v = ov
            if v > 0:
                out.counts[k] = v
        return out

    ## union(other) -> Counter with max counts (Python `c1 | c2`).
    fn union(self, other):
        out = Counter({})
        for k in self.counts:
            v = self.counts[k]
            ov = other.get(k)
            if ov > v:
                v = ov
            out.counts[k] = v
        for k in other.counts:
            if k not in self.counts:
                out.counts[k] = other.counts[k]
        return out
