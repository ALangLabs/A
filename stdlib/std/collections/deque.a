# std.collections.deque — Python `collections.deque` port.
#
# A deque is a double-ended queue. CPython's deque is C-backed with O(1)
# append/pop on both ends; this port keeps the live elements split across
# two lists — `left` (reversed left side) and `right` (right side with a
# start offset) — so append/appendleft/pop/popleft are O(1) and the
# occasional rebalancing is O(n) amortized. `rotate`/`reverse`/`to_list`
# are O(n), same as materializing any iterator in this port.
#
# `maxlen` follows Python: a non-negative bound discards from the
# opposite end on overflow; -1 means unbounded (Python `maxlen=None`).
import core

## Deque<T>: double-ended queue with optional max length.
## `left` holds the left portion reversed (its last element is the
## deque's leftmost); `right` holds the right portion with `roff` live
## elements skipped at the front. Both are internal — use the methods.
struct Deque<T>:
    left: [T]
    right: [T]
    roff: i64
    maxlen: i64

    fn _live_right(self) -> i64:
        return len(self.right) - self.roff

    fn _len(self) -> i64:
        return len(self.left) + self._live_right()

    ## _enforce_maxlen(side) -> drop elements from the opposite end when
    ## over maxlen. side is "left" or "right" (which end grew).
    fn _enforce_maxlen(self, side):
        if self.maxlen < 0:
            return
        while self._len() > self.maxlen:
            if side == "left":
                self._pop_right()
            else:
                self._pop_left()

    fn _pop_left(self) -> T:
        if len(self.left) > 0:
            return self.left.pop()
        if self._live_right() > 0:
            v = self.right[self.roff]
            self.roff = self.roff + 1
            if self.roff > 64 and self.roff * 2 > len(self.right):
                self.right = self.right[self.roff..]
                self.roff = 0
            return v
        core.panic("pop from an empty deque")

    fn _pop_right(self) -> T:
        if self._live_right() > 0:
            return self.right.pop()
        if len(self.left) > 0:
            # right side is empty: the rightmost element is left[0].
            # Rebalance by moving the reversed left side into `right`.
            self.right = self.left.copy()
            self.right.reverse()
            self.left = []
            self.roff = 0
            return self.right.pop()
        core.panic("pop from an empty deque")

    ## append(x) -> add x at the right end (Python `append`).
    fn append(self, x):
        self.right.append(x)
        self._enforce_maxlen("right")

    ## appendleft(x) -> add x at the left end (Python `appendleft`).
    fn appendleft(self, x):
        self.left.append(x)
        self._enforce_maxlen("left")

    ## extend(xs) -> append every element of xs at the right end.
    fn extend(self, xs):
        for x in xs:
            self.right.append(x)
        self._enforce_maxlen("right")

    ## extendleft(xs) -> append every element of xs at the left end,
    ## iterating in order (Python `extendleft`; equivalent to calling
    ## `appendleft` for each element, so xs ends up reversed at the left).
    fn extendleft(self, xs):
        for x in xs:
            self.left.append(x)
        self._enforce_maxlen("left")

    ## pop() -> remove and return the rightmost element; runtime error
    ## when empty (Python raises IndexError).
    fn pop(self) -> T:
        return self._pop_right()

    ## popleft() -> remove and return the leftmost element; runtime error
    ## when empty.
    fn popleft(self) -> T:
        return self._pop_left()

    ## rotate(n) -> rotate the deque n steps to the right; negative n
    ## rotates left (Python `rotate`). O(n).
    fn rotate(self, n):
        total = self._len()
        if total == 0:
            return
        step = n % total
        if step < 0:
            step = step + total
        if step == 0:
            return
        xs = self.to_list()
        # right rotation by `step`: last `step` elements move to front.
        tail = xs[total - step..]
        head = xs[0..total - step]
        self.clear()
        for x in tail:
            self.append(x)
        for x in head:
            self.append(x)

    ## clear() -> remove all elements (Python `clear`).
    fn clear(self):
        self.left = []
        self.right = []
        self.roff = 0

    ## copy() -> shallow copy of the deque.
    fn copy(self):
        return Deque(self.left.copy(), self.right.copy(), self.roff, self.maxlen)

    ## reverse() -> reverse the deque in place (Python `reverse`).
    fn reverse(self):
        xs = self.to_list()
        xs.reverse()
        self.clear()
        for x in xs:
            self.append(x)

    ## count(x) -> number of occurrences of x.
    fn count(self, x):
        n = 0
        for v in self.to_list():
            if v == x:
                n = n + 1
        return n

    ## index(x) -> index of the first occurrence of x; runtime error when
    ## absent (Python raises ValueError).
    fn index(self, x):
        xs = self.to_list()
        i = 0
        while i < len(xs):
            if xs[i] == x:
                return i
            i = i + 1
        core.panic("value not in deque")

    ## index_from(x, start) -> index of first occurrence at or after
    ## `start` (Python `index(x[, start[, stop]])`; `stop` unsupported).
    fn index_from(self, x, start):
        xs = self.to_list()
        i = start
        if i < 0:
            i = i + len(xs)
        while i < len(xs):
            if xs[i] == x:
                return i
            i = i + 1
        core.panic("value not in deque")

    ## remove(x) -> remove the first occurrence of x; runtime error when
    ## absent (Python `remove` raises ValueError).
    fn remove(self, x):
        xs = self.to_list()
        idx = -1
        i = 0
        while i < len(xs):
            if xs[i] == x:
                idx = i
                break
            i = i + 1
        if idx < 0:
            core.panic("value not in deque")
        self.clear()
        j = 0
        while j < len(xs):
            if j != idx:
                self.append(xs[j])
            j = j + 1

    ## contains(x) -> true when x is in the deque (Python `x in d`).
    fn contains(self, x):
        for v in self.to_list():
            if v == x:
                return true
        return false

    ## at(i) -> element at index i (negative indexes from the end);
    ## runtime error when out of range (Python raises IndexError).
    fn at(self, i) -> T:
        xs = self.to_list()
        n = len(xs)
        idx = i
        if idx < 0:
            idx = idx + n
        if idx < 0 or idx >= n:
            core.panic("deque index out of range")
        return xs[idx]

    ## first() -> leftmost element as an optional (None when empty).
    fn first(self):
        if len(self.left) > 0:
            return self.left[len(self.left) - 1]
        if self._live_right() > 0:
            return self.right[self.roff]
        return None

    ## last() -> rightmost element as an optional (None when empty).
    fn last(self):
        if self._live_right() > 0:
            return self.right[len(self.right) - 1]
        if len(self.left) > 0:
            return self.left[0]
        return None

    ## size() -> number of elements (Python `len(d)`).
    fn size(self):
        return self._len()

    ## maxlen_value() -> the configured maxlen (-1 = unbounded).
    fn maxlen_value(self):
        return self.maxlen

    ## to_list() -> all elements in order (Python iteration materialized).
    fn to_list(self) -> [T]:
        out = []
        # left portion reversed back into sequence order.
        i = len(self.left) - 1
        while i >= 0:
            out.append(self.left[i])
            i = i - 1
        j = self.roff
        while j < len(self.right):
            out.append(self.right[j])
            j = j + 1
        return out

## deque() -> empty unbounded deque (Python `deque()`).
fn deque() -> Deque<i64>:
    return Deque([], [], 0, -1)

## deque_of(xs) -> deque from a list (Python `deque(iterable)`).
fn deque_of<T>(xs: [T]) -> Deque<T>:
    return Deque([], xs.copy(), 0, -1)

## deque_bounded(xs, maxlen) -> deque with a max length
## (Python `deque(iterable, maxlen)`).
fn deque_bounded<T>(xs: [T], maxlen: i64) -> Deque<T>:
    d = Deque([], [], 0, maxlen)
    for x in xs:
        d.append(x)
    return d
