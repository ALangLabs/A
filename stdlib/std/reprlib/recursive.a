# std.reprlib.recursive — Python `reprlib.recursive_repr` port.
#
# Python: `@recursive_repr(fillvalue='...')` decorates a `__repr__` method
# so recursive calls on the same object return `fillvalue` instead of
# recursing forever. The guard set is keyed by (id(self), thread id).
#
# A has no decorators and no callable objects, so the port wraps the
# function in a `RecursiveRepr` record invoked via `.call(args)` (same
# convention as `functools.LRUCache.call`):
#
#   wrapped = recursive_repr(my_repr_fn, "...")
#   wrapped.call([obj])               # -> repr string or "..." on recursion
#
# Deviation: Python's `recursive_repr(fillvalue)` decorator factory is
# collapsed into a single call because A cannot return a callable decorator
# that constructs a struct (interpreter limitation — see README.md).
#
# The running set stores the *argument value*; for containers A hashes map
# keys by identity (like Python's id()), so self-references are detected.
# Scalar arguments compare by value, which is harmless: scalars cannot be
# recursive anyway. Values that only exist as `Json` wrappers (e.g. fields
# extracted via `json.as_map`) may not share identity with the original
# object — pass native containers where possible.
import core

## _call1(f, x) -> f(x); indirect call so sema sees a plain function value
## (same trampoline pattern as functools._apply).
fn _call1(f, x):
    return f(x)

## RecursiveRepr — recursion-guarded wrapper around a repr function.
struct RecursiveRepr:
    user_function
    fillvalue
    running    # set of in-flight arguments

    ## call(self, args) -> user_function(args[0]) or fillvalue when the
    ## same argument is already being repr'd (recursion detected).
    ## Exactly one argument is supported, matching Python's wrapper(self).
    fn call(self, args):
        if len(args) != 1:
            core.panic("recursive_repr: expected exactly 1 argument")
        key = args[0]
        if key in self.running:
            return self.fillvalue
        self.running.add(key)
        result = _call1(self.user_function, key)
        self.running.discard(key)
        return result

## recursive_repr(user_function, fillvalue) -> RecursiveRepr wrapping
## `user_function`. Pass "..." for the Python default fillvalue.
fn recursive_repr(user_function, fillvalue):
    return RecursiveRepr(user_function, fillvalue, set())
