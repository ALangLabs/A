# std.reprlib.repr — Python `reprlib` port (part 1: Repr class + repr).
#
# Python `reprlib` re-implements `repr()` with size limits (maxlevel,
# maxstring, maxlist, ...) so huge/cyclic structures print compactly.
#
# Port notes (see README.md for the full deviation list):
#   * Dispatch is by runtime tag (`json.kind` + `json.as_array`/`as_map`
#     probes + `str` prefix for sets/tuples) instead of `type(x)` +
#     `getattr(self, 'repr_' + typename)`.
#   * Dict/set iteration order is insertion/storage order; Python's
#     `_possibly_sorted` ordering is NOT replicated (A has no safe
#     heterogeneous sort).
#   * Tuples and sets are decomposed through the `binary` codec
#     (encode -> decode -> Json array) because A tuples cannot be iterated
#     and sets would need a second code path; elements surface as `Json`.
#     Nested tuples/sets inside them degrade to lists.
#   * `Repr.indent` accepts a non-negative int (spaces per level) or -1
#     for Python's `None`; string indents are not supported.
#   * `maxfrozenset`/`maxdeque`/`maxarray` fields exist for signature
#     parity; A has no frozenset/deque/array.array equivalents.
import json
import binary
import core

## _slice(s, start, end) -> substring s[start:end] (chars, end exclusive).
fn _slice(s, start, end):
    cs = s.chars()
    out = ""
    i = start
    while i < end and i < len(cs):
        out = out + str(cs[i])
        i = i + 1
    return out

## _floordiv(a, b) -> floor(a / b) for b > 0.
fn _floordiv(a, b):
    q = a / b
    if a < 0 and a % b != 0:
        q = q - 1
    return q

## _max(a, b) -> larger of two ints.
fn _max(a: i64, b: i64) -> i64:
    if a > b:
        return a
    return b

## _is_container_opt(v) -> true when a `json.as_array`/`as_map` probe
## result is Some. Container optionals (`[Json]?`, `map<String,Json>?`)
## cannot be compared to None in A, so we probe with a string sentinel
## and check the runtime kind instead.
fn _is_container_opt(v):
    return json.kind(v) != "string"

## _py_str_repr(s) -> Python-style repr of a string (single quotes,
## escapes for backslash, the quote char, \n, \t, \r). Non-ASCII and other
## control characters pass through literally (documented deviation).
fn _py_str_repr(s):
    quote = "'"
    if s.contains("'") and not s.contains("\""):
        quote = "\""
    out = quote
    for c in s:
        sc = str(c)
        if sc == "\\":
            out = out + "\\\\"
        elif sc == quote:
            out = out + "\\" + quote
        elif sc == "\n":
            out = out + "\\n"
        elif sc == "\t":
            out = out + "\\t"
        elif sc == "\r":
            out = out + "\\r"
        else:
            out = out + sc
    out = out + quote
    return out

## _seq_kind(x) -> "set" | "tuple" | "other" for kind=="array" values that
## are not plain lists. Uses the `str` prefix ('{' for sets, '(' for
## tuples) — cheap and avoids `binary.encode`.
fn _seq_kind(x):
    s = str(x)
    if s.startswith("\{"):
        return "set"
    if s.startswith("("):
        return "tuple"
    return "other"

## _items(x) -> [Json] element list for native sets and tuples via the
## binary codec (sets/tuples cannot be iterated/indexed uniformly in A).
fn _items(x):
    d = binary.decode(binary.encode(x))
    probe = d ?? "NONE"
    if json.kind(probe) == "string":
        return []
    return (json.as_array(d!) ?? [])

## _middle_truncate(s, limit, fill) -> s with its middle replaced by `fill`
## when len(s) > limit (Python repr_str/repr_int/repr_instance pattern).
fn _middle_truncate(s, limit: i64, fill):
    if len(s) <= limit:
        return s
    i = _max(0, _floordiv(limit - 3, 2))
    j = _max(0, limit - 3 - i)
    n = len(s)
    head = _slice(s, 0, i)
    tail_start = _max(0, n - j)
    tail = _slice(s, tail_start, n)
    return head + fill + tail

## Repr — repr with limits (Python `reprlib.Repr`).
##
## Field order matches the Python __init__ signature (positional):
##   maxlevel, maxtuple, maxlist, maxarray, maxdict, maxset,
##   maxfrozenset, maxdeque, maxstring, maxlong, maxother, fillvalue, indent
## `indent < 0` means Python `indent=None`.
class Repr:
    maxlevel: i64
    maxtuple: i64
    maxlist: i64
    maxarray: i64
    maxdict: i64
    maxset: i64
    maxfrozenset: i64
    maxdeque: i64
    maxstring: i64
    maxlong: i64
    maxother: i64
    fillvalue
    indent: i64

    ## repr(self, x) -> limited repr of x at top level.
    fn repr(self, x):
        return self.repr1(x, self.maxlevel)

    ## repr1(self, x, level) -> dispatch on runtime tag.
    fn repr1(self, x, level):
        kind = json.kind(x)
        if kind == "string":
            st = (json.as_str(x))!
            return self.repr_str(st, level)
        if kind == "number":
            if json.as_int(x) != None:
                return self.repr_int(x, level)
            return self.repr_instance(x, level)
        if kind == "bool":
            b = (json.as_bool(x))!
            if b:
                return self.repr_instance("True", level)
            return self.repr_instance("False", level)
        if kind == "array":
            if _is_container_opt(json.as_array(x) ?? "NONE"):
                return self.repr_list(x, level)
            t = _seq_kind(x)
            if t == "set":
                return self.repr_set(x, level)
            # Tuples cannot be decomposed in A (un-iterable, and the binary
            # codec round-trips them to an opaque TupleValue), so they fall
            # back to str() via repr_instance — documented deviation.
            return self.repr_instance(x, level)
        if kind == "object":
            if _is_container_opt(json.as_map(x) ?? "NONE"):
                return self.repr_dict(x, level)
            return self.repr_instance(x, level)
        # null, unknown (ranges, closures, results): repr_instance fallback.
        return self.repr_instance(x, level)

    ## _join(self, pieces, level) -> Python Repr._join (indent-aware).
    fn _join(self, pieces: [String], level):
        if len(pieces) == 0:
            return ""
        if self.indent < 0:
            return ", ".join(pieces)
        inner = (self.maxlevel - level + 1) * self.indent
        if inner < 0:
            inner = 0
        sep = ",\n" + " ".repeat(inner)
        joined = sep.join([""] + pieces + [""])
        n = len(joined)
        if self.indent == 0:
            return _slice(joined, 1, n)
        return _slice(joined, 1, _max(1, n - self.indent))

    ## _repr_iterable(self, elems, level, left, right, maxiter, trail)
    ## -> '[left]e1, e2, ...[right]' with fillvalue past maxiter.
    ## elems are [Json]; trail is the extra ',' for 1-tuples.
    fn _repr_iterable(self, elems, level, left, right, maxiter: i64, trail):
        n = len(elems)
        if level <= 0 and n > 0:
            return left + self.fillvalue + right
        newlevel = level - 1
        pieces = []
        i = 0
        limit = maxiter
        if n < limit:
            limit = n
        while i < limit:
            pieces.append(self.repr1(elems[i], newlevel))
            i = i + 1
        if n > maxiter:
            pieces.append(self.fillvalue)
        s = self._join(pieces, level)
        r = right
        if n == 1 and trail != "" and self.indent < 0:
            r = trail + right
        return left + s + r

    ## repr_tuple is not provided: A tuples cannot be iterated or indexed,
    ## and `binary.decode` round-trips them to an opaque TupleValue, so
    ## tuple elements are unreachable. Tuples render via repr_instance
    ## (str()), matching Python's '(a, b)' shape but without recursion
    ## into elements — documented deviation.

    ## repr_list(self, x, level) -> '[a, b]' (elements are [Json]).
    fn repr_list(self, x, level):
        elems = (json.as_array(x))!
        return self._repr_iterable(elems, level, "[", "]", self.maxlist, "")

    ## repr_set(self, x, level) -> '{a, b}' / 'set()' (elements via codec).
    fn repr_set(self, x, level):
        elems = _items(x)
        if len(elems) == 0:
            return "set()"
        return self._repr_iterable(elems, level, "\{", "\}", self.maxset, "")

    ## repr_dict(self, x, level) -> '{k: v, ...}' over as_map keys.
    fn repr_dict(self, x, level):
        mm = (json.as_map(x))!
        ks = []
        for k in mm:
            ks.append(k)
        n = len(ks)
        if n == 0:
            return "\{\}"
        if level <= 0:
            return "\{" + self.fillvalue + "\}"
        newlevel = level - 1
        pieces = []
        i = 0
        limit = self.maxdict
        if n < limit:
            limit = n
        while i < limit:
            k = ks[i]
            pieces.append(self.repr1(k, newlevel) + ": " + self.repr1(mm[k], newlevel))
            i = i + 1
        if n > self.maxdict:
            pieces.append(self.fillvalue)
        return "\{" + self._join(pieces, level) + "\}"

    ## repr_str(self, s, level) -> quoted, maxstring-truncated repr.
    ## `s` is a plain String (extracted via json.as_str by repr1).
    fn repr_str(self, s, level):
        cs = s.chars()
        take = self.maxstring
        if len(cs) < take:
            take = len(cs)
        head = ""
        i = 0
        while i < take:
            head = head + str(cs[i])
            i = i + 1
        out = _py_str_repr(head)
        if len(out) > self.maxstring:
            # Python: repr(x[:i] + x[-j:]) with fillvalue spliced inside.
            i2 = _max(0, _floordiv(self.maxstring - 3, 2))
            j2 = _max(0, self.maxstring - 3 - i2)
            n = len(cs)
            h2 = ""
            i = 0
            while i < i2 and i < n:
                h2 = h2 + str(cs[i])
                i = i + 1
            tstart = n - j2
            if tstart < 0:
                tstart = 0
            t2 = ""
            i = tstart
            while i < n:
                t2 = t2 + str(cs[i])
                i = i + 1
            mid = _py_str_repr(h2 + t2)
            m = len(mid)
            left = _slice(mid, 0, i2)
            right_start = m - j2
            if right_start < i2:
                right_start = i2
            right = _slice(mid, right_start, m)
            out = left + self.fillvalue + right
        return out

    ## repr_int(self, x, level) -> digits, maxlong-truncated.
    fn repr_int(self, x, level):
        return _middle_truncate(str(x), self.maxlong, self.fillvalue)

    ## repr_instance(self, x, level) -> fallback repr, maxother-truncated.
    fn repr_instance(self, x, level):
        return _middle_truncate(str(x), self.maxother, self.fillvalue)

## aRepr — shared default Repr (Python `reprlib.aRepr`).
## Field order: maxlevel, maxtuple, maxlist, maxarray, maxdict, maxset,
## maxfrozenset, maxdeque, maxstring, maxlong, maxother, fillvalue, indent.
aRepr = Repr(6, 6, 6, 5, 4, 6, 6, 6, 30, 40, 30, "...", -1)

## repr(x) -> limited repr using the shared aRepr (Python `reprlib.repr`).
fn repr(x):
    return aRepr.repr(x)
