# std.path selftest — POSIX path manipulation.
# Run: ./build/a test stdlib/std/path/selftest.a
from std:path import join, split, splitext, normpath, relpath, commonpath, dirname, basename, isabs, abspath, expanduser, commonprefix

fn assert_eq(a, b):
    assert(a == b)

fn assert_true(c):
    assert(c)

fn test_join():
    assert_eq(join(["a", "b", "c.txt"]), "a/b/c.txt")
    assert_eq(join(["a", "/b"]), "/b")
    empty_parts = []
    empty_parts.append("")
    assert_eq(join(empty_parts[0..0]), "")
    assert_eq(join(["/a", "b"]), "/a/b")
    assert_eq(join(["a", ""]), "a/")

fn test_split_dirname_basename():
    p = split("/x/y/z.txt")
    assert_eq(p[0], "/x/y")
    assert_eq(p[1], "z.txt")
    sf = split("file")
    assert_eq(sf[0], "")
    assert_eq(sf[1], "file")
    assert_eq(dirname("/a/b/c"), "/a/b")
    assert_eq(basename("/a/b/c"), "c")
    assert_eq(basename("a/"), "")

fn test_splitext():
    e = splitext("a/b.tar.gz")
    assert_eq(e[0], "a/b.tar")
    assert_eq(e[1], ".gz")
    h = splitext(".bashrc")
    assert_eq(h[0], ".bashrc")
    assert_eq(h[1], "")
    n = splitext("noext")
    assert_eq(n[1], "")

fn test_normpath():
    assert_eq(normpath("a//b/../c/./d"), "a/c/d")
    assert_eq(normpath("/../x"), "/x")
    assert_eq(normpath("../a/../../b"), "../../b")
    assert_eq(normpath(""), ".")
    assert_eq(normpath("/"), "/")
    assert_eq(normpath("a/b/"), "a/b")
    assert_eq(normpath("."), ".")

fn test_isabs_abspath():
    assert_true(isabs("/x"))
    assert_true(not isabs("x"))
    assert_eq(abspath("/a/b"), "/a/b")
    a = abspath(".")
    assert_true(a.startswith("/"))

fn test_relpath():
    assert_eq(relpath("/a/b/c", "/a"), "b/c")
    assert_eq(relpath("/a/b", "/a/c"), "../b")
    assert_eq(relpath("/a", "/a"), ".")
    assert_eq(relpath("a/b", "a/c"), "../b")

fn test_commonpath():
    assert_eq(commonpath(["/a/b/c", "/a/b/d"]), "/a/b")
    assert_eq(commonpath(["/a", "/a/b/c"]), "/a")
    assert_eq(commonpath(["x/y", "x/z"]), "x")
    assert_eq(commonpath(["/a", "/b"]), "/")

fn test_commonprefix():
    assert_eq(commonprefix(["/a/b/c", "/a/b/d"]), "/a/b/")
    assert_eq(commonprefix([]), "")

fn test_expanduser():
    # HOME may or may not be set; "~user" must pass through unchanged.
    assert_eq(expanduser("~root/x"), "~root/x")
    assert_eq(expanduser("plain"), "plain")
    h = expanduser("~/x")
    if h == "~/x":
        assert_true(true)  # HOME unset: unchanged
    else:
        assert_true(h.endswith("/x") and not h.startswith("~"))
