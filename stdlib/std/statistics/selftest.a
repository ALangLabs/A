# std.statistics selftest — run: ./build/a test stdlib/std/statistics/selftest.a
import std:statistics
import std:random

fn assert_eq(a, b):
    assert(a == b)

fn assert_close(a, b, tol = 1e-9):
    assert(abs(a - b) < tol)

fn test_multimode():
    m = statistics.multimode([1, 2, 2, 3, 3, 3])
    assert_eq(m, [3])
    m2 = statistics.multimode([1, 1, 2, 2, 3])
    assert_eq(len(m2), 2)
    assert_eq(m2[0], 1)
    assert_eq(m2[1], 2)

fn test_quantiles():
    qs = statistics.quantiles([1, 2, 3, 4], 2)
    assert_eq(len(qs), 1)
    assert_close(qs[0], 2.5)
    q4 = statistics.quantiles([1, 2, 3, 4], 4)
    assert_eq(len(q4), 3)
    # exclusive quartiles of 1..4
    assert_close(q4[0], 1.25)
    assert_close(q4[1], 2.5)
    assert_close(q4[2], 3.75)
    qi = statistics.quantiles([1, 2, 3, 4], 4, "inclusive")
    assert_close(qi[0], 1.75)
    assert_close(qi[1], 2.5)
    assert_close(qi[2], 3.25)

fn test_covariance_correlation():
    c = statistics.covariance([1, 2, 3], [2, 4, 6])
    assert_close(c, 2.0)
    r = statistics.correlation([1, 2, 3], [2, 4, 6])
    assert_close(r, 1.0)
    r2 = statistics.correlation([1, 2, 3], [6, 4, 2])
    assert_close(r2, -1.0)

fn test_linear_regression():
    lr = statistics.linear_regression([1, 2, 3], [2, 4, 6])
    assert_close(lr[0], 2.0)
    assert_close(lr[1], 0.0)
    lr2 = statistics.linear_regression([0, 1, 2], [1, 3, 5])
    assert_close(lr2[0], 2.0)
    assert_close(lr2[1], 1.0)

fn test_median_grouped():
    # CPython doc example shape: midpoints 25,35,45,55,65 with counts
    # approximated by repeated values, interval 10 -> ~37.5 region.
    # Simple check: [25,25,35,35,35,35,45] interval 10 -> median group 35
    mg = statistics.median_grouped([25, 25, 35, 35, 35, 35, 45], 10)
    # n=7, x=xs[3]=35, i=2 (<35), j=6 (<=35), L=30, f=4
    # 30 + 10*(3.5-2)/4 = 33.75
    assert_close(mg, 33.75)
    # single distinct value -> stays at its midpoint
    assert_close(statistics.median_grouped([5, 5, 5], 1), 5.0)

fn test_normal_dist():
    nd = statistics.NormalDist_new(0.0, 1.0)
    assert_close(nd.cdf(0.0), 0.5)
    assert_close(nd.cdf(1.0), 0.8413447, 1e-5)
    assert_close(nd.pdf(0.0), 0.3989423, 1e-5)
    # inv_cdf round-trips
    assert_close(nd.cdf(nd.inv_cdf(0.975)), 0.975, 1e-9)
    assert_close(nd.inv_cdf(0.5), 0.0, 1e-9)
    # shifted/scaled
    nd2 = statistics.NormalDist_new(10.0, 2.0)
    assert_close(nd2.cdf(10.0), 0.5)
    assert_close(nd2.inv_cdf(0.5), 10.0, 1e-9)
    qs = nd.quantiles(4)
    assert_eq(len(qs), 3)
    assert_close(nd.cdf(qs[1]), 0.5, 1e-9)
    assert_close(nd.zscore(1.0), 1.0)
    assert_close(nd2.zscore(12.0), 1.0)
    # samples are finite and roughly centered
    rng = random.Random_new(42)
    smp = nd.samples(200, rng)
    assert_eq(len(smp), 200)
    total = 0.0
    for v in smp:
        total = total + v
    mean_est = total / 200.0
    assert(abs(mean_est) < 0.3)
    # from_samples on symmetric data
    nd3 = statistics.NormalDist_from_samples([1.0, 2.0, 3.0])
    assert_close(nd3.mu, 2.0)

fn main():
    test_multimode()
    test_quantiles()
    test_covariance_correlation()
    test_linear_regression()
    test_median_absolute_deviation()
    test_median_grouped()
    test_normal_dist()
    print("statistics selftest OK")

fn test_median_absolute_deviation():
    # [1,2,3,4,5]: median 3, deviations [2,1,0,1,2], MAD 1
    assert_close(statistics.median_absolute_deviation([1, 2, 3, 4, 5], "mad"), 1.0)
    assert_close(statistics.median_absolute_deviation([1, 2, 3, 4, 5]), 1.0 * 1.4826)
    # custom numeric scale
    assert_close(statistics.median_absolute_deviation([1, 2, 3, 4, 5], 2), 2.0)
    # even count: [1,2,3,4] median 2.5, devs [1.5,.5,.5,1.5] -> MAD 1.0
    assert_close(statistics.median_absolute_deviation([1, 2, 3, 4], "mad"), 1.0)
