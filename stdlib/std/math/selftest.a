# std.math selftest — A-file wrappers over the native math module.
# Run: ./build/a test stdlib/std/math/selftest.a
#
# NOTE: `import std:math` resolves to the NATIVE math module, so this
# selftest imports the A-file wrappers relatively (quoted path), the
# same reachability the package files themselves use.
from "functions.a" import sqrt, abs_val, min_val, max_val, pow_val, sin, cos, tan, asin, acos, atan, atan2, exp, log, log2, log10, floor, ceil, round_val, trunc, random, random_int, clamp
from "constants.a" import PI, E

fn assert_eq(a, b):
    assert(a == b)

fn assert_close(a, b):
    d = a - b
    if d < 0:
        d = -d
    assert(d < 0.000001)

fn test_basics():
    assert_eq(sqrt(4.0), 2.0)
    assert_eq(abs_val(-3.0), 3.0)
    assert_eq(min_val(2.0, 5.0), 2.0)
    assert_eq(max_val(2.0, 5.0), 5.0)
    assert_eq(pow_val(2.0, 10.0), 1024.0)
    assert_eq(floor(2.7), 2.0)
    assert_eq(ceil(2.1), 3.0)
    assert_eq(round_val(2.5), 3.0)
    assert_eq(trunc(-2.7), -2.0)
    assert_close(PI, 3.14159265)
    assert_close(E, 2.71828182)

fn test_trig_and_logs():
    assert_close(sin(0.0), 0.0)
    assert_close(cos(0.0), 1.0)
    assert_close(tan(0.0), 0.0)
    assert_close(asin(1.0), PI / 2.0)
    assert_close(acos(1.0), 0.0)
    assert_close(atan(1.0), PI / 4.0)
    assert_close(atan2(1.0, 1.0), PI / 4.0)
    assert_close(exp(1.0), E)
    assert_close(log(E), 1.0)
    assert_close(log2(8.0), 3.0)
    assert_close(log10(1000.0), 3.0)

fn test_clamp():
    assert_eq(clamp(5.0, 0.0, 10.0), 5.0)
    assert_eq(clamp(-1.0, 0.0, 10.0), 0.0)
    assert_eq(clamp(11.0, 0.0, 10.0), 10.0)

fn test_random():
    # random() in [0, 1); random_int inclusive bounds
    r = random()
    assert(r >= 0.0 and r < 1.0)
    i = random_int(3, 7)
    assert(i >= 3 and i <= 7)

fn main():
    test_basics()
    test_trig_and_logs()
    test_clamp()
    test_random()
    print("std.math selftest: all tests passed")
