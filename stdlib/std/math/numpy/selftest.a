# std.math.numpy selftest — smoke coverage across all submodules.
# Run: ./build/a test stdlib/std/math/numpy/selftest.a
import std:math.numpy

fn assert_eq(a, b):
    assert(a == b)

fn assert_close(a, b):
    d = a - b
    if d < 0:
        d = -d
    assert(d < 0.0001)

fn test_core():
    a = numpy.zeros([2, 3])
    assert_eq(a.shape[0], 2)
    assert_eq(a.size(), 6)
    b = numpy.arange(0.0, 4.0, 1.0)
    assert_eq(b.data[3], 3.0)
    m = numpy.array_from_list([[1.0, 2.0], [3.0, 4.0]])
    t = numpy.transpose(m)
    assert_eq(t.data[1], 3.0)
    assert_eq(numpy.reshape(b, [2, 2]).shape[1], 2)

fn test_ufuncs():
    x = numpy.arange(1.0, 5.0, 1.0)
    y = numpy.add(x, numpy.multiply_scalar(x, 2.0))
    assert_eq(y.data[0], 3.0)
    assert_eq(y.data[3], 12.0)
    s = numpy.sqrt(x)
    assert_close(s.data[3], 2.0)
    w = numpy.where_(numpy.greater(x, 2.5), x, numpy.multiply_scalar(x, 0.0))
    assert_eq(w.data[0], 0.0)
    assert_eq(w.data[3], 4.0)

fn test_reductions():
    m = numpy.array_from_list([[1.0, 2.0], [3.0, 4.0]])
    assert_close(numpy.sum_all(m), 10.0)
    assert_close(numpy.mean_all(m), 2.5)
    assert_close(numpy.std_all(m), 1.1180339)
    assert_eq(numpy.trace(m), 5.0)
    assert_eq(numpy.argmax_all(m), 3)
    assert_eq(numpy.argmin_all(m), 0)

fn test_linalg():
    m = numpy.array_from_list([[1.0, 2.0], [3.0, 4.0]])
    assert_close(numpy.det(m), -2.0)
    i = numpy.inv(m)
    assert_close(i.data[0], -2.0)
    assert_close(i.data[3], -0.5)
    p = numpy.matmul(m, m)
    assert_eq(p.data[0], 7.0)
    assert_eq(p.data[3], 22.0)
    n = numpy.norm(m)
    assert(n > 5.0)

fn test_shape_ops():
    a = numpy.arange(0.0, 6.0, 1.0)
    r = numpy.reshape(a, [2, 3])
    assert_eq(r.shape[0], 2)
    e = numpy.expand_dims(a, 0)
    assert_eq(e.shape[0], 1)
    s = numpy.stack2(a, a, 0)
    assert_eq(s.shape[0], 2)
    c = numpy.concatenate2(r, r, 0)
    assert_eq(c.shape[0], 4)
    f = numpy.flipud(r)
    assert_eq(f.data[0], 3.0)

fn test_random():
    numpy.seed(42)
    x = numpy.random_sample([100])
    for v in x.data:
        assert(v >= 0.0 and v < 1.0)
    numpy.seed(42)
    y = numpy.random_sample([100])
    assert_eq(x.data[50], y.data[50])

fn test_stats():
    (h, _e) = numpy.histogram(numpy.arange(0.0, 5.0, 1.0), 5)
    for v in h.data:
        assert_eq(v, 1.0)
    assert_close(numpy.median(numpy.asarray_flat([1.0, 3.0, 2.0])), 2.0)
    (hh, _xe, _ye) = numpy.histogram2d(numpy.arange(0.0, 4.0, 1.0), numpy.arange(0.0, 4.0, 1.0), 2)
    assert(hh.size() > 0)

fn test_poly():
    assert_close(numpy.polyval([1.0, 0.0, -1.0], 2.0), 3.0)
    roots = numpy.polyroots([1.0, 0.0, -1.0])
    assert_eq(len(roots), 2)
    assert_close(roots[0], -1.0)
    assert_close(roots[1], 1.0)

fn test_io():
    a = numpy.arange(0.0, 4.0, 1.0)
    numpy.savetxt("/tmp/a_numpy_selftest.txt", a)
    b = numpy.loadtxt("/tmp/a_numpy_selftest.txt")
    assert_eq(b.data[2], 2.0)

fn test_indexing():
    m = numpy.array_from_list([[1.0, 2.0], [3.0, 4.0]])
    d = numpy.diagonal(m, 0)
    assert_eq(d.data[0], 1.0)
    assert_eq(d.data[1], 4.0)
    idx = numpy.nonzero(numpy.greater(m, 2.5))
    assert(len(idx) == 2)

entry main():
    test_core()
    test_ufuncs()
    test_reductions()
    test_linalg()
    test_shape_ops()
    test_random()
    test_stats()
    test_poly()
    test_io()
    test_indexing()
    print("numpy selftest: all passed")
