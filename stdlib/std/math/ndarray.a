#
# numpy core: NDArray is a flat row-major (C-order) [f64] buffer plus a shape.
# All higher-level ops are built on these primitives. dtype is f64 only.
#
# Public API mirrors NumPy naming where A allows: array, zeros, ones, ...
# Math functions (sqrt, sin, pow, ...) are native builtins — no import needed.

class NDArray:
    data: [f64]
    shape: [i64]

    fn ndim(self) -> i64:
        return len(self.shape)

    fn size(self) -> i64:
        n = 1
        for d in self.shape:
            n = n * d
        return n

    # --- NumPy-style methods ---------------------------------------------------
    # NOTE: locals below are _m-prefixed — A function locals share a flat
    # name->slot namespace with caller variables (see reductions.a note), so
    # unprefixed locals could clobber same-named caller variables.

    # reshape/ravel/flatten/transpose mirror the module-level fns of the same
    # name; they are re-implemented here (via _nd_transpose for transpose) so
    # the methods never recurse into themselves.

    fn reshape(self, newshape: [i64]) -> NDArray:
        return NDArray(self.data, newshape)

    fn ravel(self) -> NDArray:
        return NDArray(self.data, [self.size()])

    fn flatten(self) -> NDArray:
        _md = []
        for _mv in self.data:
            _md.append(_mv)
        return NDArray(_md, [self.size()])

    fn transpose(self) -> NDArray:
        return _nd_transpose(self)

    # NumPy exposes .T as a property; A has no properties, so T() is the
    # method-call spelling of a.transpose().
    fn T(self) -> NDArray:
        return self.transpose()

    fn copy(self) -> NDArray:
        _md = []
        for _mv in self.data:
            _md.append(_mv)
        _ms = []
        for _mv in self.shape:
            _ms.append(_mv)
        return NDArray(_md, _ms)

    # tolist: 0-d -> [[v]], 1-d -> [[v], ...], >=2-d -> rows of cols
    # (same convention as the module-level tolist; deeper ranks flatten rows).
    fn tolist(self) -> [[f64]]:
        _mn = self.ndim()
        _mo = []
        if _mn == 0:
            if len(self.data) > 0:
                _mo.append([self.data[0]])
            return _mo
        if _mn == 1:
            for _mv in self.data:
                _mo.append([_mv])
            return _mo
        _mrows = self.shape[0]
        if _mrows == 0:
            return _mo
        _mcols = self.size() // _mrows
        for _mi in 0.._mrows:
            _mrow = []
            for _mj in 0.._mcols:
                _mrow.append(self.data[_mi * _mcols + _mj])
            _mo.append(_mrow)
        return _mo

    fn array_str(self) -> str:
        return array2string(self)

    # A does not dispatch __str__ for class instances; call a.__str__() or
    # a.array_str() explicitly (same caveat as std/datetime).
    fn __str__(self) -> str:
        return array2string(self)

    # --- flat reductions (population statistics, ddof=0) ----------------------
    # NaN elements are NOT skipped (unlike reductions.a nan* variants); empty
    # arrays give sum/prod = 0/1-ish and min/max/mean/var/std = NaN.

    fn sum(self) -> f64:
        _ms = 0.0
        for _mv in self.data:
            _ms = _ms + _mv
        return _ms

    fn mean(self) -> f64:
        _mn = len(self.data)
        if _mn == 0:
            return _m_nan()
        _ms = 0.0
        for _mv in self.data:
            _ms = _ms + _mv
        return _ms / _mn

    fn min(self) -> f64:
        _mseen = false
        _mb = 0.0
        for _mv in self.data:
            if not _mseen or _mv < _mb:
                _mb = _mv
                _mseen = true
        if not _mseen:
            return _m_nan()
        return _mb

    fn max(self) -> f64:
        _mseen = false
        _mb = 0.0
        for _mv in self.data:
            if not _mseen or _mv > _mb:
                _mb = _mv
                _mseen = true
        if not _mseen:
            return _m_nan()
        return _mb

    fn var(self) -> f64:
        _mn = len(self.data)
        if _mn == 0:
            return _m_nan()
        _ms = 0.0
        for _mv in self.data:
            _ms = _ms + _mv
        _mm = _ms / _mn
        _mrss = 0.0
        for _mv in self.data:
            _md = _mv - _mm
            _mrss = _mrss + _md * _md
        return _mrss / _mn

    fn std(self) -> f64:
        return sqrt(self.var())

    fn prod(self) -> f64:
        _mp = 1.0
        for _mv in self.data:
            _mp = _mp * _mv
        return _mp

    fn argmax(self) -> i64:
        if len(self.data) == 0:
            return -1
        _mb = 0
        _mi = 1
        while _mi < len(self.data):
            if self.data[_mi] > self.data[_mb]:
                _mb = _mi
            _mi = _mi + 1
        return _mb

    fn argmin(self) -> i64:
        if len(self.data) == 0:
            return -1
        _mb = 0
        _mi = 1
        while _mi < len(self.data):
            if self.data[_mi] < self.data[_mb]:
                _mb = _mi
            _mi = _mi + 1
        return _mb

    # --- dot ------------------------------------------------------------------
    # 1-D.1-D -> 0-d NDArray scalar; 2-D.1-D -> [rows]; 1-D.2-D -> [cols];
    # 2-D.2-D -> matmul [m,n]. Other rank combos return an empty NDArray.

    fn dot(self, other: NDArray) -> NDArray:
        _ma = self.ndim()
        _mnd = other.ndim()
        if _ma == 1 and _mnd == 1:
            _ms = 0.0
            _mi = 0
            _mlim = len(self.data)
            if len(other.data) < _mlim:
                _mlim = len(other.data)
            while _mi < _mlim:
                _ms = _ms + self.data[_mi] * other.data[_mi]
                _mi = _mi + 1
            return NDArray([_ms], [])
        if _ma == 2 and _mnd == 1:
            _mrows = self.shape[0]
            _mcols = self.shape[1]
            _mout = []
            _mi = 0
            while _mi < _mrows:
                _ms = 0.0
                _mj = 0
                while _mj < _mcols:
                    _ms = _ms + self.data[_mi * _mcols + _mj] * other.data[_mj]
                    _mj = _mj + 1
                _mout.append(_ms)
                _mi = _mi + 1
            return NDArray(_mout, [_mrows])
        if _ma == 1 and _mnd == 2:
            _mrows = other.shape[0]
            _mcols = other.shape[1]
            _mout = []
            _mj = 0
            while _mj < _mcols:
                _ms = 0.0
                _mi = 0
                while _mi < _mrows:
                    _ms = _ms + self.data[_mi] * other.data[_mi * _mcols + _mj]
                    _mi = _mi + 1
                _mout.append(_ms)
                _mj = _mj + 1
            return NDArray(_mout, [_mcols])
        if _ma == 2 and _mnd == 2:
            _mm = self.shape[0]
            _mk = self.shape[1]
            _mn2 = other.shape[1]
            if other.shape[0] != _mk:
                return NDArray([], [])
            _mout = []
            _mi = 0
            while _mi < _mm:
                _mj = 0
                while _mj < _mn2:
                    _ms = 0.0
                    _mk2 = 0
                    while _mk2 < _mk:
                        _ms = _ms + self.data[_mi * _mk + _mk2] * other.data[_mk2 * _mn2 + _mj]
                        _mk2 = _mk2 + 1
                    _mout.append(_ms)
                    _mj = _mj + 1
                _mi = _mi + 1
            return NDArray(_mout, [_mm, _mn2])
        return NDArray([], [])

    # --- cumulative -------------------------------------------------------------
    # Flat (raveled) cumulative ops, like numpy cumsum/cumprod with axis=None.

    fn cumsum(self) -> NDArray:
        _mn = self.size()
        _mout = []
        _macc = 0.0
        _mi = 0
        while _mi < _mn:
            _macc = _macc + self.data[_mi]
            _mout.append(_macc)
            _mi = _mi + 1
        return NDArray(_mout, [_mn])

    fn cumprod(self) -> NDArray:
        _mn = self.size()
        _mout = []
        _macc = 1.0
        _mi = 0
        while _mi < _mn:
            _macc = _macc * self.data[_mi]
            _mout.append(_macc)
            _mi = _mi + 1
        return NDArray(_mout, [_mn])

    fn trace(self) -> f64:
        # main-diagonal sum; NaN for non-2-D (NumPy raises instead)
        if len(self.shape) != 2:
            return _m_nan()
        _mrows = self.shape[0]
        _mcols = self.shape[1]
        _mn = _mrows
        if _mcols < _mrows:
            _mn = _mcols
        _ms = 0.0
        _mi = 0
        while _mi < _mn:
            _ms = _ms + self.data[_mi * _mcols + _mi]
            _mi = _mi + 1
        return _ms

    # --- misc -------------------------------------------------------------------

    # scalar extract; NaN unless the array holds exactly one element
    fn item(self) -> f64:
        if len(self.data) == 1:
            return self.data[0]
        return _m_nan()

    # truthiness reductions: all -> every element != 0.0 (empty -> true),
    # any -> some element != 0.0 (empty -> false)
    fn all(self) -> bool:
        for _mv in self.data:
            if _mv == 0.0:
                return false
        return true

    fn any(self) -> bool:
        for _mv in self.data:
            if _mv != 0.0:
                return true
        return false

# --- shape helpers -----------------------------------------------------------

fn shape_of(a: NDArray) -> [i64]:
    return a.shape

fn ndim(a: NDArray) -> i64:
    return len(a.shape)

fn size_of(a: NDArray) -> i64:
    return a.size()

fn is_scalar_shape(shape: [i64]) -> bool:
    return len(shape) == 0

fn _shape_size(shape: [i64]) -> i64:
    n = 1
    for d in shape:
        n = n * d
    return n

# --- creation -----------------------------------------------------------------

fn ndarray(data: [f64], shape: [i64]) -> NDArray:
    if _shape_size(shape) != len(data):
        # mismatch: still construct; callers must pass matching sizes
        pass
    return NDArray(data, shape)

fn array_from_list(xs: [[f64]]) -> NDArray:
    # nested list -> NDArray (rectangular assumed)
    shape = [len(xs)]
    if len(xs) > 0:
        shape.append(len(xs[0]))
        flat = []
        for row in xs:
            for v in row:
                flat.append(v)
        return NDArray(flat, shape)
    return NDArray([], shape)

fn _full(shape: [i64], v: f64) -> NDArray:
    n = _shape_size(shape)
    data = []
    for i in 0..n:
        data.append(v)
    return NDArray(data, shape)

fn zeros(shape: [i64]) -> NDArray:
    return _full(shape, 0.0)

fn ones(shape: [i64]) -> NDArray:
    return _full(shape, 1.0)

fn empty(shape: [i64]) -> NDArray:
    n = _shape_size(shape)
    data = []
    for i in 0..n:
        data.append(0.0)
    return NDArray(data, shape)

fn full(shape: [i64], v: f64) -> NDArray:
    return _full(shape, v)

fn arange(start: f64, stop: f64, step: f64) -> NDArray:
    data = []
    x = start
    if step > 0:
        while x < stop:
            data.append(x)
            x = x + step
    else:
        while x > stop:
            data.append(x)
            x = x + step
    return NDArray(data, [len(data)])

fn arange1(stop: f64) -> NDArray:
    return arange(0.0, stop, 1.0)

fn linspace(start: f64, stop: f64, num: i64) -> NDArray:
    if num <= 0:
        return NDArray([], [0])
    if num == 1:
        return NDArray([start], [1])
    step = (stop - start) / (num - 1.0)
    data = []
    for i in 0..num:
        data.append(start + i * step)
    return NDArray(data, [num])

fn eye(n: i64) -> NDArray:
    data = []
    for i in 0..n:
        for j in 0..n:
            if i == j:
                data.append(1.0)
            else:
                data.append(0.0)
    return NDArray(data, [n, n])

fn identity(n: i64) -> NDArray:
    return eye(n)

# --- shape manipulation --------------------------------------------------------

fn _shape_prod(shape: [i64]) -> i64:
    return _shape_size(shape)

fn _row_major_index(shape: [i64], idx: [i64]) -> i64:
    # C-order flat offset for a full index tuple
    off = 0
    stride = 1
    i = len(shape) - 1
    while i >= 0:
        off = off + idx[i] * stride
        stride = stride * shape[i]
        i = i - 1
    return off

fn reshape(a: NDArray, newshape: [i64]) -> NDArray:
    return NDArray(a.data, newshape)

fn ravel(a: NDArray) -> NDArray:
    return NDArray(a.data, [a.size()])

fn flatten(a: NDArray) -> NDArray:
    data = []
    for v in a.data:
        data.append(v)
    return NDArray(data, [a.size()])

fn transpose(a: NDArray) -> NDArray:
    return _nd_transpose(a)

fn _nd_transpose(a: NDArray) -> NDArray:
    if len(a.shape) != 2:
        # generic: reverse axes
        newshape = []
        i = len(a.shape) - 1
        while i >= 0:
            newshape.append(a.shape[i])
            i = i - 1
        data = []
        total = _shape_size(newshape)
        for i in 0..total:
            # target multi-index
            tidx = []
            rem = i
            k = len(newshape) - 1
            while k >= 0:
                tidx.insert(0, rem % newshape[k])
                rem = rem // newshape[k]
                k = k - 1
            # source index = reversed target
            sidx = []
            k = len(tidx) - 1
            while k >= 0:
                sidx.append(tidx[k])
                k = k - 1
            off = _row_major_index(a.shape, sidx)
            data.append(a.data[off])
        return NDArray(data, newshape)
    # 2-D fast path
    rows = a.shape[0]
    cols = a.shape[1]
    data = []
    for j in 0..cols:
        for i in 0..rows:
            data.append(a.data[i * cols + j])
    return NDArray(data, [cols, rows])

# --- indexing ------------------------------------------------------------------

fn get(a: NDArray, idx: [i64]) -> f64:
    return a.data[_row_major_index(a.shape, idx)]

fn set(a: NDArray, idx: [i64], v: f64) -> NDArray:
    a.data[_row_major_index(a.shape, idx)] = v
    return a

fn _broadcast_strides(shape: [i64], target: [i64]) -> [i64]:
    # returns per-axis stride multiplier into `shape` for broadcasting to `target`
    # (right-aligned). stride[i] is 0 for broadcast axes.
    nd = len(shape)
    nt = len(target)
    strides = []
    for i in 0..nt:
        strides.append(0)
    # compute strides of source in C order
    sstride = []
    st = 1
    i = nd - 1
    while i >= 0:
        sstride.insert(0, st)
        st = st * shape[i]
        i = i - 1
    offset = nt - nd
    i = 0
    while i < nd:
        if offset + i < nt:
            # stride is 0 on axes where the source dim is 1 but target is not
            # (true broadcast); otherwise the C-order stride applies.
            if shape[i] == 1 and target[offset + i] != 1:
                strides[offset + i] = 0
            else:
                strides[offset + i] = sstride[i]
        i = i + 1
    return strides

fn _broadcast_shape(a: [i64], b: [i64]) -> [i64]:
    # returns broadcasted shape of two shapes, or [] on mismatch
    na = len(a)
    nb = len(b)
    nt = na
    if nb > na:
        nt = nb
    out = []
    for i in 0..nt:
        out.append(1)
    i = 0
    while i < nt:
        av = 1
        bv = 1
        ai = i - (nt - na)
        bi = i - (nt - nb)
        if ai >= 0:
            av = a[ai]
        if bi >= 0:
            bv = b[bi]
        if av == bv:
            out[i] = av
        elif av == 1:
            out[i] = bv
        elif bv == 1:
            out[i] = av
        else:
            return []
        i = i + 1
    return out

fn _asarray_scalar(v: f64) -> NDArray:
    return NDArray([v], [])

# elementwise binary op on broadcasted NDArrays; op is "add"|"sub"|"mul"|"div"|"pow"|"min"|"max"
fn _ew_bin(op: str, a: NDArray, b: NDArray) -> NDArray:
    shape = _broadcast_shape(a.shape, b.shape)
    if len(shape) == 0:
        return NDArray([], [])
    n = _shape_size(shape)
    sa = _broadcast_strides(a.shape, shape)
    sb = _broadcast_strides(b.shape, shape)
    data = []
    for i in 0..n:
        # decompose i into target multi-index
        rem = i
        coords = []
        k = len(shape) - 1
        while k >= 0:
            coords.insert(0, rem % shape[k])
            rem = rem // shape[k]
            k = k - 1
        oa = 0
        ob = 0
        k = 0
        while k < len(shape):
            oa = oa + coords[k] * sa[k]
            ob = ob + coords[k] * sb[k]
            k = k + 1
        va = a.data[oa]
        vb = b.data[ob]
        if op == "add":
            data.append(va + vb)
        elif op == "sub":
            data.append(va - vb)
        elif op == "mul":
            data.append(va * vb)
        elif op == "div":
            data.append(va / vb)
        elif op == "pow":
            data.append(pow(va, vb))
        elif op == "min":
            if va < vb:
                data.append(va)
            else:
                data.append(vb)
        else:
            if va > vb:
                data.append(va)
            else:
                data.append(vb)
    return NDArray(data, shape)

fn _ew_un(op: str, a: NDArray) -> NDArray:
    n = a.size()
    data = []
    for i in 0..n:
        v = a.data[i]
        if op == "neg":
            data.append(-v)
        elif op == "abs":
            if v < 0:
                data.append(-v)
            else:
                data.append(v)
        elif op == "sqrt":
            data.append(sqrt(v))
        elif op == "sin":
            data.append(sin(v))
        elif op == "cos":
            data.append(cos(v))
        elif op == "exp":
            data.append(exp(v))
        elif op == "log":
            data.append(log(v))
        elif op == "floor":
            data.append(floor(v))
        elif op == "ceil":
            data.append(ceil(v))
        else:
            data.append(v)
    return NDArray(data, a.shape)

fn _scalar_or_arr(v: f64, shape: [i64]) -> NDArray:
    if len(shape) == 0:
        return NDArray([v], [])
    n = _shape_size(shape)
    data = []
    for i in 0..n:
        data.append(v)
    return NDArray(data, shape)

# broadcast a scalar against an NDArray
fn _with_scalar(op: str, a: NDArray, scalar: f64, scalar_left: bool) -> NDArray:
    s = _scalar_or_arr(scalar, a.shape)
    if scalar_left:
        return _ew_bin(op, s, a)
    return _ew_bin(op, a, s)

# --- conversion / printing -----------------------------------------------------

fn tolist(a: NDArray) -> [[f64]]:
    # only supports 1-D and 2-D for now (nested deeper -> flattened rows)
    if len(a.shape) == 1:
        out = []
        for v in a.data:
            out.append([v])
        return out
    rows = a.shape[0]
    if rows == 0:
        return []
    cols = a.size() // rows
    out = []
    for i in 0..rows:
        row = []
        for j in 0..cols:
            row.append(a.data[i * cols + j])
        out.append(row)
    return out

fn _fmt_num(v: f64) -> str:
    return str(v)

fn array2string(a: NDArray) -> str:
    if len(a.shape) == 0:
        if len(a.data) == 0:
            return "[]"
        return _fmt_num(a.data[0])
    if len(a.shape) == 1:
        parts = []
        for v in a.data:
            parts.append(_fmt_num(v))
        return "[" + ", ".join(parts) + "]"
    # 2-D
    rows = a.shape[0]
    if rows == 0:
        return "[]"
    cols = a.size() // rows
    lines = []
    for i in 0..rows:
        parts = []
        for j in 0..cols:
            parts.append(_fmt_num(a.data[i * cols + j]))
        lines.append("[" + ", ".join(parts) + "]")
    return "\n".join(lines)

fn str_arr(a: NDArray) -> str:
    return array2string(a)

# --- private helpers for NDArray methods --------------------------------------

fn _m_nan() -> f64:
    # IEEE NaN via pow domain edge (0.0/0.0 is a compile-time error in A)
    return pow(-1.0, 0.5)
