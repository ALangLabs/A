# std.os.process — process identity, working directory, and host information.

import std:fs
import std:core

"""Uname -> the five-field record returned by os.uname()."""
class Uname:
    sysname: String
    nodename: String
    release: String
    version: String
    machine: String

"""uname() -> Uname(sysname, nodename, release, version, machine)."""
fn uname():
    u = fs.uname()
    return Uname(u[0], u[1], u[2], u[3], u[4])

"""getcwd() -> current working directory."""
fn getcwd():
    return fs.current_dir()

"""getcwdb() -> current working directory (bytes are not distinct in A)."""
fn getcwdb():
    return fs.current_dir()

"""chdir(path) -> change the process working directory."""
fn chdir(path):
    fs.chdir(path)

fn getpid():
    return fs.getpid()

fn getppid():
    return fs.getppid()

fn getuid():
    return fs.getuid()

fn geteuid():
    return fs.geteuid()

fn getgid():
    return fs.getgid()

fn getegid():
    return fs.getegid()

fn getlogin():
    return fs.getlogin()

"""cpu_count() -> number of online CPUs."""
fn cpu_count():
    return fs.cpu_count()

"""system(command) -> run a shell command, returning its exit status."""
fn system(command):
    return fs.system(command)

"""getloadavg() -> [1-minute, 5-minute, 15-minute] load averages."""
fn getloadavg():
    return fs.getloadavg()

"""gethostname() -> host name of the machine."""
fn gethostname():
    return fs.gethostname()

"""umask(mask) -> set the process file mode mask; returns the old one."""
fn umask(mask):
    return fs.umask(mask)

"""getpagesize() -> system memory page size in bytes."""
fn getpagesize():
    return fs.getpagesize()

"""kill(pid, signal) -> send a signal to a process."""
fn kill(pid, signal):
    fs.kill(pid, signal)

"""_exit(code) -> terminate the current process immediately."""
fn _exit(code=0):
    fs.exit(code)
