# std.os.dirs — directory listing, creation/removal, and traversal.

import std:fs
import std:core
import std:path as pathlib
from "stat.astra" import exists, isdir, isfile, islink
import "stat.astra" as osstat

"""DirEntry -> one result of scandir(), mirroring os.DirEntry."""
class DirEntry:
    name: String
    path: String

    fn is_file(self) -> bool:
        return isfile(self.path)

    fn is_dir(self) -> bool:
        return isdir(self.path)

    fn is_symlink(self) -> bool:
        return islink(self.path)

    fn stat(self):
        return osstat.stat(self.path)

    fn inode(self):
        return osstat.stat(self.path).st_ino

    fn __str__(self):
        return "<DirEntry '" + self.name + "'>"


"""listdir(path=".") -> names of the entries in a directory."""
fn listdir(path="."):
    return fs.list_dir(path)

"""scandir(path=".") -> list of DirEntry records."""
fn scandir(path="."):
    names = fs.list_dir(path)
    entries = []
    for n in names:
        entries.append(DirEntry(n, pathlib.join([path, n])))
    return entries

"""mkdir(path, mode=0o777, dir_fd=None) -> create a single directory."""
fn mkdir(path, mode=0o777, dir_fd=None):
    if exists(path):
        core.panic("os.mkdir: file exists: " + str(path))
    fs.mkdir(path, mode)

"""makedirs(name, mode=0o777, exist_ok=False) -> create parents as needed."""
fn makedirs(name, mode=0o777, exist_ok=false):
    if name == "" or name == "." or name == "/":
        return None
    if isdir(name):
        if exist_ok:
            return None
        core.panic("os.makedirs: file exists: " + str(name))
    if exists(name):
        core.panic("os.makedirs: file exists: " + str(name))
    parent = pathlib.dirname(name)
    if parent != "" and parent != "." and parent != name and not isdir(parent):
        makedirs(parent, mode, true)
    fs.mkdir(name, mode)
    return None

"""rmdir(path, dir_fd=None) -> remove one empty directory."""
fn rmdir(path, dir_fd=None):
    fs.rmdir(path)

"""removedirs(name) -> rmdir(name), then prune empty parents."""
fn removedirs(name):
    rmdir(name)
    parent = pathlib.dirname(name)
    while parent != "" and parent != "." and parent != "/" and parent != name:
        if not isdir(parent):
            return None
        if len(listdir(parent)) != 0:
            return None
        rmdir(parent)
        nxt = pathlib.dirname(parent)
        if nxt == parent:
            return None
        parent = nxt
    return None

fn _walk(top, topdown, followlinks, out):
    dirs = []
    files = []
    for n in listdir(top):
        p = pathlib.join([top, n])
        if isdir(p):
            dirs.append(n)
        else:
            files.append(n)
    dirs = sorted(dirs)
    files = sorted(files)
    if topdown:
        out.append((top, dirs, files))
    for d in dirs:
        child = pathlib.join([top, d])
        if not followlinks and islink(child):
            continue
        _walk(child, topdown, followlinks, out)
    if not topdown:
        out.append((top, dirs, files))

"""walk(top, topdown=True, onerror=None, followlinks=False).

Yields (dirpath, dirnames, filenames) tuples, depth-first. `dirnames` and
`filenames` are sorted for deterministic output. Symlinked directories are
listed in `dirnames` but not descended into unless `followlinks` is true.
"""
fn walk(top, topdown=true, onerror=None, followlinks=false):
    out = []
    if not isdir(top):
        return out
    _walk(top, topdown, followlinks, out)
    return out

"""fwalk(...) -> file-descriptor based walk; unsupported by the runtime."""
fn fwalk(top=".", topdown=true, onerror=None, followlinks=false):
    core.panic("os.fwalk() is not supported on this runtime")
