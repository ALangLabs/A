# std.os — a Python-compatible `os` surface for A.
#
# This package is a thin facade over the native `fs`, `env`, and `terminal`
# modules plus small pure-A helpers. It is split into focused modules so each
# part can be extended on its own:
#
#   constants.a    platform constants (name, sep, F_OK, SEEK_*, ...)
#   environment.a  getenv/environ/putenv
#   process.a      pid/uid/gid, cwd, uname, cpu_count, system
#   stat.a         StatResult, stat/lstat, exists/isfile/isdir, chmod/utime
#   dirs.a         listdir/scandir, mkdir/makedirs/rmdir, walk
#   files.a        remove/rename/truncate, symlink/link/readlink
#   pathns.a       the os.path namespace object
#   randbytes.a    urandom/getrandom
#   termsize.a     get_terminal_size
#
# Differences from CPython that are inherent to the A runtime:
#   * Paths are UTF-8 strings; there is no separate bytes path type.
#   * There is no file-descriptor-based API (open/read/write/fdopen, dir_fd=,
#     os.stat_result.st_*_ns). `fwalk`, `getloadavg`, and `sameopenfile`
#     raise instead of returning partial data.
#   * os.urandom returns a [i64] list of byte values (as random.randbytes does)
#     because A has no first-class `bytes` for this API.
#   * os.chmod/utime on Windows are no-ops or unsupported, as in the runtime.

from "constants.a" import name, sep, pathsep, linesep, curdir, pardir, extsep, devnull, altsep, supports_dir_fd, supports_effective_ids, supports_fd, supports_follow_symlinks, F_OK, R_OK, W_OK, X_OK, SEEK_SET, SEEK_CUR, SEEK_END

from "environment.a" import getenv, getenv_default, getenvb, environ_get, environ_all, putenv, unsetenv, environ, Environ

from "process.a" import getcwd, getcwdb, chdir, getpid, getppid, getuid, geteuid, getgid, getegid, getlogin, cpu_count, system, uname, Uname, getloadavg

from "stat.a" import StatResult, stat, lstat, try_stat, try_lstat, exists, lexists, isfile, isdir, islink, getsize, access, chmod, utime, samefile, samestat, ismount

from "dirs.a" import DirEntry, listdir, scandir, mkdir, makedirs, rmdir, removedirs, walk, fwalk

from "files.a" import remove, unlink, rename, replace, renames, truncate, link, symlink, readlink

from "randbytes.a" import urandom, getrandom

from "termsize.a" import get_terminal_size, TerminalSize

from "pathns.a" import path, PathNamespace
