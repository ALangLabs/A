# std.os.constants — POSIX constants exposed by the os package.
#
# Kept in their own module so the public __init__ stays a thin re-export
# layer and platform-specific values have one obvious home.

# Identity of the host platform (A targets POSIX; kept Python-compatible).
name = "posix"
sep = "/"
pathsep = ":"
linesep = "\n"
curdir = "."
pardir = ".."
extsep = "."
devnull = "/dev/null"
altsep = None

# Feature-probe lists. The A runtime does not expose dir_fd/fd-relative
# operations, so these stay empty (Python uses them to advertise support).
supports_dir_fd = []
supports_effective_ids = []
supports_fd = []
supports_follow_symlinks = []

# access(2) mode bits (F_OK / R_OK / W_OK / X_OK).
F_OK = 0
R_OK = 4
W_OK = 2
X_OK = 1

# whence values shared with lseek/truncate-style APIs.
SEEK_SET = 0
SEEK_CUR = 1
SEEK_END = 2

# Signal numbers (POSIX/Linux values, for os.kill).
SIGHUP = 1
SIGINT = 2
SIGQUIT = 3
SIGILL = 4
SIGTRAP = 5
SIGABRT = 6
SIGBUS = 7
SIGFPE = 8
SIGKILL = 9
SIGUSR1 = 10
SIGSEGV = 11
SIGUSR2 = 12
SIGPIPE = 13
SIGALRM = 14
SIGTERM = 15
SIGSTKFLT = 16
SIGCHLD = 17
SIGCONT = 18
SIGSTOP = 19
SIGTSTP = 20
SIGTTIN = 21
SIGTTOU = 22
SIGURG = 23
SIGXCPU = 24
SIGXFSZ = 25
SIGVTALRM = 26
SIGPROF = 27
SIGWINCH = 28
SIGIO = 29
SIGPWR = 30
SIGSYS = 31
