import std:core

passed = 0
failed = 0

fn check(name, condition):
    if condition:
        passed = passed + 1
    else:
        failed = failed + 1
        eprint("FAIL " + name)

fn equal(name, expected, actual):
    if expected == actual:
        passed = passed + 1
    else:
        failed = failed + 1
        eprint("FAIL " + name + ": expected " + str(expected) + ", found " + str(actual))

fn require(condition, message):
    core.assert(condition, message)

fn summary():
    return failed

fn report():
    print(str(passed) + " passed, " + str(failed) + " failed")
