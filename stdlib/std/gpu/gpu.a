# GPU abstractions (Mojo `std/_gpu` + MAX GPU API analog).
#
# This is a CPU fallback implementation with the Mojo-shaped surface: typed
# Device, Buffer, and Kernel values plus host-side launch. Real device memory
# and kernel codegen require a device backend (see TODO.md); `available` is
# false so callers can branch instead of silently assuming a GPU.
import prelude
import core

struct Kernel:
    name: str
    func: fn(i64) -> i64

struct Buffer:
    data: [i64]
    size: i64

    fn transfer_in(self, xs: [i64]) -> Buffer:
        self.data = xs
        self.size = len(xs)
        return self

    fn transfer_out(self) -> [i64]:
        return self.data

struct Device:
    available: bool
    name: str
    backend: str

    fn transfer_in(self, buf: Buffer, xs: [i64]) -> Buffer:
        buf.data = xs
        buf.size = len(xs)
        return buf

    fn launch(self, kernel: Kernel, a: Buffer, b: Buffer, out: Buffer) -> Buffer:
        xs = a.transfer_out()
        ys = b.transfer_out()
        result = []
        i = 0
        n = len(xs)
        while i < n:
            result.append(kernel.func(xs[i] + ys[i]))
            i = i + 1
        out.data = result
        out.size = len(result)
        return out

fn cpu_device() -> Device:
    return Device(false, "cpu-fallback", "cpu")

fn create_device() -> Device:
    return Device(false, "cpu-fallback", "cpu")

fn device_name(d: Device) -> str:
    return d.name

fn make_buffer(xs: [i64]) -> Buffer:
    return Buffer(xs, len(xs))

fn make_kernel(name: str, func: fn(i64) -> i64) -> Kernel:
    return Kernel(name, func)

fn add_kernel() -> Kernel:
    return Kernel("add", fn(x) => x)

fn host_launch(kernel: Kernel, buffer: Buffer) -> [i64]:
    out = []
    for x in buffer.data:
        out.append(kernel.func(x))
    return out

fn buffer_len(buffer: Buffer) -> i64:
    return len(buffer.data)

fn buffer_sum(buffer: Buffer) -> i64:
    total = 0
    for x in buffer.data:
        total = total + x
    return total

fn transfer_in(buf: Buffer, xs: [i64]) -> Buffer:
    buf.data = xs
    buf.size = len(xs)
    return buf

fn transfer_out(buf: Buffer) -> [i64]:
    return buf.data

fn launch(kernel: Kernel, a: Buffer, b: Buffer, out: Buffer) -> Buffer:
    xs = transfer_out(a)
    ys = transfer_out(b)
    result = []
    i = 0
    n = len(xs)
    while i < n:
        result.append(kernel.func(xs[i] + ys[i]))
        i = i + 1
    out.data = result
    out.size = len(result)
    return out
