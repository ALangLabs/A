# std.textwrap selftest — run: ./build/a test stdlib/std/textwrap/selftest.astra
import std:textwrap

fn assert_eq(a, b):
    assert(a == b)

fn assert_true(c):
    assert(c)

fn test_wrap_fill():
    ws = textwrap.wrap("the quick brown fox", 10)
    assert_eq(len(ws), 2)
    assert_eq(textwrap.fill("the quick brown fox", 10), "the quick\nbrown fox")
    assert_eq(textwrap.dedent("  a\n  b"), "a\nb")
    assert_eq(textwrap.indent("a\nb", "> "), "> a\n> b")
    assert_eq(textwrap.shorten("hello world", 8, "..."), "hello...")

fn test_indented():
    f = textwrap.fill_indented("one two three four five", 12, "", "  ")
    assert_eq(f, "one two\n  three four\n  five")
    ls = textwrap.wrap_indented("aa bb cc", 8, "> ", "  ")
    assert_eq(len(ls), 2)
    assert_eq(ls[0], "> aa bb")
    assert_eq(ls[1], "  cc")

fn test_textwrapper():
    tw = textwrap.TextWrapper_new(10)
    ws = tw.wrap("the quick brown fox jumps")
    assert_eq(len(ws), 3)
    assert_eq(tw.fill("the quick brown fox"), "the quick\nbrown fox")
    # indents honoured, width includes them
    tw2 = textwrap.TextWrapper_new(12, "", "  ")
    f2 = tw2.fill("one two three four five")
    assert_eq(f2, "one two\n  three four\n  five")
    # break_long_words = false keeps long words whole
    tw3 = textwrap.TextWrapper_new(5)
    tw3.break_long_words = false
    ws3 = tw3.wrap("supercalifragilistic ok")
    assert_eq(ws3[0], "supercalifragilistic")
    # break_on_hyphens allows breaking after '-'
    tw4 = textwrap.TextWrapper_new(8)
    tw4.break_long_words = false
    ws4 = tw4.wrap("well-known fact")
    joined = ""
    i = 0
    while i < len(ws4):
        if i > 0:
            joined = joined + "|"
        joined = joined + str(ws4[i])
        i = i + 1
    assert_true(joined.contains("well-"))
    # expand_tabs
    tw5 = textwrap.TextWrapper_new(70)
    assert_eq(tw5._prepare("a\tb"), "a       b")
    # fix_sentence_endings doubles space after sentence end
    tw6 = textwrap.TextWrapper_new(70)
    tw6.fix_sentence_endings = true
    assert_eq(tw6._prepare("Hi. there"), "Hi.  there")
