# std.textwrap - port of Python Lib/textwrap.py (pure-A subset).
#
# Implements practical wrapping/filling plus dedent/indent/shorten.
# Python's regex-heavy word splitting and sentence-end fixing are not
# fully replicated; this uses simple whitespace chunking.
#
# Deviations from Python:
#   * No `TextWrapper` class / `re`-based splitting; functions take
#     explicit parameters (A has no default params).
#   * `wrap(text, width)`, `fill(text, width)`, `shorten(text, width, placeholder)`.
#   * Hyphen-aware breaking, sentence-end fixing, max_lines, tabsize
#     options are limited/omitted.

fn _substr(s, start, end):
    out = ""
    i = start
    src = str(s)
    n = len(src)
    e = end
    if e > n:
        e = n
    while i < e:
        out = out + str(src[i])
        i = i + 1
    return out

fn _is_ws(ch):
    if ch == " ":
        return true
    if ch == "\t":
        return true
    if ch == "\n":
        return true
    if ch == "\r":
        return true
    return false

fn _split_words_ws(text):
    out = []
    cur = ""
    src = str(text)
    i = 0
    while i < len(src):
        ch = str(src[i])
        if _is_ws(ch):
            if len(cur) > 0:
                out.append(cur)
                cur = ""
        else:
            cur = cur + ch
        i = i + 1
    if len(cur) > 0:
        out.append(cur)
    return out

fn wrap(text, width):
    "Wrap text to width columns (simple whitespace wrapping). Returns list of lines."
    wlimit = int(width)
    if wlimit < 1:
        wlimit = 1
    words = _split_words_ws(text)
    lines = []
    line = ""
    i = 0
    while i < len(words):
        w = str(words[i])
        if len(line) == 0:
            line = w
        elif len(line) + 1 + len(w) <= wlimit:
            line = line + " " + w
        else:
            lines.append(line)
            if len(w) > wlimit:
                rest = w
                while len(rest) > wlimit:
                    lines.append(_substr(rest, 0, wlimit))
                    rest = _substr(rest, wlimit, len(rest))
                line = rest
            else:
                line = w
        i = i + 1
    if len(line) > 0:
        lines.append(line)
    return lines

fn fill(text, width):
    "Wrap text and join lines with newlines."
    lines = wrap(text, width)
    out = ""
    i = 0
    while i < len(lines):
        if i > 0:
            out = out + "\n"
        out = out + str(lines[i])
        i = i + 1
    return out

fn _split_on_nl_keep(s):
    out = []
    cur = ""
    i = 0
    src = str(s)
    while i < len(src):
        ch = str(src[i])
        cur = cur + ch
        if ch == "\n":
            out.append(cur)
            cur = ""
        i = i + 1
    if len(cur) > 0:
        out.append(cur)
    return out

fn _strip_nl(s):
    src = str(s)
    if src.endswith("\r\n"):
        return _substr(src, 0, len(src) - 2)
    if src.endswith("\n"):
        return _substr(src, 0, len(src) - 1)
    if src.endswith("\r"):
        return _substr(src, 0, len(src) - 1)
    return src

fn _nl_of(s):
    src = str(s)
    if src.endswith("\r\n"):
        return "\r\n"
    if src.endswith("\n"):
        return "\n"
    if src.endswith("\r"):
        return "\r"
    return ""

fn _is_indent_ch(ch):
    if ch == " ":
        return true
    if ch == "\t":
        return true
    return false

fn _leading_ws(s):
    out = ""
    src = str(s)
    i = 0
    while i < len(src):
        ch = str(src[i])
        if _is_indent_ch(ch):
            out = out + ch
            i = i + 1
        else:
            break
    return out

fn _is_blank_line(s):
    src = str(s)
    i = 0
    while i < len(src):
        ch = str(src[i])
        if _is_ws(ch):
            i = i + 1
        else:
            return false
    return true

fn _common_prefix(a, b):
    out = ""
    i = 0
    sa = str(a)
    sb = str(b)
    while i < len(sa) and i < len(sb):
        if sa[i] == sb[i]:
            out = out + str(sa[i])
            i = i + 1
        else:
            break
    return out

fn dedent(text):
    "Remove common leading whitespace from all non-empty lines."
    s = str(text)
    raw_lines = _split_on_nl_keep(s)
    has_margin = false
    margin = ""
    i = 0
    while i < len(raw_lines):
        ln = str(raw_lines[i])
        content = _strip_nl(ln)
        if not _is_blank_line(content):
            lead = _leading_ws(content)
            if not has_margin:
                margin = lead
                has_margin = true
            else:
                margin = _common_prefix(margin, lead)
        i = i + 1
    if not has_margin:
        return s
    if margin == "":
        return s
    out = ""
    i = 0
    while i < len(raw_lines):
        ln = str(raw_lines[i])
        content = _strip_nl(ln)
        nl = _nl_of(ln)
        if content.startswith(margin):
            out = out + _substr(content, len(margin), len(content)) + nl
        else:
            out = out + ln
        i = i + 1
    return out

fn indent(text, prefix):
    "Add prefix to the beginning of selected non-empty lines."
    s = str(text)
    p = str(prefix)
    lines = _split_on_nl_keep(s)
    out = ""
    i = 0
    while i < len(lines):
        ln = str(lines[i])
        content = _strip_nl(ln)
        nl = _nl_of(ln)
        if not _is_blank_line(content):
            out = out + p + content + nl
        else:
            out = out + ln
        i = i + 1
    return out

fn shorten(text, width, placeholder):
    "Collapse whitespace, truncate to width, appending placeholder if truncated."
    s = str(text)
    ph = str(placeholder)
    wlimit = int(width)
    words = _split_words_ws(s)
    if len(words) == 0:
        return ""
    line = ""
    i = 0
    while i < len(words):
        w = str(words[i])
        candidate = w
        if len(line) > 0:
            candidate = line + " " + w
        if len(candidate) <= wlimit:
            line = candidate
        else:
            if len(line) == 0:
                allowed = wlimit - len(ph)
                if allowed < 0:
                    allowed = 0
                return _substr(w, 0, allowed) + ph
            result = line
            if len(result) + len(ph) <= wlimit:
                return result + ph
            cut = wlimit - len(ph)
            if cut < 0:
                cut = 0
            return _substr(result, 0, cut) + ph
        i = i + 1
    return line

fn _indent_lines(lines, first_prefix, rest_prefix):
    out = []
    i = 0
    while i < len(lines):
        if i == 0:
            out.append(first_prefix + str(lines[i]))
        else:
            out.append(rest_prefix + str(lines[i]))
        i = i + 1
    return out

"""
wrap_indented(text, width, initial_indent, subsequent_indent)
-> wrap() honouring Python's initial_indent/subsequent_indent: the first
line carries initial_indent, the rest subsequent_indent, and `width`
includes the indent (body is wrapped at width minus the wider indent).
"""
fn wrap_indented(text, width, initial_indent, subsequent_indent):
    w = int(width)
    if w < 1:
        w = 1
    ip = str(initial_indent)
    sp = str(subsequent_indent)
    body = w - len(sp)
    if len(ip) > len(sp):
        body = w - len(ip)
    if body < 1:
        body = 1
    lines = wrap(text, body)
    return _indent_lines(lines, ip, sp)

"""
fill_indented(text, width, initial_indent, subsequent_indent)
-> fill() with indents; lines joined by newlines.
"""
fn fill_indented(text, width, initial_indent, subsequent_indent):
    lines = wrap_indented(text, width, initial_indent, subsequent_indent)
    out = ""
    i = 0
    while i < len(lines):
        if i > 0:
            out = out + "\n"
        out = out + str(lines[i])
        i = i + 1
    return out
