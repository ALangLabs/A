# std.token — port of Python 3.14 Lib/token.py (constants module).
#
# IMPORTANT: this is a **Python-compatibility vocabulary layer**, not A's
# tokenizer. A's real lexer lives in the compiler
# (compiler/stages/lexer/lexer.cpp, `Tok` enum in token.hpp); it produces
# language tokens (keywords, identifiers, literals, punctuation), not the
# Python token-type numbering exported here. Use these constants when
# writing tools that consume Python `tokenize` output or port Python
# parser code; use `a`'s own compiler internals for A source analysis.
#
# Coverage vs Python 3.14 token.py:
#   * All token-type constants (ENDMARKER..N_TOKENS, NT_OFFSET): present,
#     same names and integer values.
#   * `tok_name` (int -> name map): present, built from `_token_names`.
#   * `EXACT_TOKEN_TYPES` / `exact_token_types` (punct -> code map):
#     present.
#   * `ISTERMINAL` / `ISNONTERMINAL` / `ISEOF`: present as lowercase
#     `isterminal` / `isnonterminal` / `iseof` plus UPPERCASE aliases for
#     Python call-site compatibility.
#
# Deviations:
#   * Python's `tok_name` is built from `globals()` and also contains
#     entries for every int constant; here it is built explicitly from
#     `_token_names` (values 0..69) plus `NT_OFFSET` (256) — same result.
#   * `tok_name[x]` for an unknown `x` is a missing-key error in A maps
#     (Python raises KeyError — same failure mode).
#   * No `__all__`.

# -- token-type constants (Python Lib/token.py, verbatim values) --------------

ENDMARKER = 0
NAME = 1
NUMBER = 2
STRING = 3
NEWLINE = 4
INDENT = 5
DEDENT = 6
LPAR = 7
RPAR = 8
LSQB = 9
RSQB = 10
COLON = 11
COMMA = 12
SEMI = 13
PLUS = 14
MINUS = 15
STAR = 16
SLASH = 17
VBAR = 18
AMPER = 19
LESS = 20
GREATER = 21
EQUAL = 22
DOT = 23
PERCENT = 24
LBRACE = 25
RBRACE = 26
EQEQUAL = 27
NOTEQUAL = 28
LESSEQUAL = 29
GREATEREQUAL = 30
TILDE = 31
CIRCUMFLEX = 32
LEFTSHIFT = 33
RIGHTSHIFT = 34
DOUBLESTAR = 35
PLUSEQUAL = 36
MINEQUAL = 37
STAREQUAL = 38
SLASHEQUAL = 39
PERCENTEQUAL = 40
AMPEREQUAL = 41
VBAREQUAL = 42
CIRCUMFLEXEQUAL = 43
LEFTSHIFTEQUAL = 44
RIGHTSHIFTEQUAL = 45
DOUBLESTAREQUAL = 46
DOUBLESLASH = 47
DOUBLESLASHEQUAL = 48
AT = 49
ATEQUAL = 50
RARROW = 51
ELLIPSIS = 52
COLONEQUAL = 53
EXCLAMATION = 54
OP = 55
TYPE_IGNORE = 56
TYPE_COMMENT = 57
SOFT_KEYWORD = 58
FSTRING_START = 59
FSTRING_MIDDLE = 60
FSTRING_END = 61
TSTRING_START = 62
TSTRING_MIDDLE = 63
TSTRING_END = 64
COMMENT = 65
NL = 66
# These aren't used by the C tokenizer but are needed for tokenize.py
ERRORTOKEN = 67
ENCODING = 68
N_TOKENS = 69
# Special definitions for cooperation with parser
NT_OFFSET = 256

# -- tok_name ------------------------------------------------------------------
# Python builds tok_name from globals(); the token-type values 0..69 are
# contiguous so the names live in a plain array indexed by value.

_token_names = [
    "ENDMARKER", "NAME", "NUMBER", "STRING", "NEWLINE", "INDENT", "DEDENT",
    "LPAR", "RPAR", "LSQB", "RSQB", "COLON", "COMMA", "SEMI", "PLUS",
    "MINUS", "STAR", "SLASH", "VBAR", "AMPER", "LESS", "GREATER", "EQUAL",
    "DOT", "PERCENT", "LBRACE", "RBRACE", "EQEQUAL", "NOTEQUAL",
    "LESSEQUAL", "GREATEREQUAL", "TILDE", "CIRCUMFLEX", "LEFTSHIFT",
    "RIGHTSHIFT", "DOUBLESTAR", "PLUSEQUAL", "MINEQUAL", "STAREQUAL",
    "SLASHEQUAL", "PERCENTEQUAL", "AMPEREQUAL", "VBAREQUAL",
    "CIRCUMFLEXEQUAL", "LEFTSHIFTEQUAL", "RIGHTSHIFTEQUAL",
    "DOUBLESTAREQUAL", "DOUBLESLASH", "DOUBLESLASHEQUAL", "AT", "ATEQUAL",
    "RARROW", "ELLIPSIS", "COLONEQUAL", "EXCLAMATION", "OP", "TYPE_IGNORE",
    "TYPE_COMMENT", "SOFT_KEYWORD", "FSTRING_START", "FSTRING_MIDDLE",
    "FSTRING_END", "TSTRING_START", "TSTRING_MIDDLE", "TSTRING_END",
    "COMMENT", "NL", "ERRORTOKEN", "ENCODING", "N_TOKENS",
]

tok_name = {}
for i in 0..len(_token_names):
    tok_name[i] = _token_names[i]
tok_name[NT_OFFSET] = "NT_OFFSET"

# -- exact token types ----------------------------------------------------------
# Python: EXACT_TOKEN_TYPES — mapping of exact-match token strings to
# their token-type constants (used by `tokenize` for single/double-char
# operators and delimiters).

exact_token_types = {
    "!": EXCLAMATION,
    "!=": NOTEQUAL,
    "%": PERCENT,
    "%=": PERCENTEQUAL,
    "&": AMPER,
    "&=": AMPEREQUAL,
    "(": LPAR,
    ")": RPAR,
    "*": STAR,
    "**": DOUBLESTAR,
    "**=": DOUBLESTAREQUAL,
    "*=": STAREQUAL,
    "+": PLUS,
    "+=": PLUSEQUAL,
    ",": COMMA,
    "-": MINUS,
    "-=": MINEQUAL,
    "->": RARROW,
    ".": DOT,
    "...": ELLIPSIS,
    "/": SLASH,
    "//": DOUBLESLASH,
    "//=": DOUBLESLASHEQUAL,
    "/=": SLASHEQUAL,
    ":": COLON,
    ":=": COLONEQUAL,
    ";": SEMI,
    "<": LESS,
    "<<": LEFTSHIFT,
    "<<=": LEFTSHIFTEQUAL,
    "<=": LESSEQUAL,
    "=": EQUAL,
    "==": EQEQUAL,
    ">": GREATER,
    ">=": GREATEREQUAL,
    ">>": RIGHTSHIFT,
    ">>=": RIGHTSHIFTEQUAL,
    "@": AT,
    "@=": ATEQUAL,
    "[": LSQB,
    "]": RSQB,
    "^": CIRCUMFLEX,
    "^=": CIRCUMFLEXEQUAL,
    "\{": LBRACE,
    "|": VBAR,
    "|=": VBAREQUAL,
    "\}": RBRACE,
    "~": TILDE,
}

# `EXACT_TOKEN_TYPES` alias matching the Python spelling.
EXACT_TOKEN_TYPES = exact_token_types

# -- predicates -----------------------------------------------------------------

fn isterminal(x):
    "True if token-type `x` is a terminal (< NT_OFFSET)."
    return x < NT_OFFSET

fn isnonterminal(x):
    "True if token-type `x` is a nonterminal (>= NT_OFFSET)."
    return x >= NT_OFFSET

fn iseof(x):
    "True if token-type `x` is ENDMARKER."
    return x == ENDMARKER

# Python-style UPPERCASE aliases.
fn ISTERMINAL(x):
    return isterminal(x)

fn ISNONTERMINAL(x):
    return isnonterminal(x)

fn ISEOF(x):
    return iseof(x)
