# REPL input history: in-memory ring plus ~/.a_history persistence.
import fs
import terminal

entries = []
class HistState:
    cursor
    stash

state = HistState(-1, "")   # cursor -1 = not navigating

fn history_path():
    return terminal.home() + "/.a_history"

# Escapes a (possibly multiline) entry for line-based storage, IPython-style:
# backslashes first, then newlines become the two-character sequence "\n".
fn hist_escape(s):
    return s.replace("\\", "\\\\").replace("\n", "\\n")

# Reverses hist_escape on a single stored line.
fn hist_unescape(s):
    out = ""
    i = 0
    n = len(s)
    while i < n:
        c = s[i..i + 1]
        if c == "\\" and i + 1 < n:
            d = s[i + 1..i + 2]
            if d == "n":
                out = out + "\n"
            elif d == "\\":
                out = out + "\\"
            else:
                out = out + c + d
            i = i + 2
        else:
            out = out + c
            i = i + 1
    return out

fn history_load():
    path = history_path()
    if fs.file_exists(path):
        text = fs.read_file(path)
        for line in text.splitlines():
            entries.append(hist_unescape(line))

fn history_reset_nav():
    state.cursor = -1
    state.stash = ""

fn history_add(line):
    history_reset_nav()
    if line.strip() != "" and line != "exit" and line != "quit":
        n = len(entries)
        if n == 0 or entries[n - 1] != line:
            entries.append(line)
            fs.append_file(history_path(), hist_escape(line) + "\n")

fn history_len():
    return len(entries)

fn history_all():
    return entries

# Most recent entry, or "" when history is empty.
fn history_last():
    n = len(entries)
    if n == 0:
        return ""
    return entries[n - 1]

# Older entry relative to the end; returns "" when exhausted.
fn history_older(current):
    if state.cursor == -1:
        state.stash = current
        if len(entries) == 0:
            return ""
        state.cursor = len(entries) - 1
        return entries[state.cursor]
    if state.cursor <= 0:
        return entries[0]
    state.cursor = state.cursor - 1
    return entries[state.cursor]

fn history_newer():
    if state.cursor == -1:
        return ""
    if state.cursor >= len(entries) - 1:
        state.cursor = -1
        out = state.stash
        state.stash = ""
        return out
    state.cursor = state.cursor + 1
    return entries[state.cursor]

# Most recent entry starting with `prefix` that is longer than `prefix`,
# for ghost-text autosuggest. Returns "" when none.
fn history_suggest(prefix):
    i = len(entries) - 1
    scanned = 0
    while i >= 0 and scanned < 1000:
        scanned = scanned + 1
        cand = entries[i]
        if len(cand) > len(prefix) and cand[0..len(prefix)] == prefix:
            return cand
        i = i - 1
    return ""

# Reverse-i-search: newest-first index whose entry contains `query`.
fn history_find(query, start):
    i = start
    while i >= 0:
        if entries[i].contains(query):
            return i
        i = i - 1
    return -1
