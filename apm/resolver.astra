# apm.resolver — breadth-first dependency resolution against a registry.
#
# Input:  {String: String} requirements (package -> spec).
# Output: [ [name, version], ... ] sorted by name: the set of packages to
#         install, plus {String: String} name -> version for the lockfile.
# The first spec seen for a package wins; later specs must also be
# satisfied by the chosen version, otherwise resolution fails with a
# clear conflict message (no backtracking in v1).

from "registry.a" import reg_versions, reg_best_version, reg_deps
from "semver.a" import satisfies
from "util.a" import fail

"""resolve(reg, reqs) -> (resolved_list, version_map).
resolved_list: [ [name, version], ... ] sorted by name.
"""
fn resolve(reg, reqs):
    queue = []
    for name in sorted(reqs.keys()):
        queue.append([name, reqs[name]])
    chosen = {}
    deps_of = {}
    i = 0
    while i < len(queue):
        item = queue[i]
        name = item[0]
        spec = item[1]
        if name in chosen:
            if not satisfies(chosen[name], spec):
                fail("dependency conflict: " + name + " is pinned to " + chosen[name] +
                     " but needs '" + spec + "'")
        else:
            versions = reg_versions(reg, name)
            if len(versions) == 0:
                fail("package '" + name + "' not found in registry")
            best = reg_best_version(reg, name, spec)
            if best == "":
                fail("no version of '" + name + "' satisfies '" + spec +
                     "' (available: " + ", ".join(versions) + ")")
            chosen[name] = best
            deps = reg_deps(reg, name, best)
            deps_of[name] = deps
            for dn in sorted(deps.keys()):
                queue.append([dn, deps[dn]])
        i += 1
    out = []
    for name in sorted(chosen.keys()):
        out.append([name, chosen[name]])
    return (out, chosen)
