# apm — the A Package Manager (pip for A, written in A).
#
# Part of the A toolchain: install, update, publish and run third-party
# packages written in A itself. CLI (same verbs as pip/uv/cargo):
#
#   apm init [name]                     scaffold an apm.json project
#   apm install [pkg[@ver]...]          add packages (or install manifest)
#   apm add                             alias of install
#   apm remove <pkg>                    remove packages
#   apm list / ls                       show installed packages
#   apm info <pkg>                      show package details
#   apm search <query>                  search the registry
#   apm update [pkg...]                 update packages to latest
#   apm run <file.astra>                    run a program with packages on -I
#   apm exec <cmd...>                   run a command with A_PATH set
#   apm publish                         publish this package to the registry
#   apm doctor                          check the environment
#   apm clean [--all]                   clear .apm/cache (or all of .apm/)
#   apm version | --version
#
# The A runtime exposes no argv to programs, so this entry point reads its
# CLI from APM_ARGS (the `apm` launcher script sets it from real argv):
#   APM_ARGS="install hello-lib" a run apm/apm.astra
# See apm/README.md for full documentation.

import fs
import json
import std:shlex
from "util.astra" import join, dirname, basename, is_dir, is_file, exists, getenv, read_text, write_text, norm_import_name, shell, q, fail, ok, bullet, default_registry, a_bin, copy_dir, remove_all, dir_size
from "manifest.astra" import load_manifest, manifest_text, default_project_manifest, mf_get, mf_deps, add_dep, remove_dep
from "registry.astra" import load_registry, registry_dir, reg_packages, reg_entry, reg_versions, reg_description, reg_source, reg_deps, reg_best_version, reg_release, reg_kind, reg_model, render_model, model_add, save_registry
from "resolver.astra" import resolve
from "install.astra" import fetch, fetch_with_kind, package_manifest_dir
from "project.astra" import project_root, manifest_path, lock_path, packages_dir, cache_dir, package_dir, project_name, write_lock, read_lock, installed_packages

APM_VERSION = "0.1.0"

fn print_help():
    print("apm — the A Package Manager " + APM_VERSION)
    print("")
    print("Usage:")
    print("  apm <command> [options] [args...]")
    print("")
    print("Commands:")
    print("  init [name]             scaffold a project (writes apm.json)")
    print("  install [pkg[@ver]...]  add packages, or install all manifest deps")
    print("  add                     alias of install")
    print("  remove <pkg...>         remove packages (uninstall)")
    print("  list, ls                show installed packages")
    print("  info <pkg>              show package details (registry + local)")
    print("  search <query>          search the registry by name/description")
    print("  update [pkg...]         update packages to the latest matching")
    print("  run <file.astra>            run a program with .apm/packages on -I")
    print("  exec <cmd...>           run a command with A_PATH pointing at packages")
    print("  publish                 publish this package to the registry")
    print("  doctor                  check toolchain, registry and project")
    print("  clean [--all]           clear .apm/cache (or all of .apm/)")
    print("  cache                   show cache directory and size")
    print("  version, --version      print the apm version")
    print("  help, --help            show this message")
    print("")
    print("Options (where accepted):")
    print("  -p, --project <dir>     operate on another project directory")
    print("  --registry <path|url>   use a different registry index")
    print("  --path <dir>            install a single package from a local dir")
    print("  --git <url>[#ref]       install a single package from a git repo")
    print("  --dev                   (devDependency placeholder, see README)")
    print("")
    print("Package specs: name, name@1.2.3 (exact), or a registry version spec.")
    print("Environment: APM_REGISTRY, APM_HOME, APM_PROJECT, APM_A_BIN.")

"""parse_opts(args) -> (opts_map, rest). opts_map: {name: value}."""
"""next_arg(args, i) -> next CLI token or ""."""
fn next_arg(args, i: int):
    if i < len(args):
        return args[i]
    return ""

fn parse_opts(args):
    opts = {}
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-p" or a == "--project":
            opts["project"] = next_arg(args, i + 1)
            i += 1
        elif a == "--registry":
            opts["registry"] = next_arg(args, i + 1)
            i += 1
        elif a == "--path":
            opts["path"] = next_arg(args, i + 1)
            i += 1
        elif a == "--git":
            opts["git"] = next_arg(args, i + 1)
            i += 1
        elif a == "--dev" or a == "-D":
            opts["dev"] = "1"
        elif a == "--all":
            opts["all"] = "1"
        elif a == "-h" or a == "--help":
            opts["help"] = "1"
        elif a == "-V" or a == "--version":
            opts["version"] = "1"
        elif a.startswith("-") and a != "-":
            fail("unknown option: " + a)
        else:
            rest.append(a)
        i += 1
    return (opts, rest)

fn split_spec(s: String):
    i = s.rfind("@")
    if i > 0:
        return (s[0..i], s[i + 1..])
    return (s, "")

fn registry_path(opts):
    if "registry" in opts:
        return opts["registry"]
    return default_registry()

fn root_of(opts):
    p = ""
    if "project" in opts:
        p = opts["project"]
    return project_root(p)

"""ensure_manifest(root, create) -> manifest map. Creates a default one when create."""
fn ensure_manifest(root: String, create: bool):
    if is_file(manifest_path(root)):
        return load_manifest(manifest_path(root))
    if create:
        write_text(manifest_path(root), default_project_manifest(basename(root)))
        print("created " + manifest_path(root))
        m = load_manifest(manifest_path(root))
        return m
    fail("no apm.json at '" + manifest_path(root) + "' (run `apm init` first, or pass -p <dir>)")
    return None

fn cmd_init(rest, opts):
    root = root_of(opts)
    name = ""
    if len(rest) > 0:
        arg = rest[0]
        if arg.contains("/") or arg == ".":
            # A path-like argument is the project directory.
            if arg == ".":
                root = current_dir()
            else:
                root = arg
        else:
            name = arg
    if name == "":
        name = basename(root)
    if is_file(manifest_path(root)):
        print("apm.json already exists at " + manifest_path(root))
        return None
    write_text(manifest_path(root), default_project_manifest(name))
    bullet("created " + manifest_path(root) + " (name: " + name + ")")
    gi = join(root, ".gitignore")
    if is_file(gi) and not read_text(gi).contains(".apm/"):
        append_file(gi, "/.apm/\n")
        bullet("appended /.apm/ to .gitignore")
    bullet("add dependencies with: apm install <package>")
    bullet("run programs with:    apm run main.astra")
    return None

fn fetch_resolved(root, reg, regpath, resolved):
    for item in resolved:
        name = item[0]
        ver = item[1]
        src = reg_source(reg, name, ver)
        if src == "":
            fail("package '" + name + "'@" + ver + " has no source in the registry")
        kind = reg_kind(reg, name, ver)
        dest = package_dir(root, name)
        print("installing " + name + " " + ver + " -> " + dest)
        remove_all(dest)
        fetch_with_kind(src, kind, registry_dir(regpath), dest)

fn cmd_install(rest, opts, update_mode):
    root = root_of(opts)
    adding = len(rest) > 0
    m = ensure_manifest(root, adding)
    regpath = registry_path(opts)
    reg = load_registry(regpath)
    reqs = mf_deps(m, "dependencies")
    custom_sources = {}
    for spec_arg in rest:
        if "path" in opts and len(rest) == 1:
            name = split_spec(spec_arg)[0]
            custom_sources[name] = "local:" + opts["path"]
            reqs[name] = split_spec(spec_arg)[1]
        elif "git" in opts and len(rest) == 1:
            name = split_spec(spec_arg)[0]
            custom_sources[name] = opts["git"]
            reqs[name] = split_spec(spec_arg)[1]
        else:
            pair = split_spec(spec_arg)
            reqs[pair[0]] = pair[1]
    if update_mode:
        for name in rest:
            if name in reqs:
                reqs[name] = "*"
    if len(reqs) == 0:
        bullet("no dependencies to install (manifest has no dependencies)")
        return None
    out = resolve_with_custom(reg, reqs, custom_sources)
    resolved_list = []
    for item in out[0]:
        if len(item) >= 3:
            resolved_list.append(item)
        else:
            resolved_list.append([item[0], item[1], reg_source(reg, item[0], item[1])])
    version_map = out[1]
    if adding:
        deps = mf_deps(m, "dependencies")
        for spec_arg in rest:
            pair = split_spec(spec_arg)
            name = pair[0]
            if name in custom_sources:
                want = pair[1]
                if want == "":
                    want = custom_version(custom_sources[name])
                deps[name] = want
            else:
                spec = pair[1]
                if spec == "":
                    spec = "^" + version_map[name]
                deps[name] = spec
        write_text(manifest_path(root), manifest_text(
            mf_get(m, "name", "project"), mf_get(m, "version", "0.1.0"),
            mf_get(m, "description", ""), mf_get(m, "main", "main.astra"), deps))
        bullet("updated " + manifest_path(root))
    fetch_resolved(root, reg, regpath, resolved_list)
    # Fetch custom (path/git) sources too; they are not in the registry.
    for name in custom_sources.keys():
        v = custom_version(custom_sources[name])
        dest = package_dir(root, name)
        remove_all(dest)
        fetch(custom_sources[name], dest)
        # A cloned/downloaded tree may carry its own manifest version.
        dm = join(dest, "apm.json")
        if is_file(dm):
            v = mf_get(load_manifest(dm), "version", v)
        print("installing " + name + " " + v + " -> " + dest)
        resolved_list.append([name, v, custom_sources[name]])
    write_lock(root, project_name(root), resolved_list)
    bullet("locked " + str(len(resolved_list)) + " package(s) in " + lock_path(root))
    names = []
    for item in resolved_list:
        names.append(norm_import_name(item[0]))
    bullet("use them with: import " + ", ".join(names) + "  (via `apm run app.astra`)")
    return None

fn custom_version(source: String):
    if source.startswith("local:"):
        p = source[6..]
        if is_file(join(p, "apm.json")):
            return mf_get(load_manifest(join(p, "apm.json")), "version", "0.0.0")
    return "0.0.0"

"""resolve_with_custom(reg, reqs, custom) -> (resolved, version_map).
Custom (path/git) packages join resolution by reading their manifest
deps; registry packages resolve through the registry resolver.
"""
fn resolve_with_custom(reg, reqs, custom):
    rc = {}
    for k in reqs.keys():
        rc[k] = reqs[k]
    for k in custom.keys():
        rc.pop(k)
    resolved = []
    version_map = {}
    if len(rc) > 0:
        out = resolve(reg, rc)
        resolved = out[0]
        version_map = out[1]
    for name in custom.keys():
        version_map[name] = custom_version(custom[name])
        deps = custom_deps(custom[name])
        for dn in deps.keys():
            if dn not in version_map:
                out2 = resolve(reg, {dn: deps[dn]})
                for item in out2[0]:
                    resolved.append(item)
                    version_map[item[0]] = item[1]
    return (resolved, version_map)

fn custom_deps(source: String):
    if source.startswith("local:"):
        p = source[6..]
        if is_file(join(p, "apm.json")):
            return mf_deps(load_manifest(join(p, "apm.json")), "dependencies")
    return {}

fn cmd_remove(rest, opts):
    if len(rest) == 0:
        fail("remove needs at least one package name")
    root = root_of(opts)
    m = load_manifest(manifest_path(root))
    deps = mf_deps(m, "dependencies")
    for name in rest:
        if name in deps:
            deps.pop(name)
        dest = package_dir(root, name)
        remove_all(dest)
        bullet("removed " + name + " (" + package_dir(root, name) + ")")
    write_text(manifest_path(root), manifest_text(
        mf_get(m, "name", "project"), mf_get(m, "version", "0.1.0"),
        mf_get(m, "description", ""), mf_get(m, "main", "main.astra"), deps))
    # Refresh lock: keep entries still reachable from remaining deps.
    lock = read_lock(root)
    if len(lock) > 0:
        regpath = registry_path(opts)
        reach = deps
        reg = None
        if is_file(regpath):
            reg = load_registry(regpath)
        kept_names = {}
        changed = true
        while changed:
            changed = false
            for name in reach.keys():
                if name in kept_names:
                    continue
                found = false
                for item in lock:
                    if item[0] == name:
                        kept_names[name] = true
                        found = true
                        changed = true
                        if reg != None:
                            for dn in reg_deps(reg, item[0], item[1]).keys():
                                if dn not in reach:
                                    reach[dn] = "*"
                        break
                if not found:
                    pass
        kept = []
        for item in lock:
            if item[0] in kept_names:
                kept.append(item)
            else:
                remove_all(package_dir(root, item[0]))
        write_lock(root, project_name(root), kept)

fn cmd_list(rest, opts):
    root = root_of(opts)
    lock = read_lock(root)
    if len(lock) > 0:
        for item in lock:
            print(item[0] + " " + item[1] + "  (import " + norm_import_name(item[0]) + ")")
    else:
        pkgs = installed_packages(root)
        if len(pkgs) == 0:
            print("(no packages installed — `apm list` reads apm.lock.json and .apm/packages/)")
            return None
        for p in pkgs:
            ver = "?"
            if is_file(join(join(packages_dir(root), p), "apm.json")):
                ver = mf_get(load_manifest(join(join(packages_dir(root), p), "apm.json")), "version", "?")
            print(p + " " + ver)
    return None

fn cmd_info(rest, opts):
    if len(rest) == 0:
        fail("info needs a package name")
    name = rest[0]
    root = root_of(opts)
    regpath = registry_path(opts)
    reg = load_registry(regpath)
    found = false
    if reg_entry(reg, name) != None:
        found = true
        print(name + " — " + reg_description(reg, name))
        versions = reg_versions(reg, name)
        print("available: " + ", ".join(versions))
        print("latest:    " + versions[len(versions) - 1])
        for v in versions:
            src = reg_source(reg, name, v)
            deps = reg_deps(reg, name, v)
            line = "  " + v + "  <- " + src
            if len(deps) > 0:
                parts = []
                for dn in deps.keys():
                    parts.append(dn + " " + deps[dn])
                line += "  deps: " + ", ".join(parts)
            print(line)
    if is_dir(package_dir(root, name)):
        found = true
        print("(installed at " + package_dir(root, name) + ")")
    if not found:
        fail("no such package: '" + name + "'")

fn cmd_search(rest, opts):
    if len(rest) == 0:
        fail("search needs a query")
    query = rest[0].lower()
    regpath = registry_path(opts)
    reg = load_registry(regpath)
    hits = 0
    for name in reg_packages(reg):
        desc = reg_description(reg, name)
        if query in name.lower() or query in desc.lower():
            versions = reg_versions(reg, name)
            latest = "?"
            if len(versions) > 0:
                latest = versions[len(versions) - 1]
            print(name + " (" + latest + ") — " + desc)
            hits += 1
    if hits == 0:
        print("(no matches for '" + rest[0] + "')")

fn cmd_run(rest, opts):
    if len(rest) == 0:
        fail("run needs a file (e.g. apm run main.astra)")
    root = root_of(opts)
    file = rest[0]
    pkgs = packages_dir(root)
    inc = ""
    if is_dir(pkgs):
        inc = " -I " + q(pkgs)
    cmd = q(a_bin()) + " run" + inc + " " + q(file)
    print("$ " + cmd)
    status = shell(cmd)
    if status != 0:
        fail("program exited with status " + str(status))

fn cmd_exec(rest, opts):
    if len(rest) == 0:
        fail("exec needs a command (e.g. apm exec a run app.astra)")
    root = root_of(opts)
    pkgs = packages_dir(root)
    if is_dir(pkgs):
        old = getenv("A_PATH", "")
        if old == "":
            fs_setenv("A_PATH", pkgs)
        else:
            fs_setenv("A_PATH", pkgs + ":" + old)
    cmd = ""
    for a in rest:
        if cmd != "":
            cmd += " "
        cmd += a
    print("$ " + cmd)
    status = shell(cmd)
    if status != 0:
        fail("command exited with status " + str(status))

fn fs_setenv(k: String, v: String):
    fs.setenv(k, v)

fn cmd_publish(rest, opts):
    root = root_of(opts)
    m = load_manifest(manifest_path(root))
    name = mf_get(m, "name", "")
    version = mf_get(m, "version", "")
    if name == "" or version == "":
        fail("manifest needs a name and version to publish")
    regpath = registry_path(opts)
    reg = load_registry(regpath)
    base = registry_dir(regpath)
    dest = join(join(join(base, "packages"), name), version)
    remove_all(dest)
    copy_dir(root, dest)
    bullet("published " + name + " " + version + " -> " + dest)
    rel = "packages/" + name + "/" + version
    out = reg_set_release(reg, name, version, rel, mf_get(m, "description", ""),
                          mf_deps(m, "dependencies"))
    write_text(regpath, render_model(out[0], out[1]))
    bullet("updated " + regpath)

fn reg_set_release(reg, name: String, version: String, source: String, desc: String, deps):
    model = reg_model(reg)
    model = model_add(model, name, desc, version, source, "local", deps)
    return (model, registry_name(reg))

fn registry_name(reg):
    n = json.as_str(json.get(reg, "name"))
    if n == None:
        return "apm-registry"
    return n!

fn cmd_doctor(rest, opts):
    print("apm doctor — " + APM_VERSION)
    status = shell(q(a_bin()) + " version")
    if status == 0:
        bullet("ok toolchain: " + a_bin() + " (" + str(a_bin()) + " version)")
    else:
        bullet("FAIL toolchain: cannot run `" + a_bin() + " version`")
    if shell("git --version") == 0:
        bullet("ok git available (for git sources)")
    else:
        bullet("warn git not found (git sources unavailable)")
    if shell("tar --version") == 0:
        bullet("ok tar available (for http archive sources)")
    else:
        bullet("warn tar not found (archive sources unavailable)")
    regpath = registry_path(opts)
    if regpath.startswith("http://") or regpath.startswith("https://"):
        bullet("registry: " + regpath + " (remote)")
    elif is_file(regpath):
        bullet("ok registry: " + regpath)
    else:
        bullet("FAIL registry missing: " + regpath)
    root = root_of(opts)
    if is_file(manifest_path(root)):
        bullet("ok project: " + manifest_path(root) + " (" + project_name(root) + ")")
    else:
        bullet("warn no project manifest at " + manifest_path(root))
    bullet("packages dir: " + packages_dir(root))

fn cmd_clean(rest, opts):
    root = root_of(opts)
    if "all" in opts:
        remove_all(join(root, ".apm"))
        bullet("removed " + join(root, ".apm") + " (packages + cache)")
    else:
        dir = cache_dir(root)
        remove_all(dir)
        bullet("removed " + dir)

fn cmd_cache(rest, opts):
    root = root_of(opts)
    dir = cache_dir(root)
    if exists(dir):
        print(dir + " (" + str(dir_size(dir)) + " bytes)")
    else:
        print(dir + " (empty)")

fn main():
    raw = getenv("APM_ARGS", "")
    args = []
    if raw.strip() != "":
        args = shlex.split(raw, false, true)
    if len(args) == 0:
        print_help()
    else:
        cmd = args[0]
        if cmd == "version" or cmd == "--version" or cmd == "-V":
            print("apm " + APM_VERSION + " (A Package Manager)")
        elif cmd == "help" or cmd == "--help" or cmd == "-h":
            print_help()
        else:
            opts, rest = parse_opts(args[1..])
            if "help" in opts:
                print_help()
            elif "version" in opts:
                print("apm " + APM_VERSION + " (A Package Manager)")
            elif cmd == "init":
                cmd_init(rest, opts)
            elif cmd == "install" or cmd == "add":
                cmd_install(rest, opts, false)
            elif cmd == "remove" or cmd == "uninstall":
                cmd_remove(rest, opts)
            elif cmd == "list" or cmd == "ls":
                cmd_list(rest, opts)
            elif cmd == "info":
                cmd_info(rest, opts)
            elif cmd == "search":
                cmd_search(rest, opts)
            elif cmd == "update":
                cmd_install(rest, opts, true)
            elif cmd == "run":
                cmd_run(rest, opts)
            elif cmd == "exec":
                cmd_exec(rest, opts)
            elif cmd == "publish":
                cmd_publish(rest, opts)
            elif cmd == "doctor":
                cmd_doctor(rest, opts)
            elif cmd == "clean":
                cmd_clean(rest, opts)
            elif cmd == "cache":
                cmd_cache(rest, opts)
            else:
                fail("unknown command '" + cmd + "' (try `apm help`)")
    return None
