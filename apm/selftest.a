# apm selftest — unit tests for the A Package Manager.
#
# Run: ./build/a test apm/selftest.a
# (compiles fast against already-built apm modules; no network needed)

import "semver.a" as semver
import "manifest.a" as manifest
import "registry.a" as registry
import "resolver.a" as resolver

fn assert_eq(a, b):
    assert(a == b)

fn assert_true(c):
    assert(c)

# -- semver ------------------------------------------------------------------

fn test_satisfies_caret():
    assert_true(semver.satisfies("1.5.0", "^1.2.0"))
    assert_true(not semver.satisfies("2.0.0", "^1.2.0"))
    assert_true(not semver.satisfies("0.9.9", "^1.2.0"))

fn test_satisfies_tilde():
    assert_true(semver.satisfies("1.2.9", "~1.2.3"))
    assert_true(not semver.satisfies("1.3.0", "~1.2.3"))

fn test_satisfies_exact_and_ranges():
    assert_true(semver.satisfies("1.2.3", "1.2.3"))
    assert_true(not semver.satisfies("1.2.4", "1.2.3"))
    assert_true(semver.satisfies("1.2.3", ">=1.0.0,<2.0.0"))
    assert_true(not semver.satisfies("2.0.0", ">=1.0.0,<2.0.0"))
    assert_true(semver.satisfies("9.9.9", "*"))

fn test_max_satisfying():
    assert_eq(semver.max_satisfying(["1.0.0", "1.2.0", "2.0.0"], "^1.0.0"), "1.2.0")
    assert_eq(semver.max_satisfying(["1.0.0"], ">=2.0.0"), "")

# -- manifest ----------------------------------------------------------------

fn test_manifest_roundtrip():
    m = manifest.load_manifest("apm/registry/packages/hello-lib/1.0.0/apm.json")
    assert_eq(manifest.mf_get(m, "name", ""), "hello-lib")
    assert_eq(manifest.mf_get(m, "version", ""), "1.0.0")
    deps = manifest.mf_deps(m, "dependencies")
    assert_eq(len(deps), 0)

fn test_manifest_deps():
    m = manifest.load_manifest("apm/registry/packages/string-utils/0.3.0/apm.json")
    deps = manifest.mf_deps(m, "dependencies")
    assert_eq(deps["math-utils"], "^2.0.0")

# -- registry + resolver ------------------------------------------------------

fn test_registry_lookup():
    reg = registry.load_registry("apm/registry/registry.json")
    assert_true("hello-lib" in registry.reg_packages(reg))
    assert_eq(registry.reg_versions(reg, "hello-lib"), ["1.0.0", "1.1.0"])
    assert_eq(registry.reg_best_version(reg, "hello-lib", "^1.0.0"), "1.1.0")

fn test_resolve_transitive():
    reg = registry.load_registry("apm/registry/registry.json")
    out = resolver.resolve(reg, {"string-utils": ""})
    resolved = out[0]
    assert_eq(len(resolved), 3)
    versions = out[1]
    assert_eq(versions["hello-lib"], "1.1.0")
    assert_eq(versions["math-utils"], "2.0.0")
