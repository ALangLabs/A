# apm.manifest — read/write `apm.json` project & package manifests.

import json
from "util.a" import read_text, write_text, is_file, fail, ob, cb

"""json_esc(s) -> s escaped for embedding in a JSON string literal."""
fn json_esc(s: String):
    out = ""
    for c in s.chars():
        ch = str(c)
        if ch == "\"":
            out += "\\\""
        elif ch == "\\":
            out += "\\\\"
        elif ch == "\n":
            out += "\\n"
        elif ch == "\r":
            out += "\\r"
        elif ch == "\t":
            out += "\\t"
        else:
            out += ch
    return out

"""deps_json(deps) -> JSON object text for a {String: String} map."""
fn deps_json(deps):
    parts = []
    for k in deps.keys():
        parts.append("\"" + json_esc(k) + "\": \"" + json_esc(deps[k]) + "\"")
    return ob() + ", ".join(parts) + cb()

"""default_project_manifest(name) -> fresh apm.json text."""
fn default_project_manifest(name: String):
    s = ob() + "\n"
    s += "  \"name\": \"" + json_esc(name) + "\",\n"
    s += "  \"version\": \"0.1.0\",\n"
    s += "  \"description\": \"\",\n"
    s += "  \"main\": \"main.a\",\n"
    s += "  \"license\": \"\",\n"
    s += "  \"dependencies\": " + ob() + cb() + ",\n"
    s += "  \"devDependencies\": " + ob() + cb() + "\n"
    s += cb() + "\n"
    return s

"""manifest_text(name, version, description, main, pkg_deps) -> apm.json text."""
fn manifest_text(name: String, version: String, description: String, main: String, pkg_deps):
    s = ob() + "\n"
    s += "  \"name\": \"" + json_esc(name) + "\",\n"
    s += "  \"version\": \"" + json_esc(version) + "\",\n"
    s += "  \"description\": \"" + json_esc(description) + "\",\n"
    s += "  \"main\": \"" + json_esc(main) + "\",\n"
    s += "  \"dependencies\": " + deps_json(pkg_deps) + "\n"
    s += cb() + "\n"
    return s

"""load_manifest(path) -> parsed manifest map (fails when missing/invalid)."""
fn load_manifest(path: String):
    if not is_file(path):
        fail("no apm.json at '" + path + "' (run `apm init` first, or pass -p <dir>)")
    text = read_text(path)
    if not json.is_valid(text):
        fail("invalid JSON in '" + path + "'")
    return json.parse(text)

"""mf_get(m, key, default) -> manifest field as String (or default)."""
fn mf_get(m, key: String, default: String):
    v = json.get(m, key)
    if v == None:
        return default
    s = json.as_str(v!)
    if s == None:
        return default
    return s!

"""_collect_dep(deps, k, out) -> copy one deps entry into out when string."""
fn _collect_dep(deps, k: String, out):
    s = json.as_str(json.get(deps, k))
    if s == None:
        return None
    out[k] = s!
    return None

"""mf_deps(m, key) -> {String: String} dependency map ({} when absent)."""
fn mf_deps(m, key: String):
    out = {}
    v = json.get(m, key)
    if v == None:
        return out
    deps = v!
    for k in json.keys(deps):
        _collect_dep(deps, k, out)
    return out

"""add_dep(m, name, spec) -> manifest text with deps[name] = spec."""
fn add_dep(m, name: String, spec: String):
    deps = mf_deps(m, "dependencies")
    deps[name] = spec
    return manifest_text(mf_get(m, "name", "project"), mf_get(m, "version", "0.1.0"),
                         mf_get(m, "description", ""), mf_get(m, "main", "main.a"), deps)

"""remove_dep(m, name) -> manifest text without deps[name]."""
fn remove_dep(m, name: String):
    deps = mf_deps(m, "dependencies")
    if name in deps:
        deps.pop(name)
    return manifest_text(mf_get(m, "name", "project"), mf_get(m, "version", "0.1.0"),
                         mf_get(m, "description", ""), mf_get(m, "main", "main.a"), deps)
